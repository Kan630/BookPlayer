        <activity android:name=".activities.GetActivity" />
        <activity android:name=".activities.GetOtherActivity" />
        <activity android:name=".activities.GetDirectLinkActivity" />
        <activity android:name=".activities.GetLibrivoxActivity" />
        <activity android:name=".activities.ModifyFolderActivity" />
        <activity android:name=".activities.CoverWebSearchActivity" android:exported="false" />
        <activity android:name=".activities.ModifyZikFileActivity" />
        <activity android:name=".activities.AddResourceActivity" />
        <activity android:name=".imports.ImportBookSingleActivity" />
        <activity android:name=".imports.ImportBookMultipleActivity"
            android:label="@string/Mass_Import" />
        <activity android:name=".activities.HelpActivity" />
        <activity android:name=".activities.SettingsActivity" />
        <activity android:name=".activities.LibrivoxFavoritesActivity"/>
        <activity android:name=".activities.LogTextActivity" />
        <activity android:name=".activities.LogListActivity" />
        <activity android:name=".activities.StatsActivity" />
        <activity android:name=".activities.CleanMemoryActivity" />
        <activity android:name=".activities.ExportActivity" />
        <activity android:name=".quickshare.NearbyShareActivity" />
        <activity android:name=".activities.LibrivoxResultsActivity" />
        <activity android:name=".activities.LibrivoxDetailActivity" />
        <activity android:name=".activities.SupportedExtensionsActivity"/>
        <activity android:name=".activities.CoverGenerationActivity" />
        <activity android:name=".activities.DebugDatabaseActivity"
            android:exported="false"
            android:enabled="true">
        </activity>


        <activity android:name=".radio.RadioResultsActivity" />
        <activity android:name=".radio.RadioFavoritesActivity" />
        <activity android:name=".radio.RadioStationActivity" />
        <activity android:name=".activities.LibrivoxDetailActivity" />
        <activity android:name=".activities.PodcastSearchResultsActivity"/>
        <activity android:name=".activities.PodcastEpisodeActivity"
            android:launchMode="singleTop"
            />
        <activity android:name=".activities.PodcastFavoritesActivity"/>
        <activity android:name=".activities.GetPodcastActivity" />
        <activity android:name=".radio.GetRadioActivity"
            android:launchMode="singleTop"
            />
        <activity android:name=".radio.GetRadioCardListActivity" />
        
        
        <activity
            android:name=".activities.SettingsHostActivity"
            android:exported="false"
            android:theme="@style/Theme.BookPlayer" />
        <activity
            android:name=".activities.MsgBoxActivity"
            android:exported="false"
