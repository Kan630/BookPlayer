<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" /> <!-- indeed not set on sdk 33 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" /> <!-- needed to export to download on old devices -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" /> <!-- prevent battery saver ?  not changeable through adb shell-->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" /> <!--Notification on lock screen   - not changeable through adb shell -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />  <!-- Needed for Android >= 14 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />  <!-- Needed for Android >= 13 if no mediaSession -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/> <!--Visualizer-->
    <uses-permission android:name="android.permission.INTERNET"/> <!-- to test internet access -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- to monitor online status -->
    
    <!-- Nearby Connections permissions -->
    <!--
      Quick Share (Nearby Connections) only. NOTE: <uses-permission> has no android:minSdkVersion
      attribute - only maxSdkVersion and usesPermissionFlags - so the android:minSdkVersion="29"
      / "31" / "32" written here before did NOTHING: every one of these was requested on every
      device, location included. Play then reviews each release against its location policy,
      which is why an update sat in review for days while apps without location go through in
      minutes.
      Nearby Connections needs location only up to Android 12L (API 32); from API 33 it uses
      NEARBY_WIFI_DEVICES instead, so maxSdkVersion="32" is the real scoping - a modern phone is
      never asked for location now. The permissions that only exist from API 31 (BLUETOOTH_*) are
      simply never granted below it, so they need no bound.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" /> <!-- sdk<=28 uses coarse; also lets the user pick "approximate" in the dialog -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- neverForLocation: this scan looks for the other phone, it is not used to derive location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:ignore="UnusedAttribute" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" tools:ignore="UnusedAttribute" />

    <!-- <uses-permission android:name="android.permission.BIND_MEDIA_BROWSER_SERVICE"/>Car stuff -->

    <!-- <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />  for books download -->

    <!--
      No advertising ID anywhere in this app. firebase-analytics declares both the old AD_ID
      permission and the newer Privacy Sandbox one; only the old name was removed here, so every
      build still shipped ACCESS_ADSERVICES_AD_ID (checked in the merged manifest). That matters
      most for BookPlayer Pure, which is PEGI 3: Play's Families policy forbids transmitting the
      advertising ID from an app whose audience includes children.
      The google_analytics_adid_collection_enabled flag below used to sit here, outside
      <application>, where it is ignored - it is now a child of <application>.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />


    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.BookPlayer"
        android:name=".MyApp"
        android:usesCleartextTraffic="true"
        >

        <!-- Belongs inside <application>; outside it, it is silently ignored. -->
        <meta-data android:name="google_analytics_adid_collection_enabled"
            android:value="false" />


        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".player.PlayActivity"
            android:parentActivityName=".activities.MainActivity"/>
        <activity 
            android:name=".player.ScreensaverActivity"
            android:theme="@style/Theme.BookPlayer"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize"
            android:exported="false" />
        <activity android:name=".activities.ModifyFolderActivity" />
        <activity android:name=".activities.MoveBookActivity" />
        <activity android:name=".activities.CoverWebSearchActivity" android:exported="false" />
        <activity android:name=".activities.ModifyZikFileActivity" />
        <activity android:name=".activities.AddResourceActivity" />
        <activity android:name=".imports.ImportBookSingleActivity" />
        <activity android:name=".imports.ImportBookMultipleActivity"
            android:label="@string/Mass_Import" />
        <activity android:name=".activities.HelpActivity" />
        <activity android:name=".activities.LogTextActivity" />
        <activity android:name=".activities.LogListActivity" />
        <activity android:name=".activities.ExportActivity" />
        <activity android:name=".activities.SupportedExtensionsActivity"/>
        <activity android:name=".activities.CoverGenerationActivity" />
        <activity android:name=".activities.DebugDatabaseActivity"
            android:exported="false"
            android:enabled="true">
        </activity>

        <activity android:name=".importexport.ImportExportActivity"
            android:label="Import / Export"
            android:exported="false" />

        <activity android:name=".importexport.BackupShareActivity"
            android:label="Live Share"
            android:exported="false" />

        <activity android:name=".importexport.FullBackupActivity"
            android:label="@string/backup_restore_activity_label"
            android:exported="false" />

        <activity android:name=".importexport.BackupQuickShareActivity"
            android:label="@string/backup_restore_activity_label"
            android:exported="false" />


        <activity
            android:name=".redownload.RedownloadBookActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity
            android:name=".activities.MsgBoxActivity"
            android:exported="false"
            android:theme="@style/Theme.BookPlayer.DialogActivity"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <activity
            android:name=".activities.AdminActivity"
            android:exported="false"
            android:label="Admin"
            />

        <activity
            android:name=".activities.OpenWithProxyActivity"
            android:enabled="false"
            android:exported="true">
            <!-- ZIP support -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:pathPattern=".*\\.zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
            </intent-filter>

            <!-- Standard audio -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" />
                <data android:scheme="content" android:host="*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- Standard m4b (audio/m) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" />
                <data android:scheme="content" android:host="*" />
                <data android:mimeType="audio/m4b" />
            </intent-filter>

            <!-- Alternative m4b (audio/x-m4b) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" />
                <data android:scheme="content" android:host="*" />
                <data android:mimeType="audio/x-m4b" />
            </intent-filter>

            <!-- Fallback: extension-based match for *.m4b with any MIME -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.m4b" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.m4b" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.m4b" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.m4b" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- E-Book support (EPUB + TXT) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" />
                <data android:scheme="content" android:host="*" />
                <!-- EPUB official MIME -->
                <data android:mimeType="application/epub+zip" />
                <!-- TXT standard MIME -->
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Fallback: extension-based match for *.epub and *.txt -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.epub" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.epub" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.fb2" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.fb2" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.odt" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.odt" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.epub" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.epub" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.fb2" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.fb2" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.odt" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.odt" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>


        <activity
            android:name=".activities.OpenWithProxyActivityAll"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.MediaService"
            android:enabled="true"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            android:stopWithTask="false"
            >
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
                <!-- Optional legacy AA action, some HUs still ping this -->
                <action android:name="com.google.android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <receiver android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
        <service
            android:name=".services.ExportService"
            android:exported="false"
            android:stopWithTask="true" />
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider" />
        </provider>
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

    </application>

</manifest>
