<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" /> <!-- indeed not set on sdk 33 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" /> <!-- needed to export to download on old devices -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" /> <!-- prevent battery saver ?  not changeable through adb shell-->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" /> <!--Notification on lock screen   - not changeable through adb shell -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />  <!-- Needed for Android >= 14 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />  <!-- Downloads -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />  <!-- Needed for Android >= 13 if no mediaSession -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/> <!--Visualizer-->
    <uses-permission android:name="android.permission.INTERNET"/> <!-- to test internet access -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- to monitor online status -->
    
    <!-- Nearby Connections permissions -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /> <!-- needed if sdk<=28, optional after (FINE introduced), but allow user to select coarse in permission dialog => nice -->
    <uses-permission android:minSdkVersion="29" android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:maxSdkVersion="30" android:name="android.permission.BLUETOOTH" />
    <uses-permission android:maxSdkVersion="30" android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:minSdkVersion="31" android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:minSdkVersion="31" android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:minSdkVersion="31" android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:minSdkVersion="32" android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" tools:ignore="UnusedAttribute" />

    <!-- <uses-permission android:name="android.permission.BIND_MEDIA_BROWSER_SERVICE"/>Car stuff -->

    <!-- <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />  for books download -->

