<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" /> <!-- indeed not set on sdk 33 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" /> <!-- prevent battery saver ?  not changeable through adb shell-->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" /> <!--Notification on lock screen   - not changeable through adb shell -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />  <!-- Needed for Android >= 14 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />  <!-- Needed for Android >= 13 if no mediaSession -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/> <!--Visualizer-->
    <uses-permission android:name="android.permission.INTERNET"/> <!-- to test internet access -->


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.BookPlayer"
        android:name=".MyPersonalApp"

        >

        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activities.PlayActivity" />
        <activity android:name=".activities.ZikFileActivity" />
        <activity android:name=".activities.GetResourceActivity" />
        <activity android:name=".activities.FolderModifyActivity" />
        <activity android:name=".activities.ZikFileModifyActivity" />
        <activity android:name=".activities.AddResourceActivity" />
        <activity android:name=".activities.HelpActivity" />
        <activity android:name=".activities.OptionActivity" />
        <activity android:name=".activities.OtherAppsActivity" />
        <activity android:name=".activities.BiggerTextActivity" />
        <activity android:name=".activities.LogListActivity" />
        <activity android:name=".activities.StatsActivity" />
        <activity android:name=".activities.CacheFilesActivity" />

        <service
            android:name=".utils.AudioService"
            android:enabled="true"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>
        <receiver android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
        <service
            android:name=".utils.AddResourceService"
            android:stopWithTask="true" />
        <service
            android:name=".utils.CopyFileService"
            android:stopWithTask="true" />
        <service
            android:name=".utils.UnzipService"
            android:stopWithTask="true" />
        <service
            android:name=".utils.DownloadService"
            android:exported="false"/>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider" />
        </provider>
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />
    </application>

</manifest>