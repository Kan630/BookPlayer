<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.driot.bookplayer">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.BookPlayer">
        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activities.PlayActivity" />
        <activity android:name=".activities.ZikFileActivity" />
        <activity android:name=".activities.GetResourceActivity" />
        <activity android:name=".activities.FolderModifyActivity" />
        <activity android:name=".activities.ZikFileModifyActivity" />
        <activity android:name=".activities.AddResourceActivity" />
        <activity android:name=".activities.HelpActivity" />
        <activity android:name=".activities.OptionActivity" />
        <activity android:name=".activities.OtherAppsActivity" />
        <activity android:name=".activities.BiggerTextActivity" />
        <activity android:name=".activities.LogListActivity" />
        <activity android:name=".activities.DbBackupActivity" />

        <service
            android:name=".utils.AudioService"
            android:stopWithTask="true" />
        <service
            android:name=".utils.AddResourceService"
            android:stopWithTask="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider" />
        </provider>
    </application>

</manifest>