<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" /> <!-- indeed not set on sdk 33 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" /> <!-- needed to export to download on old devices -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" /> <!-- prevent battery saver ?  not changeable through adb shell-->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" /> <!--Notification on lock screen   - not changeable through adb shell -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />  <!-- Needed for Android >= 14 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />  <!-- Downloads -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />  <!-- Needed for Android >= 13 if no mediaSession -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/> <!--Visualizer-->
    <uses-permission android:name="android.permission.INTERNET"/> <!-- to test internet access -->
    <!-- <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />  for books download -->

    <meta-data android:name="google_analytics_adid_collection_enabled"
        android:value="false" />
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.BookPlayer"
        android:name=".MyApp"
        >


        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activities.PlayActivity"
            android:parentActivityName=".activities.MainActivity"/>
        <activity android:name=".activities.ZikFileActivity"
            android:parentActivityName=".activities.MainActivity"/>
        <activity android:name=".activities.GetActivity" />
        <activity android:name=".activities.GetOtherActivity" />
        <activity android:name=".activities.GetAudiobookActivity" />
        <activity android:name=".activities.GetPodcastActivity" />
        <activity android:name=".activities.LoadBookActivity" />
        <activity android:name=".activities.ModifyFolderActivity" />
        <activity android:name=".activities.ModifyZikFileActivity" />
        <activity android:name=".activities.AddResourceActivity" />
        <activity android:name=".activities.HelpActivity" />
        <activity android:name=".activities.OptionActivity" />
        <activity android:name=".activities.PodcastSettingsActivity" />
        <activity android:name=".activities.LogTextActivity" />
        <activity android:name=".activities.LogListActivity" />
        <activity android:name=".activities.StatsActivity" />
        <activity android:name=".activities.CleanMemoryActivity" />
        <activity android:name=".activities.ExportActivity" />
        <activity android:name=".activities.LibrivoxResultsActivity" />
        <activity android:name=".activities.LibrivoxDetailActivity" />
        <activity android:name=".activities.PodcastSearchResultsActivity"/>
        <activity android:name=".activities.PodcastEpisodeActivity"/>
        <activity android:name=".activities.PodcastFavoritesActivity"/>
        <activity android:name=".activities.SupportedExtensionsActivity"/>
        <activity android:name=".activities.DebugDatabaseActivity"
            android:exported="false"
            android:enabled="true">
        </activity>
        <activity
            android:name=".activities.AdminActivity"
            android:exported="false"
            android:label="Admin"
            />

        <activity
            android:name=".activities.OpenWithProxyActivity"
            android:enabled="false"
            android:exported="true">
            <!-- ZIP support -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:pathPattern=".*\\.zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
            </intent-filter>

            <!-- Standard audio -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" />
                <data android:scheme="content" android:host="*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- Standard m4b (audio/m) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" />
                <data android:scheme="content" android:host="*" />
                <data android:mimeType="audio/m4b" />
            </intent-filter>

            <!-- Alternative m4b (audio/x-m4b) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" />
                <data android:scheme="content" android:host="*" />
                <data android:mimeType="audio/x-m4b" />
            </intent-filter>

            <!-- Fallback: extension-based match for *.m4b with any MIME -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.m4b" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.m4b" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.m4b" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.m4b" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- E-Book support (EPUB + TXT) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" />
                <data android:scheme="content" android:host="*" />
                <!-- EPUB official MIME -->
                <data android:mimeType="application/epub+zip" />
                <!-- TXT standard MIME -->
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Fallback: extension-based match for *.epub and *.txt -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.epub" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.epub" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.txt" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.txt" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.epub" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.epub" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.txt" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.txt" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>


        <activity
            android:name=".activities.OpenWithProxyActivityAll"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.AudioService"
            android:enabled="true"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>
        <receiver android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
        <service
            android:name=".services.ExportService"
            android:exported="false"
            android:stopWithTask="true" />
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <service
            android:name=".player.CarMediaService"
            android:exported="true">             <!--android:permission="android.permission.BIND_MEDIA_BROWSER_SERVICE"-->
        <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider" />
        </provider>
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />

    </application>

</manifest>