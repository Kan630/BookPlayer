<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-31 equivalent of data_extraction_rules.xml (ignored on API 31+, which uses that file
    instead). Keep both in sync - see data_extraction_rules.xml for why the database is
    excluded wholesale.
-->
<full-backup-content>
    <exclude domain="file" path="unzipped/" />
    <exclude domain="file" path="download/" />
    <exclude domain="file" path="linked/" />
    <exclude domain="file" path="images/" />
    <exclude domain="file" path="cached_images/" />
    <exclude domain="database" path="BookPlayer" />
</full-backup-content>
