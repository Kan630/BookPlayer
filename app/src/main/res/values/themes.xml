<resources>

    <style name="Theme.BookPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Semantic surfaces/backgrounds (LIGHT) -->
        <item name="colorSurface">@color/bp_surface</item>
        <item name="colorOnSurface">@color/bp_onSurface</item>
        <item name="colorOutline">@color/bp_outline</item>
        <item name="colorSurfaceVariant">@color/purple_Surface</item>
        <item name="colorOnSurfaceVariant">@color/bp_onSurface</item>
        <item name="colorSurfaceActivated">@color/purple_SurfaceActivated</item>
        <item name="colorSurfacePressed">@color/purple_SurfacePressed</item>
        <item name="colorGraySecondary">@color/gray_secondary</item>

        <!-- Material 3 roles the app didn't have under M2 - aliased to existing per-skin
             colors above rather than hand-authoring new ones for all 17 skins. These are
             consumed by default M3 component styles (e.g. BottomNavigationView's selected-item
             pill uses colorSecondaryContainer/colorOnSecondaryContainer) that previously had no
             equivalent under M2, so they silently fell back to Material's generic baseline
             purple regardless of the active skin. -->
        <item name="colorSecondaryContainer">?attr/colorSurfaceActivated</item>
        <item name="colorOnSecondaryContainer">?attr/colorOnSurface</item>

        <!-- System bars / window -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">?attr/colorSurface</item>

        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>

    </style>

