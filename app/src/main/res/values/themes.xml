    <style name="Theme.BookPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Semantic surfaces/backgrounds (LIGHT) -->
        <item name="colorSurface">@color/bp_surface</item>
        <item name="colorOnSurface">@color/bp_onSurface</item>
        <item name="colorOutline">@color/bp_outline</item>
        <item name="colorSurfaceVariant">@color/purple_Surface</item>
        <item name="colorOnSurfaceVariant">@color/bp_onSurface</item>
        <item name="colorSurfaceActivated">@color/purple_SurfaceActivated</item>
        <item name="colorSurfacePressed">@color/purple_SurfacePressed</item>

        <!-- System bars / window -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">?attr/colorSurface</item>

    </style>

