<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ***************** COMMON ***************** -->

    <style name="textColor" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/text_default</item>
    </style>

    <style name="myStyleTextExplainButton" parent="textColor">
    </style>

    <style name="myStyleTitle" parent="textColor">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="myStyleTextTitle2" parent="textColor">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">50sp</item>
        <item name="android:layout_marginTop">20sp</item>
    </style>

    <!-- ***************** PLAY ACTIVITY ***************** -->

    <style name="PlayActivityActionButtons">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">60sp</item>
        <item name="android:textSize">32sp</item>
        <item name="android:layout_marginStart">0sp</item>
        <item name="android:paddingVertical">0dp</item>
    </style>

    <style name="PlayActivity_TrackName" parent="textColor">
        <item name="android:textColor">?colorPrimary</item>
        <item name="android:textSize">25sp</item>
    </style>

    <!-- ***************** LAYOUT ***************** -->

    <style name="LayoutWrapContentMargin20horizontal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="LinearLayoutOptionsVertical">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">20sp</item>
        <item name="android:layout_marginBottom">20sp</item>
    </style>>

    <style name="LinearLayoutOptionsCheckBoxHorizontal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginStart">0sp</item>
        <item name="android:layout_marginTop">20sp</item>
    </style>


    <!-- ***************** OPTIONS ***************** -->

    <style name="OptionTitle" parent="textColor">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">50sp</item>
        <item name="android:layout_marginTop">20sp</item>
    </style>

    <style name="OptionSubTitle" parent="textColor">
        <item name="android:layout_marginTop">10sp</item>
        <item name="android:layout_marginEnd">5sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">10sp</item>
        <item name="android:textAlignment">textEnd</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="OptionCheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="OptionCheckBoxText" parent="textColor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">10sp</item>
        <item name="android:layout_marginEnd">3sp</item>
        <item name="android:textAlignment">textEnd</item>
        <item name="android:textSize">16sp</item>
    </style>>

    <style name="OptionMiniText" parent="textColor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAlignment">textEnd</item>
        <item name="android:layout_marginStart">0sp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="OptionsColorButtons">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">40sp</item>
    </style>

    <!-- ***************** HELP ***************** -->

    <style name="HelpTitle" parent="textColor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">50sp</item>
        <item name="android:layout_marginTop">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="HelpText" parent="textColor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10sp</item>
        <item name="android:layout_marginTop">20sp</item>
    </style>>

    <!-- ***************** FOLDERS ***************** -->

    <style name="folderStyle">
        <item name="android:background">@drawable/rounded_corner</item>
        <item name="android:textColor">@color/black</item>
    </style>>

    <style name="audioName" parent="folderStyle">
    </style>>

    <style name="lastAccess" parent="folderStyle">
        <item name="android:textAlignment">textEnd</item>
    </style>>


    <!-- ***************** GET RESOURCES ***************** -->

    <style name="GetResourceButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginStart">50dp</item>
    </style>

    <style name="GetResourceTextTopOfButton" parent="myStyleTextExplainButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/GetRessource320_vertical_margin_low</item>
        <item name="android:paddingHorizontal">50dp</item>
    </style>

    <style name="GetResourceTextSectionTitle" parent="myStyleTextTitle2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">30dp</item>
        <item name="android:paddingHorizontal">10dp</item>
    </style>

    <!-- ***************** DIVERS ***************** -->

    <style name="myStyleViewSimpleHorizontalBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">10sp</item>
        <item name="android:background">@android:color/darker_gray</item>
    </style>>




</resources>