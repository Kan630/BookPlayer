    </style>

    <style name="ThemeOverlay.BookPlayer.Font.Casual">
        <item name="fontFamilyGlobal">casual</item>
    </style>

    <style name="ThemeOverlay.BookPlayer.Font.Cursive">
        <item name="fontFamilyGlobal">cursive</item>
    </style>

    <style name="ThemeOverlay.BookPlayer.Font.SerifMono">
