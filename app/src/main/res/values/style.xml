<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ***************** COMMON ***************** -->

    <style name="MainContainer">
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="textColor" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/bp_onSurface</item>
    </style>

    <style name="textColorFont" parent="textColor">
        <item name="android:fontFamily">?attr/fontFamilyGlobal</item>"
        <item name="fontFamily">?attr/fontFamilyGlobal</item>
    </style>

    <style name="simpleText" parent="textColorFont">
    </style>

    <style name="simpleTextWrap" parent="simpleText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="errorText" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/red_500</item>
    </style>

    <style name="warningText" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/orange_500</item>
    </style>
    <style name="warningTextView" parent="warningText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>


    <style name="EditText" parent="TextAppearance.AppCompat">
        <item name="android:background">@drawable/rounded_corner_theme</item>
        <item name="android:textColor">?colorOnSecondary</item>
        <item name="android:textColorHighlight">?colorSecondaryVariant</item>
        <item name="android:textCursorDrawable">@drawable/edittext_cursor</item>
    </style>

    <style name="dayNightText" parent="textColorFont">
        <item name="android:textColor">@color/textColor</item>
    </style>

    <style name="myStyleTitle" parent="textColorFont">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="myStyleBigTitle" parent="textColorFont">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="myStyleInfo" parent="textColorFont">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="myStyleTextTitle2" parent="textColorFont">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">50sp</item>
        <item name="android:layout_marginTop">20sp</item>
    </style>

    <style name="Spinner" parent="TextAppearance.AppCompat"> // DOES NOT SEEM TO WORK, CHECK => spinner_item.xml (is set programmatically in Activity adapter)
        <item name="android:background">@drawable/rounded_corner_theme</item>
        <item name="android:popupBackground">?colorSecondary</item>
        <item name="android:textColor">?colorOnSecondary</item>
        <item name="android:textColorHighlight">?colorOnSecondary</item>
    </style>

    <style name="MaterialButtonForToggleGroup" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>


    <!-- ***************** PLAY ACTIVITY ***************** -->

    <style name="PlayActivityActionButtons">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">10sp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="cornerRadius">12dp</item>
    </style>




    <style name="PlayActivity_TrackName" parent="textColor">
        <item name="android:textColor">?colorPrimary</item>
        <item name="android:textSize">25sp</item>
    </style>

    <!-- ***************** LAYOUT ***************** -->
    <style name="simpleLinearLayout_Horizontal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="simpleLinearLayout_Vertical">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="wideLinearLayout_Vertical">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="LayoutWrapContentMargin20horizontal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="LinearLayoutOptionsVertical">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">20sp</item>
        <item name="android:layout_marginBottom">20sp</item>
    </style>

    <style name="LinearLayoutOptionsCheckBoxHorizontal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginStart">0sp</item>
        <item name="android:layout_marginTop">20sp</item>
    </style>


    <!-- ***************** OPTIONS ***************** -->

    <style name="OptionTitle" parent="textColorFont">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">20dp</item>
    </style>

    <style name="OptionMasterTitle" parent="OptionTitle">
        <item name="android:textSize">26sp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="OptionSubTitle" parent="textColorFont">
        <item name="android:layout_marginTop">10sp</item>
        <item name="android:layout_marginEnd">5sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">10sp</item>
        <item name="android:textAlignment">textEnd</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="OptionCheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="OptionCheckBoxText" parent="textColorFont">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">10sp</item>
        <item name="android:layout_marginEnd">3sp</item>
        <item name="android:textAlignment">textEnd</item>
        <item name="android:textSize">16sp</item>
    </style>>

    <style name="OptionTextDefaultFor" parent="textColorFont">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">10sp</item>
        <item name="android:layout_marginEnd">3sp</item>
        <item name="android:textAlignment">textEnd</item>
        <item name="android:textSize">10sp</item>
    </style>>

    <style name="OptionMiniText" parent="textColorFont">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAlignment">textEnd</item>
        <item name="android:layout_marginStart">0sp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="OptionsColorButtons">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">40sp</item>
    </style>

    <style name="OptionPodcastText" parent="textColorFont">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="OptionPodcastTextBeforeEditText" parent="OptionPodcastText">
        <item name="android:layout_marginStart">30dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:text">after</item>
    </style>
    <style name="OptionPodcastTextAfterEditText" parent="OptionPodcastText">
        <item name="android:layout_marginStart">5dp</item>
    </style>
    <style name="OptionPodcastEditText" parent="EditText">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:inputType">number</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="miniPlayerButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">?attr/colorOnSecondary</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="PodcastImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="PodcastHeaderImageButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>



    <!-- ***************** HELP *****************  parent="?attr/borderlessButtonStyle"-->

    <style name="HelpTitle" parent="textColorFont">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">50dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="HelpText" parent="textColorFont">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginTop">20dp</item>
    </style>>

    <!-- ***************** IMPORT EN COURS ***************** -->

    <style name="OnGoingImportTitle" parent="textColorFont">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="OnGoingImportText" parent="textColorFont">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10sp</item>
        <item name="android:textSize">12sp</item>
    </style>>

    <!-- ***************** FOLDERS ***************** -->

    <style name="folderStyle">
        <item name="android:background">@drawable/rounded_corner</item>
        <item name="android:textColor">@color/black</item>
    </style>>

    <style name="audioName" parent="folderStyle">
    </style>>

    <style name="lastAccess" parent="folderStyle">
        <item name="android:textAlignment">textEnd</item>
    </style>>


    <!-- ***************** GET RESOURCES ***************** -->

    <style name="GetResourceTextTopOfButton" parent="textColorFont">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:layout_marginStart">40dp</item>
        <item name="android:layout_marginEnd">50dp</item>
    </style>

    <style name="GetResourceTextSectionTitle" parent="myStyleTextTitle2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">30dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="GetResourceEditText" parent="EditText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:layout_marginStart">20dp</item>
    </style>
    <style name="GetResourceEditTextButtons">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
    </style>

    <style name="GetResourceHorizontalBar" parent="myStyleViewSimpleHorizontalBar">
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="GetResourceSpinner" parent="Spinner">
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
    </style>

    <style name="GetResourceSpinnerText" parent="textColor">
        <item name="android:textColor">?colorOnSecondary</item>
    </style>




    <!-- ***************** LOAD OPTION AFTER FILE PICKED ***************** -->

    <style name="OptionAfterPickedTitle" parent="textColorFont">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20sp</item>
        <item name="android:layout_marginEnd">10sp</item>
        <item name="android:layout_marginTop">20sp</item>
    </style>

    <style name="OptionAfterPickedInfo" parent="textColorFont">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginStart">10sp</item>
        <item name="android:layout_marginEnd">10sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>


    <!-- ***************** EXPORT ***************** -->

    <style name="ExportTitle" parent="textColorFont">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20sp</item>
        <item name="android:layout_marginTop">20sp</item>
    </style>

    <style name="ExportProgressText" parent="textColorFont">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20sp</item>
        <item name="android:layout_marginTop">20sp</item>
    </style>

    <style name="GetResourceButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
    </style>


    <!-- ***************** DIVERS ***************** -->

    <style name="myStyleViewSimpleHorizontalBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">10sp</item>
        <item name="android:background">@android:color/darker_gray</item>
    </style>>

    <style name="spacer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>


    <style name="radio_btn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">6dp</item>
        <!-- Auto-size text -->
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">10sp</item>
        <item name="autoSizeMaxTextSize">14sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>





    <!-- Thème de l'activité en style "dialog" qui respecte ton thème M3 : parent="Theme.Material3.DayNight.Dialog"    Theme.MaterialComponents.DayNight.NoActionBar-->
    <style name="Theme.BookPlayer.DialogActivity" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@style/Anim.BookPlayer.Dialog</item>
    </style>

    <style name="Anim.BookPlayer.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>


    <!-- TEXT FONT -->

    <style name="ThemeOverlay.BookPlayer.Font" parent="ThemeOverlay.AppCompat">
        <item name="fontFamilyGlobal">sans-serif</item>
    </style>

    <!-- Overlays par famille système -->
    <style name="ThemeOverlay.BookPlayer.Font.Sans">
        <item name="fontFamilyGlobal">sans-serif</item>
    </style>

    <style name="ThemeOverlay.BookPlayer.Font.Serif">
