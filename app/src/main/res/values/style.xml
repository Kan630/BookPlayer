    <!-- ***************** BUTTON ROLES (Material 3) ***************** -->
    <!-- The 3 roles from the button audit - every Button/MaterialButton in the app should use
         one of these instead of going unstyled or reaching for a raw Widget.Material3.* name
         directly, so any future adjustment (shape, elevation) happens in one place. -->

    <!-- The one thing a screen most wants you to do: Start, Save, Confirm, a lone CTA. -->
    <style name="Widget.BookPlayer.Button.Primary" parent="Widget.Material3.Button" />

    <!-- A secondary action next to a primary one, or one of several peer/utility actions where
         no single one is "the" action (admin/debug screens, a detail screen's action menu,
         browse-screen shortcuts, choice-like presets). -->
    <style name="Widget.BookPlayer.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton" />

    <!-- Low-emphasis: Cancel/Dismiss, or a button that sits inline with other content instead
         of standing on its own. -->
    <style name="Widget.BookPlayer.Button.Text" parent="Widget.Material3.Button.TextButton" />

    <!-- ***************** TEXT FIELDS (Material 3) ***************** -->
    <!-- Real M3 text fields: replaces the old hand-drawn solid-colorSecondary box
         (rounded_corner_theme) and the plain unstyled EditText fallback with the actual
         TextInputLayout/TextInputEditText components - outlined box, colorOutline stroke,
         floating label support, ripple/focus states for free. -->

    <!-- Full-size fields (search boxes, free-text entry). -->
    <style name="Widget.BookPlayer.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox" />

    <!-- Small inline numeric fields that used to be a fixed 40-70dp box sitting between two
         bits of label text (e.g. "Return max [ 50 ] podcasts") - Dense trims the box's internal
         padding so it doesn't balloon in a tight row. -->
    <style name="Widget.BookPlayer.TextInputLayout.Compact" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense" />


    <!-- ***************** SETTINGS SCREENS ***************** -->

    <style name="SettingsGroupCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="cardCornerRadius">8dp</item>
