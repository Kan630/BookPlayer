<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Vertical navigation rail on the left -->
        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/bottomNav"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:menu="@menu/bottom_nav_menu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Top overlay -->
        <FrameLayout
            android:id="@+id/topOverlayContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/bottomNav"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Main content to the right of the rail -->
        <FrameLayout
            android:id="@+id/base_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/topOverlayContainer"
            app:layout_constraintBottom_toTopOf="@id/miniNowPlaying"
            app:layout_constraintStart_toEndOf="@id/bottomNav"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Mini now playing bar at the bottom, full width of content area -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/miniNowPlaying"
            android:name="com.driot.bookplayer.player.MiniPlayHostFragment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/bottomNav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_insetEdge="bottom" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
