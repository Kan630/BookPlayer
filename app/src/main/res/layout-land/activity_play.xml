<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".activities.MainActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    style="@style/MainContainer">

    <!-- Zone principale (4/5 hauteur) -->
    <LinearLayout
        android:id="@+id/contentTwoColumns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- COLONNE GAUCHE : titre, sous-titre, visuel/visualizer, TTS -->
        <LinearLayout
            android:id="@+id/leftColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Zone affichage : image/visualizer/TTS partagent la même place -->
            <FrameLayout
                android:id="@+id/visualZone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                >

                <com.driot.bookplayer.views.ClickInterceptFrameLayout
                    android:id="@+id/coverContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >
                    <ImageView
                        android:id="@+id/folderImage"
                        android:contentDescription="@string/book_cover"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        />

                    <com.driot.bookplayer.views.FrequencyVisualizerView
                        android:id="@+id/frequencyVisualizerView"
                        android:contentDescription="@string/frequency_visualizer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        />
                </com.driot.bookplayer.views.ClickInterceptFrameLayout>

                <!-- TTS : remplace visuellement le visualizer quand visible -->
                <LinearLayout
                    android:id="@+id/ttsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/ttsTopRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/spinnerTtsVoice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/btnToggleTtsView"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/toggle_text_image"
                            android:src="@android:drawable/ic_menu_gallery" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTtsText"
                        style="@style/textColor"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="vertical"
                        android:textIsSelectable="false"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:textSize="16sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- COLONNE DROITE : seekbar, speed, sleep -->
        <LinearLayout
            android:id="@+id/rightColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:baselineAligned="false"
            android:weightSum="6"
            >

            <!-- BLOCK 1: Title + Subtitle (weight 2) -->
            <LinearLayout
                android:id="@+id/blockTitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/textviewTitle"
                    android:text="@string/title"
                    android:textColor="?attr/colorPrimary"
                    style="@style/myStyleTitle"
                    android:layout_marginTop="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:scrollHorizontally="false"
                    android:singleLine="false"
                    android:ellipsize="end"
                    android:maxLines="2"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMaxTextSize="30sp"
                    app:autoSizeMinTextSize="15sp"
                    app:autoSizeStepGranularity="1sp" />

                <TextView
                    android:id="@+id/textViewSubTitle"
                    android:text="@string/subtitle"
                    android:textColor="?attr/colorPrimaryVariant"
                    style="@style/myStyleTitle"
                    android:layout_marginBottom="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:scrollHorizontally="false"
                    android:singleLine="false"
                    android:ellipsize="end"
                    android:maxLines="3"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMaxTextSize="30sp"
                    app:autoSizeMinTextSize="15sp"
                    app:autoSizeStepGranularity="1sp" />
            </LinearLayout>

            <View style="@style/myStyleViewSimpleHorizontalBar" />

            <!-- SLEEP -->
            <!-- BLOCK 2: Sleep row (weight 1) -->
            <LinearLayout
                android:id="@+id/blockSleep"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/bSetSleep"
                    android:text="@string/btnSleepSet"
                    android:textSize="13sp"
                    android:paddingVertical="0dp"
                    android:layout_marginStart="15dp"
                    android:textAlignment="gravity"
                    android:layout_width="wrap_content"
                    android:layout_height="50sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:paddingEnd="20dp">

                    <TextView
                        android:id="@+id/tv_ListeningTime"
                        android:text="..."
                        style="@style/textColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="italic"
                        android:textSize="11sp"
                        />

                    <TextView
                        android:id="@+id/tv_TimeLeft"
                        android:text="..."
                        style="@style/textColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="italic"
                        android:textSize="11sp"
                        />
                </LinearLayout>
            </LinearLayout>

            <View style="@style/myStyleViewSimpleHorizontalBar"
                android:layout_marginTop="3dp"/>


            <!-- BLOCK 3: Speed row (weight 1) -->
            <LinearLayout
                android:id="@+id/blockSpeed"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">

                <TextView
                    android:id="@+id/textViewSpeedDesc"
                    style="@style/textColor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/tvSpeed"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <!-- right group -->
                <Button
                    android:id="@+id/bSpeedDown"
                    android:text="-"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:textSize="30sp"
                    android:paddingVertical="0dp" />

                <TextView
                    android:id="@+id/textViewSpeed"
                    style="@style/textColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:paddingStart="10sp"
                    android:paddingEnd="10sp"
                    android:text="...%"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="30sp" />

                <Button
                    android:id="@+id/bSpeedUp"
                    android:text="+"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:textSize="24sp" />
            </LinearLayout>

            <View style="@style/myStyleViewSimpleHorizontalBar"
                android:layout_marginTop="3dp"/>


            <!-- BLOCK 4: Time + SeekBar (weight 2) -->
            <LinearLayout
                android:id="@+id/blockSeek"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">
                    <TextView
                        android:id="@+id/textViewSeekBar"
                        android:text="@string/current_position"
                        style="@style/textColor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?android:attr/textAppearanceMedium" />

                    <TextView
                        android:id="@+id/textViewTempsTotal"
                        android:text="@string/total_time"
                        style="@style/textColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:layout_marginStart="16dp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:progressDrawable="@drawable/seek_bar"
                    android:layout_marginBottom="8dp"
                    android:thumb="@drawable/seek_thumb" />
            </LinearLayout>


            <View style="@style/myStyleViewSimpleHorizontalBar"
                android:layout_marginTop="3dp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- RANGÉE DE BOUTONS (1/5 hauteur) -->
    <LinearLayout
        android:id="@+id/llCommandButtons"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        >

        <ImageButton
            android:id="@+id/ibRewind"
            style="@style/PlayActivityActionButtons"
            android:src="@drawable/ic_media_fast_rewind_24"
            android:contentDescription="@string/rewind"
            android:background="@drawable/rounded_corner_primary"
            app:tint="?attr/colorOnPrimary"
            android:cropToPadding="false" />

        <ImageButton
            android:id="@+id/ibPlayPause"
            style="@style/PlayActivityActionButtons"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_hourglass_24"
            android:contentDescription="@string/play"
            android:background="@drawable/rounded_corner_primary"
            app:tint="?attr/colorOnPrimary"
            android:cropToPadding="false" />

        <ImageButton
            android:id="@+id/ibForward"
            style="@style/PlayActivityActionButtons"
            android:src="@drawable/ic_media_fast_forward_24"
            android:contentDescription="@string/forward"
            android:background="@drawable/rounded_corner_primary"
            app:tint="?attr/colorOnPrimary"
            android:cropToPadding="false" />
    </LinearLayout>

    <!-- Overlays (inchangés) -->
    <include
        layout="@layout/include_progress_overlay"
        android:visibility="gone"/>
    <include
        layout="@layout/include_message_overlay"
        android:visibility="gone"/>

</LinearLayout>
