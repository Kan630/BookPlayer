<!-- res/drawable/bg_radio.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Activated state - Most prominent -->
    <item android:state_activated="true">
        <layer-list>
            <!-- Outer glow / thick border -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="5dp" />
                    <stroke
                        android:width="8dp"
                        android:color="?attr/colorPrimary" />
                </shape>
            </item>
            <!-- Inner border for extra pop -->
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="5dp" />
                    <stroke
                        android:width="2dp"
                        android:color="?attr/colorOnSurface" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Selected state (but not activated) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke
                android:width="5dp"
                android:color="?attr/colorSecondary" />
        </shape>
    </item>



</selector>