<!-- Smartphone icon (reserved storage) with the shared red "R" badge composited on top - see
     ic_badge_r.xml. Layered instead of baked into one vector so the base icon and the badge
     are two independent drawables rather than duplicated path data. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_memory_general_smartphone"/>
    <item
        android:width="5dp"
        android:height="6dp"
        android:right="5dp"
        android:bottom="4dp"
        android:gravity="bottom|end"
        android:drawable="@drawable/ic_badge_r"/>
</layer-list>
