        </clip>
    </item>
    <!-- Played (left side of thumb) -->
    <item android:id="@android:id/progress">
        <clip>
            <shape
                android:shape="line">
                <stroke
                    android:color="?attr/colorSecondary"
                    android:width="4dp"/>
            </shape>
        </clip>
    </item>

</layer-list>