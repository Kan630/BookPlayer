<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:fitsSystemWindows="true"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp">

    <!-- Container with image and overlay buttons -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/ivPodcastCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:gravity="start"
            android:layout_margin="8dp">

            <ImageButton
                android:contentDescription="@string/refresh"
                android:id="@+id/btnRefresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_refresh_24"
                />
            <TextView
                style="@style/simpleText"
                android:text="xx.ep"
                android:id="@+id/tvPodcastStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                />
            <ImageButton
                android:contentDescription="@string/sort"
                android:id="@+id/btnSort"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_sort_swap_vert_24"
                />
            <ImageButton
                android:contentDescription="@string/collapse"
                android:id="@+id/btnCollapse"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_content_expand_24"
                app:tint="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:gravity="end"
            android:layout_margin="8dp">

            <!-- Favorite Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/labelFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add to Favorites"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_marginEnd="4dp"
                    />

                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Favorite"
                    android:src="@drawable/ic_favorite"
                    />
            </LinearLayout>

            <!-- Auto Download Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/labelAutoDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Download"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_marginEnd="4dp"
                    />

                <ImageButton
                    android:id="@+id/btnAutoDownload"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Auto Download"
                    android:src="@drawable/ic_download_action_24"
                    />
            </LinearLayout>

            <!-- Auto Download Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <TextView
                    android:id="@+id/labelAutoDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Delete"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_marginEnd="4dp"
                    />

                <ImageButton
                    android:id="@+id/btnAutoDelete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Auto Delete"
                    android:src="@drawable/ic_delete_24"
                    />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <!-- Texts and episode list -->
    <TextView
        android:id="@+id/tvPodcastTitle"
        style="@style/simpleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginBottom="4dp"
        android:text="Podcast Title" />

    <TextView
        android:id="@+id/tvPodcastDescription"
        style="@style/simpleText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:textSize="14sp"
        android:padding="4dp"
        android:text="Podcast Description"
        />

    <ProgressBar
        android:id="@+id/progressBarEpisodes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEpisodes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/cardview_dark_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnMiniBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_media_fast_rewind_24"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ProgressBar
            android:id="@+id/progressMini"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true"
            android:visibility="gone"/>

        <ImageButton
            android:id="@+id/btnMiniPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_media_play_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"/>

        <ImageButton
            android:id="@+id/btnMiniForward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_media_fast_forward_24"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/tvMiniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@android:color/white"
                android:textSize="14sp"/>

            <SeekBar
                android:id="@+id/seekMini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvMiniTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:paddingStart="8dp"/>
    </LinearLayout>

</LinearLayout>
