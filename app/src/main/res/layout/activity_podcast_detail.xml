<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:fitsSystemWindows="true"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp">

    <!-- Container with image and overlay buttons -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/ivPodcastCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:gravity="end"
            android:layout_margin="8dp">

            <!-- Favorite Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/labelFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add to Favorites"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_marginEnd="4dp"
                    />

                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Favorite"
                    android:src="@drawable/ic_favorite"
                    />
            </LinearLayout>

            <!-- Auto Download Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/labelAutoDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Download"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_marginEnd="4dp"
                    />

                <ImageButton
                    android:id="@+id/btnAutoDownload"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Auto Download"
                    android:src="@drawable/ic_download_action_24"
                    />
            </LinearLayout>

            <!-- Auto Download Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <TextView
                    android:id="@+id/labelAutoDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Delete"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_marginEnd="4dp"
                    />

                <ImageButton
                    android:id="@+id/btnAutoDelete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Auto Delete"
                    android:src="@drawable/ic_delete_24"
                    />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <!-- Texts and episode list -->
    <TextView
        android:id="@+id/tvPodcastTitle"
        style="@style/simpleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginBottom="4dp"
        android:text="Podcast Title" />

    <TextView
        android:id="@+id/tvPodcastDescription"
        style="@style/simpleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textSize="14sp"
        android:padding="4dp"
        android:text="Podcast Description"
        />

    <ProgressBar
        android:id="@+id/progressBarEpisodes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEpisodes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
