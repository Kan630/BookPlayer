<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/coordinator_layout"
    >

    <!-- Collapsible header area -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/rvEpisodes">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="?attr/colorSurface"
            app:statusBarScrim="?attr/colorSurface"
            app:toolbarId="@+id/toolbar"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            >

            <!-- CONTENT INSIDE THE COLLAPSING AREA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="0dp"
                >

                <!-- Container with image and overlay buttons -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="12dp"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.65"
                    >

                    <ImageView
                        android:id="@+id/ivPodcastCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        />

                    <!-- LEFT overlay controls -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentStart="true"
                        android:gravity="start"
                        android:layout_margin="8dp">

                        <ImageButton
                            android:id="@+id/btnRefreshOverlay"
                            android:contentDescription="@string/refresh"
                            android:src="@drawable/ic_refresh_24"
                            style="@style/PodcastImageButton"/>

                        <TextView
                            android:id="@+id/tvPodcastStat"
                            style="@style/simpleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="xx.ep" />

                        <ImageButton
                            android:id="@+id/btnSortOverlay"
                            android:contentDescription="@string/sort"
                            android:src="@drawable/ic_sort_swap_vert_24"
                            style="@style/PodcastImageButton"/>

                        <ImageButton
                            android:id="@+id/btnCollapseOverlay"
                            android:contentDescription="@string/collapse"
                            android:src="@drawable/ic_content_expand_24"
                            style="@style/PodcastImageButton"/>

                    </LinearLayout>

                    <!-- RIGHT overlay controls -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:gravity="end"
                        android:layout_margin="8dp">

                        <ImageButton
                            android:id="@+id/btnFavoriteOverlay"
                            android:contentDescription="@string/Add_to_favorite"
                            android:src="@drawable/ic_favorite"
                            android:layout_marginBottom="8dp"
                            style="@style/PodcastImageButton"/>


                        <ImageButton
                            android:id="@+id/btnAutoDownloadOverlay"
                            android:contentDescription="@string/Auto_Download_episodes"
                            android:src="@drawable/ic_download_action_24"
                            android:layout_marginBottom="8dp"
                            style="@style/PodcastImageButton"/>

                    </LinearLayout>
                </RelativeLayout>

                <!-- Title / description (collapse away with the header) -->
                <TextView
                    android:id="@+id/tvPodcastTitle"
                    style="@style/simpleText"
                    android:textColor="?colorPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginBottom="4dp"
                    android:text="Podcast Title" />

                <TextView
                    android:id="@+id/tvPodcastDescription"
                    style="@style/simpleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="14sp"
                    android:padding="4dp"
                    android:text="Podcast Description"
                    android:visibility="gone"
                    />
            </LinearLayout>

            <!-- TOP BAND -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:layout_collapseMode="pin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMiniCover"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvToolbarStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
                    <TextView
                        android:id="@+id/tvToolbarTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                    <!-- Toolbar actions (IDs distinct from overlays) -->
                    <ImageButton
                        android:id="@+id/btnFavoriteToolbar"
                        android:contentDescription="@string/Add_to_favorite"
                        android:src="@drawable/ic_favorite"
                        style="@style/PodcastHeaderImageButton"/>

                    <ImageButton
                        android:id="@+id/btnAutoDownloadToolbar"
                        android:contentDescription="@string/Auto_Download_episodes"
                        android:src="@drawable/ic_download_action_24"
                        style="@style/PodcastHeaderImageButton"/>

                    <ImageButton
                        android:id="@+id/btnRefreshToolbar"
                        android:contentDescription="@string/refresh"
                        android:src="@drawable/ic_refresh_24"
                        style="@style/PodcastHeaderImageButton"/>

                    <ImageButton
                        android:id="@+id/btnSortToolbar"
                        android:contentDescription="@string/sort"
                        android:src="@drawable/ic_sort_swap_vert_24"
                        style="@style/PodcastHeaderImageButton"/>

                    <ImageButton
                        android:id="@+id/btnCollapseToolbar"
                        android:contentDescription="@string/expand"
                        android:src="@drawable/ic_content_expand_24"
                        style="@style/PodcastHeaderImageButton"/>

                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- SCROLLING CONTENT -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEpisodes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="64dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/miniNowPlaying"
        android:name="com.driot.bookplayer.player.MiniNowPlayingFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:layout_insetEdge="bottom"
        />

    <!-- MINI PLAYER pinned at bottom -->
    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="?colorSecondary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        app:layout_insetEdge="bottom">

        <ImageButton
            android:id="@+id/btnMiniBack"
            android:src="@drawable/ic_media_fast_rewind_24"
            style="@style/miniPlayerButton"
            />

        <ProgressBar
            android:id="@+id/progressMini"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/colorOnSecondary"
            android:visibility="gone"/>

        <ImageButton
            android:id="@+id/btnMiniPlayPause"
            android:src="@drawable/ic_media_play_24"
            style="@style/miniPlayerButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            />

        <ImageButton
            android:id="@+id/btnMiniForward"
            android:src="@drawable/ic_media_fast_forward_24"
            style="@style/miniPlayerButton"
            />

        <SeekBar
            android:id="@+id/seekMini"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="?attr/colorPrimaryVariant"
            android:thumbTint="?colorSecondaryVariant"
            android:max="1000"/>

        <TextView
            android:id="@+id/tvMiniTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?colorOnSecondary"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
