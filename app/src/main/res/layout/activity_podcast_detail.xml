<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/coordinator_layout"
    >

    <!-- Collapsible header area -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/rvEpisodes">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="?attr/colorSurface"
            app:statusBarScrim="?attr/colorSurface"
            app:toolbarId="@+id/toolbar"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            >

            <!-- CONTENT INSIDE THE COLLAPSING AREA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="0dp"
                >

                <!-- Container with image and overlay buttons -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="12dp"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.65"
                    >

                    <ImageView
                        android:id="@+id/ivPodcastCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        />

                    <!-- LEFT overlay controls -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentStart="true"
                        android:gravity="start"
                        android:layout_margin="8dp">

                        <ImageButton
                            android:id="@+id/btnRefreshOverlay"
                            android:contentDescription="@string/refresh"
                            android:src="@drawable/ic_refresh_24"
                            style="@style/PodcastImageButton"/>

                        <TextView
                            android:id="@+id/tvPodcastStat"
                            style="@style/simpleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="xx.ep" />

                        <ImageButton
                            android:id="@+id/btnSortOverlay"
                            android:contentDescription="@string/sort"
                            android:src="@drawable/ic_sort_swap_vert_24"
                            style="@style/PodcastImageButton"/>

                        <ImageButton
                            android:id="@+id/btnCollapseOverlay"
                            android:contentDescription="@string/collapse"
                            android:src="@drawable/ic_content_expand_24"
                            style="@style/PodcastImageButton"/>

                    </LinearLayout>

                    <!-- RIGHT overlay controls -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:gravity="end"
                        android:layout_margin="8dp">

                        <ImageButton
                            android:id="@+id/btnFavoriteOverlay"
                            android:contentDescription="@string/Add_to_favorite"
                            android:src="@drawable/ic_favorite"
                            android:layout_marginBottom="8dp"
                            style="@style/PodcastImageButton"/>


                        <ImageButton
                            android:id="@+id/btnAutoDownloadOverlay"
                            android:contentDescription="@string/Auto_Download_episodes"
                            android:src="@drawable/ic_download_action_24"
                            android:layout_marginBottom="8dp"
                            style="@style/PodcastImageButton"/>

                        <ImageButton
                            android:id="@+id/btnSearchOverlay"
                            android:contentDescription="@string/Search"
                            android:src="@drawable/ic_search_24px"
                            android:layout_marginBottom="8dp"
                            style="@style/PodcastImageButton"/>

                    </LinearLayout>
                </RelativeLayout>

                <!-- Title / description (collapse away with the header) -->
                <TextView
                    android:id="@+id/tvPodcastTitle"
                    style="@style/simpleText"
                    android:textColor="?colorPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginBottom="4dp"
                    android:text="Podcast Title" />

                <TextView
                    android:id="@+id/tvPodcastDescription"
                    style="@style/simpleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="14sp"
                    android:padding="4dp"
                    android:text="Podcast Description"
                    android:visibility="gone"
                    />
            </LinearLayout>

            <!-- TOP BAND -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:layout_collapseMode="pin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMiniCover"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvToolbarStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
                    <TextView
                        android:id="@+id/tvToolbarTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                    <!-- Toolbar actions (IDs distinct from overlays) -->
                    <ImageButton
                        android:id="@+id/btnFavoriteToolbar"
                        android:contentDescription="@string/Add_to_favorite"
                        android:src="@drawable/ic_favorite"
                        style="@style/PodcastHeaderImageButton"/>

                    <ImageButton
                        android:id="@+id/btnAutoDownloadToolbar"
                        android:contentDescription="@string/Auto_Download_episodes"
                        android:src="@drawable/ic_download_action_24"
                        style="@style/PodcastHeaderImageButton"/>

                    <ImageButton
                        android:id="@+id/btnSearchToolbar"
                        android:contentDescription="@string/Search"
                        android:src="@drawable/ic_search_24px"
                        style="@style/PodcastHeaderImageButton"/>

                    <ImageButton
                        android:id="@+id/btnRefreshToolbar"
                        android:contentDescription="@string/refresh"
                        android:src="@drawable/ic_refresh_24"
                        style="@style/PodcastHeaderImageButton"/>

                    <ImageButton
                        android:id="@+id/btnSortToolbar"
                        android:contentDescription="@string/sort"
                        android:src="@drawable/ic_sort_swap_vert_24"
                        style="@style/PodcastHeaderImageButton"/>

                    <ImageButton
                        android:id="@+id/btnCollapseToolbar"
                        android:contentDescription="@string/expand"
                        android:src="@drawable/ic_content_expand_24"
                        style="@style/PodcastHeaderImageButton"/>

                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- SEARCH BAR AREA -->
        <LinearLayout
            android:id="@+id/layoutSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="?attr/colorSurface"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnBackSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_arrow_back_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/Close"
                    app:tint="?attr/colorOnSurface" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/Filter_episodes"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:background="@android:color/transparent"
                    android:paddingVertical="12dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_media_close_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbSearchInDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Search_also_in_episode_description"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:buttonTint="?attr/colorPrimary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/dividerHorizontal"
                android:layout_marginTop="4dp"
                android:alpha="0.3" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- SCROLLING CONTENT -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEpisodes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
