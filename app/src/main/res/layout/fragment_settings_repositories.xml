<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/scrollView">

    <LinearLayout
        android:id="@+id/ll_Podcast"
        style="@style/LinearLayoutOptionsVertical"
        android:layout_marginTop="0dp"
        android:padding="8dp">

        <!-- Optional local title (hidden when embedded inline) -->
        <LinearLayout android:id="@+id/ll_title" style="@style/wideLinearLayout_Vertical">
            <View style="@style/myStyleViewSimpleHorizontalBar" />
            <TextView android:text="@string/repositories_settings" style="@style/OptionMasterTitle"/>
            <View style="@style/myStyleViewSimpleHorizontalBar" />
        </LinearLayout>


        <TextView
            style="@style/OptionTitle"
            android:text="@string/cover_search_repositories"/>

        <!-- Open Library -->
        <LinearLayout
            android:id="@+id/ll_option_use_open_library"
            style="@style/LinearLayoutOptionsCheckBoxHorizontal">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_option_use_open_library"
                style="@style/OptionCheckBox"
                android:layout_height="match_parent" />
            <TextView
                style="@style/OptionCheckBoxText"
                android:text="@string/open_library" />
        </LinearLayout>

        <!-- Google Books -->
        <LinearLayout
            android:id="@+id/ll_option_use_google_books"
            style="@style/LinearLayoutOptionsCheckBoxHorizontal">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_option_use_google_books"
                style="@style/OptionCheckBox"
                android:layout_height="match_parent" />
            <TextView
                style="@style/OptionCheckBoxText"
                android:text="@string/google_books" />
        </LinearLayout>

        <!-- Pixabay -->
        <LinearLayout
            android:id="@+id/ll_option_use_pixabay"
            style="@style/LinearLayoutOptionsCheckBoxHorizontal">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_option_use_pixabay"
                style="@style/OptionCheckBox"
                android:layout_height="match_parent" />
            <TextView
                style="@style/OptionCheckBoxText"
                android:text="@string/pixabay" />
        </LinearLayout>

        <!-- Google Images -->
        <LinearLayout
            android:id="@+id/ll_option_use_google_images"
            style="@style/LinearLayoutOptionsCheckBoxHorizontal"
            android:visibility="gone"
            >
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_option_use_google_images"
                style="@style/OptionCheckBox"
                android:layout_height="match_parent" />
            <TextView
                style="@style/OptionCheckBoxText"
                android:text="@string/google_images" />
        </LinearLayout>
        <TextView
            style="@style/OptionExplainText"
            android:text="@string/cover_search_repositories_explain" />


        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <TextView
            style="@style/OptionTitle"
            android:text="@string/Gutenberg_Ebooks"/>

        <TextView
            style="@style/OptionTitle"
            android:textSize="16sp"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="10dp"
            android:text="@string/lists_and_search"/>
        <TextView
            style="@style/OptionMiniText"
            android:layout_marginStart="20dp"
            android:text="@string/select_source" />
        <Spinner
            style="@style/Spinner"
            android:id="@+id/sp_gutendex_list_mirror"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:minHeight="36dp"
            android:layout_marginEnd="30dp" />

        <TextView
            style="@style/OptionTitle"
            android:textSize="16sp"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="10dp"
            android:text="@string/Download"/>

        <TextView
            style="@style/OptionMiniText"
            android:layout_marginStart="20dp"
            android:text="@string/select_source" />
        <Spinner
            style="@style/Spinner"
            android:id="@+id/sp_gutenberg_mirror"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:minHeight="36dp"
            android:layout_marginEnd="30dp"
            />


        <View style="@style/myStyleViewSimpleHorizontalBar" />


    </LinearLayout>
</ScrollView>