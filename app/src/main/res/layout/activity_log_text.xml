<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header with search and filters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorPrimary"
        android:padding="8dp"
        android:gravity="center_vertical">

        <!-- Search EditText -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Search..."
            android:inputType="text"
            android:maxLines="1"
            android:textColor="?attr/colorOnPrimary"
            android:textColorHint="?attr/colorOnPrimary"
            android:backgroundTint="?attr/colorOnPrimary" />

        <!-- WAR Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchWAR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WAR"
            android:textColor="?attr/colorOnPrimary"
            android:layout_marginStart="8dp" />

        <!-- ERR Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchERR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ERR"
            android:textColor="?attr/colorOnPrimary"
            android:layout_marginStart="8dp" />

        <!-- VER Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchVER"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VER"
            android:textColor="?attr/colorOnPrimary"
            android:layout_marginStart="8dp" />

        <!-- DEB Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchDEB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEB"
            android:textColor="?attr/colorOnPrimary"
            android:layout_marginStart="8dp" />

        <!-- INF Switch -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchINF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INF"
            android:textColor="?attr/colorOnPrimary"
            android:layout_marginStart="8dp" />

        <!-- Flip Order Button -->
        <ImageButton
            android:id="@+id/btnFlipOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sort_swap_vert_24"
            android:contentDescription="Flip order"
            android:layout_marginStart="8dp" />

        <!-- 5 Min Filter Button -->
        <Button
            android:id="@+id/btn5Min"
            android:text="5 min."
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            style="@style/simpleTextWrap" />

        <!-- Share Button -->
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_share_24px"
            android:contentDescription="Share"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_biggerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hello World!"
        android:scrollbars="vertical"
        />

</LinearLayout>