<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="2dp"
    android:background="?attr/colorPrimary">

    <ImageView
        android:id="@+id/ivCover"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/cover_preview"
        android:src="@drawable/ic_radio_24px" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/simpleText"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnPrimary"
            />

        <TextView
            android:id="@+id/tvSub"
            style="@style/simpleText"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="@string/live_radio"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnPrimary"
            />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/bMiniPlayPause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/play_pause"
        android:src="@drawable/ic_media_play_24"/>
    <ImageButton
        android:id="@+id/bMiniClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/Close"
        android:src="@drawable/ic_media_close_24"/>
</LinearLayout>
