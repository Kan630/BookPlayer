<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".activities.MainActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/MainContainer"
    >

<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    >

    <TextView
        android:id="@+id/textviewTitle"
        android:text="@string/title"
        android:textColor="?attr/colorPrimary"
        style="@style/myStyleTitle"
        android:layout_marginTop="10dp"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"

        android:scrollHorizontally="false"
        android:singleLine="false"
        android:ellipsize="end"
        android:maxLines="2"
        app:autoSizeTextType="uniform"
        app:autoSizeMaxTextSize="30sp"
        app:autoSizeMinTextSize="15sp"
        app:autoSizeStepGranularity="1sp"
        />

    <TextView
        android:id="@+id/textViewSubTitle"
        android:text="@string/subtitle"
        android:textColor="?attr/colorPrimaryVariant"
        android:layout_below="@+id/textviewTitle"
        style="@style/myStyleTitle"
        android:layout_marginBottom="10dp"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"

        android:scrollHorizontally="false"
        android:singleLine="false"
        android:ellipsize="end"
        android:maxLines="3"
        app:autoSizeTextType="uniform"
        app:autoSizeMaxTextSize="30sp"
        app:autoSizeMinTextSize="15sp"
        app:autoSizeStepGranularity="1sp"
        />

    <LinearLayout
        android:id="@+id/llCommandButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3">

        <ImageButton
            android:id="@+id/ibRewind"
            style="@style/PlayActivityActionButtons"
            android:src="@drawable/ic_media_fast_rewind_24"
            android:contentDescription="@string/rewind"
            android:background="@drawable/rounded_corner_primary"
            app:tint="?attr/colorOnPrimary"
            android:cropToPadding="false" />

        <ImageButton
            android:id="@+id/ibPlayPause"
            style="@style/PlayActivityActionButtons"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_hourglass_24"
            android:contentDescription="@string/play"
            android:background="@drawable/rounded_corner_primary"
            app:tint="?attr/colorOnPrimary"
            android:cropToPadding="false" />

        <ImageButton
            android:id="@+id/ibForward"
            style="@style/PlayActivityActionButtons"
            android:src="@drawable/ic_media_fast_forward_24"
            android:contentDescription="@string/forward"
            android:background="@drawable/rounded_corner_primary"
            app:tint="?attr/colorOnPrimary"
            android:cropToPadding="false" />
    </LinearLayout>

    <View style="@style/myStyleViewSimpleHorizontalBar"
        android:layout_above="@+id/llCommandButtons"
        />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/llCommandButtons"
        android:layout_marginBottom="10sp"
        android:progressDrawable="@drawable/seek_bar"
        android:thumb="@drawable/seek_thumb"
        />

    <TextView
        android:id="@+id/textViewSeekBar"
        android:text="@string/current_position"
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/seekBar"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <TextView
        android:id="@+id/textViewTempsTotal"
        android:text="@string/total_time"
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:layout_marginStart="30dp"
        android:layout_above="@+id/seekBar"
        android:layout_alignParentEnd="true"
        />



    <!-- PlayBack Speed -->
    <View style="@style/myStyleViewSimpleHorizontalBar"
        android:layout_above="@+id/textViewTempsTotal"
        />

    <View style="@style/myStyleViewSimpleHorizontalBar"
        android:id="@+id/horizontalBarTopOfSpeed"
        android:layout_marginTop="10dp"
        android:layout_above="@+id/bSpeedUp" />

    <TextView
        android:id="@+id/textViewSpeedDesc"
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/textViewTempsTotal"
        android:layout_marginEnd="20sp"
        android:layout_marginStart="20sp"
        android:layout_marginBottom="15sp"
        android:text="@string/tvSpeed"
        android:textAppearance="?android:attr/textAppearanceMedium" />
    <Button
        android:id="@+id/bSpeedDown"
        android:text="-"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:textSize="30sp"
        android:paddingVertical="0dp"
        android:textAlignment="gravity"
        android:layout_toStartOf="@id/textViewSpeed"
        android:layout_above="@+id/textViewTempsTotal"
        />

    <TextView
        android:id="@+id/textViewSpeed"
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/textViewTempsTotal"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="5sp"
        android:paddingStart="10sp"
        android:paddingEnd="10sp"
        android:text="...%"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="30sp" />
    <Button
        android:id="@+id/bSpeedUp"
        android:text="+"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:textSize="24sp"
        android:layout_toEndOf="@id/textViewSpeed"
        android:layout_above="@+id/textViewTempsTotal"
        />

    <!-- Sleep and Timer -->
    <View style="@style/myStyleViewSimpleHorizontalBar"
        android:id="@+id/horizontalBarTopOfSleep"
        android:layout_marginBottom="40dp"
        android:layout_above="@+id/horizontalBarTopOfSpeed" />

    <Button
        android:id="@+id/bSetSleep"
        android:text="@string/btnSleepSet"
        android:textSize="13sp"
        android:paddingVertical="0dp"
        android:textAlignment="gravity"
        android:layout_width="wrap_content"
        android:layout_height="50sp"
        android:layout_below="@+id/horizontalBarTopOfSleep"
        android:layout_marginTop="-40sp"
        android:layout_alignStart="@+id/bVolumeDown"
        />

    <TextView
        android:id="@+id/tv_ListeningTime"
        android:text="..."
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:textStyle="italic"
        android:textSize="11sp"
        android:layout_marginEnd="20sp"
        android:layout_above="@+id/tv_TimeLeft"
        android:layout_marginBottom="5sp"
        />
    <TextView
        android:id="@+id/tv_TimeLeft"
        android:text="..."
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:textStyle="italic"
        android:textSize="11sp"
        android:layout_marginEnd="20sp"
        android:layout_marginBottom="-4sp"
        android:layout_above="@+id/horizontalBarTopOfSpeed"
        />

    <com.driot.bookplayer.views.ClickInterceptFrameLayout
        android:id="@+id/coverContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/textViewSubTitle"
        android:layout_above="@+id/horizontalBarTopOfSleep"
        >
        <ImageView
            android:id="@+id/folderImage"
            android:contentDescription="@string/book_cover"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />

        <com.driot.bookplayer.views.FrequencyVisualizerView
            android:id="@+id/frequencyVisualizerView"
            android:contentDescription="@string/frequency_visualizer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />
        </com.driot.bookplayer.views.ClickInterceptFrameLayout>

    <!-- TTS UI (hidden for audio files) -->
    <LinearLayout
        android:id="@+id/ttsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/textViewSubTitle"
        android:layout_above="@+id/horizontalBarTopOfSleep"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ttsTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerTtsVoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnToggleTtsView"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/toggle_text_image"
                android:src="@android:drawable/ic_menu_gallery" />
        </LinearLayout>


        <TextView
            android:id="@+id/tvTtsText"
            style="@style/textColor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:textIsSelectable="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="16sp" />
    </LinearLayout>




    <!-- Progress bar overlay; shown while login is in progress -->
    <include layout="@layout/include_progress_overlay"
        android:visibility="gone"/>
    <include layout="@layout/include_message_overlay"
        android:visibility="gone"/>



</RelativeLayout>
</LinearLayout>