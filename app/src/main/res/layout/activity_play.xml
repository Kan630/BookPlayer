<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context=".activities.MainActivity">

    <!-- Progress bar overlay; shown while login is in progress -->
    <include layout="@layout/include_progress_overlay"/>
    <include layout="@layout/include_message_overlay"/>

    <TextView
        android:id="@+id/textviewTitle"
        android:text="@string/PlayerActivity_Title"
        style="@style/myStyleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="35sp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true" />

    <TextView
        android:id="@+id/textViewSubTitle"
        android:text="subTitle"
        style="@style/PlayActivity_TrackName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textviewTitle"
        android:layout_centerHorizontal="true"
        />

    <com.driot.bookplayer.utils.FrequencyVisualizerView
        android:id="@+id/frequencyVisualizerView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_centerInParent="true"/>

    <LinearLayout android:id="@+id/llCommandButtons"
        android:layout_height="wrap_content"
        android:layout_width="fill_parent"
        android:layout_alignParentBottom="true"
        >
    <Button
        android:id="@+id/buttonRewind"
        android:text="@string/rewind"
        style="@style/PlayActivityActionButtons"
        />
    <Button
        android:id="@+id/buttonPlay"
        android:text="@string/play"
        style="@style/PlayActivityActionButtons"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        />
    <Button
        android:id="@+id/buttonForward"
        android:text="@string/forward"
        style="@style/PlayActivityActionButtons"
        />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/llCommandButtons"
        android:layout_marginBottom="5dp"
        android:progressDrawable="@drawable/seek_bar"
        android:thumb="@drawable/seek_thumb"
        />

    <TextView
        android:id="@+id/textViewSeekBar"
        android:text="Current position"
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/seekBar"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <TextView
        android:id="@+id/textViewTempsTotal"
        android:text="Temps total"
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:layout_marginStart="30dp"
        android:layout_above="@+id/seekBar"
        android:layout_alignParentEnd="true"
        />

    <TextView
        android:id="@+id/textViewNomFichier"
        android:text="Nom Fichier"
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:layout_above="@+id/textViewSeekBar"
        />

    <!-- PlayBack Speed -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:layout_above="@+id/textViewNomFichier"
        />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/bSpeedUp"
        android:layout_marginTop="10dp"
        android:background="@android:color/darker_gray" />

    <TextView
        android:id="@+id/textViewSpeedDesc"
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/textViewNomFichier"
        android:layout_marginEnd="20sp"
        android:layout_marginBottom="15sp"
        android:layout_toStartOf="@id/bSpeedDown"
        android:text="@string/tvSpeed"
        android:textAppearance="?android:attr/textAppearanceMedium" />
    <Button
        android:id="@+id/bSpeedDown"
        android:text="-"
        android:textSize="30dp"
        android:paddingVertical="0dp"
        android:textAlignment="gravity"
        android:layout_width="@dimen/playactivity_Playback_Height"
        android:layout_height="@dimen/playactivity_Playback_Height"
        android:layout_toStartOf="@id/textViewSpeed"
        android:layout_above="@+id/textViewNomFichier"
        />

    <TextView
        android:id="@+id/textViewSpeed"
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/textViewNomFichier"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="5sp"
        android:paddingStart="10sp"
        android:paddingEnd="10sp"
        android:text="100%"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="@dimen/playactivity_PlaybackText_Height" />
    <Button
        android:id="@+id/bSpeedUp"
        android:text="+"
        android:textSize="24dp"
        android:layout_width="@dimen/playactivity_Playback_Height"
        android:layout_height="@dimen/playactivity_Playback_Height"
        android:layout_toEndOf="@id/textViewSpeed"
        android:layout_above="@+id/textViewNomFichier"
        />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/bSpeedUp"
        android:layout_marginTop="10dp"
        android:background="@android:color/darker_gray" />
    <TextView
        android:id="@+id/tv_ListeningTime"
        android:text="..."
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:layout_alignParentEnd="true"
        android:textStyle="italic"
        android:textSize="10sp"
        android:layout_marginEnd="20sp"
        android:layout_marginBottom="5sp"
        android:layout_above="@+id/tv_TimeLeft"
        />
    <TextView
        android:id="@+id/tv_TimeLeft"
        android:text="..."
        style="@style/textColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:layout_alignParentEnd="true"
        android:textStyle="italic"
        android:textSize="10sp"
        android:layout_marginEnd="20sp"
        android:layout_marginBottom="5sp"
        android:layout_above="@+id/bSpeedUp"
        />

</RelativeLayout>