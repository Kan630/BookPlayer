<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="@color/cardBackground"
    android:layout_marginBottom="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/recyclerview_between_cardView"
        android:layout_marginTop="@dimen/recyclerview_between_cardView"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/cardBackground"
        >
        <TextView
            android:id="@+id/tvBookName"
            android:text="Song 1.mp3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="0dp"
            android:paddingHorizontal="2dp"
            android:layout_marginTop="@dimen/recyclerview_elements_top"
            android:layout_marginLeft="@dimen/recyclerview_elements_sides"
            android:layout_marginRight="@dimen/recyclerview_elements_sides"
            android:background="?attr/colorSurface"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintBottom_toTopOf="@id/textViewFilePercent"
            />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.75" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:progress="20"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/recyclerview_elements_bottom"
            android:layout_marginLeft="@dimen/recyclerview_elements_sides"
            android:layout_marginRight="@dimen/recyclerview_elements_sides"
            android:progressDrawable="@drawable/progress_bar_theme"
            app:layout_constraintTop_toBottomOf="@id/tvBookName"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/guideline"/>

        <TextView
            android:id="@+id/textViewFilePercent"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/recyclerview_elements_bottom"
            android:gravity="center"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/tvBookName"
            app:layout_constraintRight_toRightOf="@id/guideline"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="20dp"
            android:text="...xx%..." />

        <TextView
            android:id="@+id/textViewDuration"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/recyclerview_elements_bottom"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="@dimen/recyclerview_elements_sides"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/tvBookName"
            app:layout_constraintLeft_toLeftOf="parent"
            android:text="..." />

        <TextView
            android:id="@+id/textViewFileLastAccess"
            android:text="..."
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/recyclerview_elements_bottom"
            android:layout_marginLeft="@dimen/recyclerview_elements_sides"
            android:layout_marginRight="@dimen/recyclerview_elements_sides"
            android:paddingTop="@dimen/recyclerview_padding_text_vertical"
            android:paddingBottom="@dimen/recyclerview_padding_text_vertical"
            android:paddingStart="@dimen/recyclerview_padding_text_horizontal"
            android:paddingEnd="@dimen/recyclerview_padding_text_horizontal"
            android:gravity="center_vertical"
            android:background="@color/cardBackgroundTextView"
            android:textColor="@color/cardBackgroundLightTextInTextView"
            app:layout_constraintTop_toBottomOf="@id/tvBookName"
            app:layout_constraintLeft_toLeftOf="@+id/guideline"
            app:layout_constraintRight_toRightOf="parent"
            />



    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
