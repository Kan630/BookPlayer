<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        >

        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            tools:context=".activities.MainActivity">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    layout="@layout/include_progressbar_overlay" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/TextHeaderOpen"
                        android:text="@string/DirectDownload_title"
                        android:layout_marginTop="10dp"
                        style="@style/GetResourceTextSectionTitle" />
                    <ImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_link_24px"
                        android:scaleType="centerInside"
                        android:background="@android:color/transparent"
                        app:tint="?attr/colorOnSurface"
                        android:layout_marginEnd="20dp" />
                </LinearLayout>


                <TextView
                    android:id="@+id/txtDirectDownload_desc"
                    android:text="@string/DirectDownload_desc"
                    style="@style/GetResourceTextTopOfButton" />

                <com.driot.bookplayer.views.EditText2linesWithPaste
                    android:id="@+id/etDirectDownload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:scrollOnFocus="true"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/bDirectDownload"
                        android:text="@string/DirectDownload_button"
                        style="@style/GetResourceButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        style="@style/GetResourceButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:visibility="invisible"
                        />
                </LinearLayout>


                <View style="@style/GetResourceHorizontalBar"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 2) DIM SCRIM — covers whole activity & consumes touches -->
    <!-- B3 = ~70% black; tune opacity -->
    <FrameLayout
        android:id="@+id/importDimScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/importDimMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/Import_in_progress"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:padding="24dp" />
    </FrameLayout>
    <View
        android:id="@+id/viewSecretEntry"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="Secret Launch Area"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>