<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        style="@style/LinearLayoutOptionsVertical"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Optional local title (hidden when embedded inline) -->
        <LinearLayout android:id="@+id/ll_title" style="@style/wideLinearLayout_Vertical">
            <View style="@style/myStyleViewSimpleHorizontalBar" />
            <TextView android:text="@string/Design" style="@style/OptionMasterTitle"/>
            <View style="@style/myStyleViewSimpleHorizontalBar" />
        </LinearLayout>

        <!-- Font family -->
        <LinearLayout style="@style/LinearLayoutOptionsVertical"
            android:layout_marginTop="0dp"
            >
            <TextView
                style="@style/OptionTitle"
                android:layout_marginTop="0dp"
                android:text="@string/option_text_appearance_title" />

            <LinearLayout
                android:id="@+id/ll_font_family"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">

                <TextView
                    style="@style/OptionCheckBoxText"
                    android:layout_width="80dp"
                    android:text="@string/Font" />

                <Spinner
                    android:id="@+id/sp_font_family"
                    android:spinnerMode="dropdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Spinner" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <!-- Color grid -->
        <LinearLayout
            style="@style/LinearLayoutOptionsVertical"
            android:layout_marginHorizontal="10sp">

            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_pick_theme_color_title" />

            <!-- 6 rows of 3 buttons (18 total), same ids you already use -->
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="20sp"
                android:gravity="center">
                <ImageButton android:id="@+id/btn_color_01" style="@style/OptionsColorButtons" />
                <ImageButton android:id="@+id/btn_color_02" style="@style/OptionsColorButtons"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
                <ImageButton android:id="@+id/btn_color_03" style="@style/OptionsColorButtons" />
            </LinearLayout>

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="10sp">
                <ImageButton android:id="@+id/btn_color_04" style="@style/OptionsColorButtons" />
                <ImageButton android:id="@+id/btn_color_05" style="@style/OptionsColorButtons"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
                <ImageButton android:id="@+id/btn_color_06" style="@style/OptionsColorButtons" />
            </LinearLayout>

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="10sp">
                <ImageButton android:id="@+id/btn_color_07" style="@style/OptionsColorButtons" />
                <ImageButton android:id="@+id/btn_color_08" style="@style/OptionsColorButtons"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
                <ImageButton android:id="@+id/btn_color_09" style="@style/OptionsColorButtons" />
            </LinearLayout>

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="10sp">
                <ImageButton android:id="@+id/btn_color_10" style="@style/OptionsColorButtons" />
                <ImageButton android:id="@+id/btn_color_11" style="@style/OptionsColorButtons"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
                <ImageButton android:id="@+id/btn_color_12" style="@style/OptionsColorButtons" />
            </LinearLayout>

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="10sp">
                <ImageButton android:id="@+id/btn_color_13" style="@style/OptionsColorButtons" />
                <ImageButton android:id="@+id/btn_color_14" style="@style/OptionsColorButtons"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
                <ImageButton android:id="@+id/btn_color_15" style="@style/OptionsColorButtons" />
            </LinearLayout>

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="10sp">
                <ImageButton android:id="@+id/btn_color_16" style="@style/OptionsColorButtons" />
                <ImageButton android:id="@+id/btn_color_17" style="@style/OptionsColorButtons"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
                <ImageButton android:id="@+id/btn_color_18" style="@style/OptionsColorButtons" />
            </LinearLayout>

            <!-- Color Viewer Section -->
            <LinearLayout
                android:id="@+id/ll_color_viewer_section"
                style="@style/LinearLayoutOptionsVertical"
                android:layout_marginTop="20sp"
                android:layout_marginBottom="10sp"
                android:background="?attr/colorOnSurface"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Theme Palette"
                    android:textColor="?attr/colorSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Primary -->
                    <TextView
                        android:id="@+id/box_primary"
                        style="@style/OptionsColorButtons"
                        android:text="Primary"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary" />

                    <!-- Secondary -->
                    <TextView
                        android:id="@+id/box_secondary"
                        style="@style/OptionsColorButtons"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="Secondary"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="?attr/colorSecondary"
                        android:textColor="?attr/colorOnSecondary" />

                    <!-- PrimaryVariant -->
                    <TextView
                        android:id="@+id/box_primary_v"
                        style="@style/OptionsColorButtons"
                        android:text="PrimaryV"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="?attr/colorPrimaryVariant"
                        android:textColor="?attr/colorOnPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10sp"
                    android:orientation="horizontal">

                    <!-- Surface -->
                    <TextView
                        android:id="@+id/box_surface"
                        style="@style/OptionsColorButtons"
                        android:text="Surface"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="?attr/colorSurface"
                        android:textColor="?attr/colorOnSurface" />

                    <!-- SurfaceVariant -->
                    <TextView
                        android:id="@+id/box_surface_v"
                        style="@style/OptionsColorButtons"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="SurfaceV"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="?attr/colorSurfaceVariant"
                        android:textColor="?attr/colorOnSurface" />

                    <!-- Outline -->
                    <TextView
                        android:id="@+id/box_outline"
                        style="@style/OptionsColorButtons"
                        android:text="Outline"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="?attr/colorOutline"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

            </LinearLayout>

            <View style="@style/myStyleViewSimpleHorizontalBar" />

            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_orientation_lock_app_global" />

            <LinearLayout
                android:id="@+id/ll_orientation_lock_app_global"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_marginStart="15dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                >
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_orientation_lock_app_global"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/lock_app_orientation"
                    />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/group_orientation_lock_app_global"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:padding="8dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mb_Orientation_AppGlobal_Landscape"
                    style="@style/MaterialButtonForToggleGroup"
                    android:text="@string/landscape"
                    app:cornerRadius="16dp"
                    app:checkedIcon="@drawable/ic_check_24px"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mb_Orientation_AppGlobal_Portrait"
                    style="@style/MaterialButtonForToggleGroup"
                    android:text="@string/portrait"
                    app:cornerRadius="16dp"
                    />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_orientation_lock_app_global_explain"
                android:layout_marginBottom="5dp"
                />

            <View style="@style/myStyleViewSimpleHorizontalBar" />

            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_display_bottom_nav_bar_title" />

            <LinearLayout
                android:id="@+id/ll_display_bottom_nav_bar"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_display_bottom_nav_bar"
                    style="@style/OptionCheckBox" />

                <TextView
                    style="@style/OptionCheckBoxText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/option_display_bottom_nav_bar_checkbox" />
            </LinearLayout>

            <TextView
                style="@style/OptionExplainText"
                android:layout_marginBottom="8dp"
                android:text="@string/option_display_bottom_nav_bar_explain" />

            <View style="@style/myStyleViewSimpleHorizontalBar" />


            <!-- Theme mode: override system checkbox + Light/Dark toggle -->
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_theme_mode_title" />

            <LinearLayout
                android:id="@+id/ll_theme_mode_force"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_night_mode_force"
                    style="@style/OptionCheckBox" />

                <TextView
                    style="@style/OptionCheckBoxText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/option_theme_mode_force_checkbox" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/group_night_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="50dp"
                android:padding="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_theme_light"
                    style="@style/MaterialButtonForToggleGroup"
                    android:text="@string/option_night_mode_light"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_theme_dark"
                    style="@style/MaterialButtonForToggleGroup"
                    android:text="@string/option_night_mode_dark"
                    app:cornerRadius="16dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/OptionExplainText"
                android:layout_marginBottom="8dp"
                android:text="@string/option_theme_mode_force_explain" />

        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />


    </LinearLayout>
</ScrollView>
