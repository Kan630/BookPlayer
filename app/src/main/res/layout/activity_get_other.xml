<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        >

        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            tools:context=".activities.MainActivity">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llsecretDev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    >

                    <TextView
                        android:id="@+id/txtAutoTest_title"
                        android:text="@string/AutoTest_title"
                        style="@style/GetResourceTextSectionTitle" />

                    <TextView
                        android:id="@+id/txtAutoTest_desc"
                        style="@style/GetResourceTextTopOfButton" />

                    <Button
                        android:id="@+id/bAutoTest_b1"
                        android:text="@string/AutoTest_b1_text"
                        style="@style/GetResourceButton"
                        android:layout_marginTop="@dimen/GetRessource320_vertical_margin_text2button" />

                    <Button
                        android:id="@+id/bAutoTest_b2"
                        android:text="@string/AutoTest_b2_text"
                        style="@style/GetResourceButton" />

                    <Button
                        android:id="@+id/bAutoTest_b3"
                        android:text="@string/AutoTest_b3_text"
                        style="@style/GetResourceButton" />
                    <Button
                        android:id="@+id/bAutoTest_b4"
                        android:text="@string/AutoTest_b4_text"
                        style="@style/GetResourceButton" />
                    <TextView
                        android:layout_height="30dp"
                        android:layout_width="match_parent"
                        android:textIsSelectable="true"
                        android:text="https://bookplayer.driot.com/autotest/file_01.zip"  />



                </LinearLayout>

                <include
                    layout="@layout/include_progressbar_overlay" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/TextHeaderOpen"
                        android:text="@string/TextHeaderOpen"
                        android:layout_marginTop="10dp"
                        style="@style/GetResourceTextSectionTitle" />
                    <ImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_memory_general_smartphone"
                        android:scaleType="centerInside"
                        android:background="@android:color/transparent"
                        app:tint="?attr/colorOnSurface"
                        android:layout_marginEnd="20dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/bOpenFile_desc"
                    style="@style/GetResourceTextTopOfButton"
                    android:layout_marginStart="20dp"
                    android:text="@string/bOpenFile_desc" />

                <Button
                    android:id="@+id/bOpenFile"
                    android:text="@string/bOpenFile"
                    style="@style/GetResourceButton"
                    android:backgroundTint="?attr/colorPrimaryVariant"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_marginTop="@dimen/GetRessource320_vertical_margin_text2button" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="30dp"
                    >

                    <TextView
                        android:id="@+id/bOpenZipFile_desc"
                        style="@style/GetResourceTextTopOfButton"
                        android:text="@string/bOpenZipFile_desc" />

                    <Button
                        android:id="@+id/bOpenZipFile"
                        android:text="@string/bOpenZipFile"
                        style="@style/GetResourceButton"
                        android:layout_marginTop="@dimen/GetRessource320_vertical_margin_text2button" />

                    <TextView
                        android:id="@+id/bOpenM4bFile_desc"
                        style="@style/GetResourceTextTopOfButton"
                        android:text="@string/bOpenM4bFile_desc" />

                    <Button
                        android:id="@+id/bOpenM4bFile"
                        android:text="@string/bOpenM4bFile"
                        style="@style/GetResourceButton"
                        android:layout_marginTop="@dimen/GetRessource320_vertical_margin_text2button" />

                </LinearLayout>

                <TextView
                    android:id="@+id/bOpenFolder_desc"
                    style="@style/GetResourceTextTopOfButton"
                    android:layout_marginStart="20dp"
                    android:text="@string/bOpenFolder_desc" />

                <Button
                    android:id="@+id/bOpenFolder"
                    android:text="@string/bOpenFolder"
                    style="@style/GetResourceButton"
                    android:backgroundTint="?attr/colorPrimaryVariant"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_marginTop="@dimen/GetRessource320_vertical_margin_text2button" />

                <View style="@style/GetResourceHorizontalBar"/>

                <TextView
                    android:id="@+id/bMassImport_desc"
                    style="@style/GetResourceTextTopOfButton"
                    android:text="@string/bOpenMassImport_desc" />

                <TextView
                    style="@style/warningTextView"
                    android:layout_marginStart="30dp"
                    android:text="@string/beta_test" />
                <TextView
                    style="@style/warningTextView"
                    android:layout_marginStart="30dp"
                    android:text="@string/bOpenMassImport_warning" />

                <Button
                    android:id="@+id/bMassImport"
                    android:text="@string/bMassImport"
                    style="@style/GetResourceButton"
                    android:layout_marginTop="@dimen/GetRessource320_vertical_margin_text2button" />

                <View style="@style/GetResourceHorizontalBar"/>


                <TextView
                    android:id="@+id/txtDirectDownload_title"
                    android:text="@string/DirectDownload_title"
                    style="@style/GetResourceTextSectionTitle" />


                <TextView
                    android:id="@+id/txtDirectDownload_desc"
                    android:text="@string/DirectDownload_desc"
                    style="@style/GetResourceTextTopOfButton" />

                <com.driot.bookplayer.views.EditText2linesWithPaste
                    android:id="@+id/etDirectDownload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:scrollOnFocus="true"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/bDirectDownload"
                        android:text="@string/DirectDownload_button"
                        style="@style/GetResourceButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        style="@style/GetResourceButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:visibility="invisible"
                        />
                </LinearLayout>


                <View style="@style/GetResourceHorizontalBar"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 2) DIM SCRIM — covers whole activity & consumes touches -->
    <!-- B3 = ~70% black; tune opacity -->
    <View
        android:id="@+id/importDimScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- 3) ONGOING BANNER HOST — floats above scrim/content -->
    <FrameLayout
        android:id="@+id/topOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="8dp"
        android:elevation="12dp" />

    <!-- 4) Secret tappable area (still on top, below banner if overlapping) -->
    <View
        android:id="@+id/viewSecretEntry"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="Secret Launch Area"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>