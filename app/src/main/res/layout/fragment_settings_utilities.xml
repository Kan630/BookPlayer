<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root_container"
        style="@style/LinearLayoutOptionsVertical"
        android:padding="8dp">

        <!-- Optional local title (hidden when embedded inline) -->
        <LinearLayout android:id="@+id/ll_title" style="@style/wideLinearLayout_Vertical">
            <View style="@style/myStyleViewSimpleHorizontalBar" />
            <TextView android:text="@string/Utilities" style="@style/OptionMasterTitle"/>
            <View style="@style/myStyleViewSimpleHorizontalBar" />
        </LinearLayout>

        <!-- Mail method -->
        <LinearLayout
            android:id="@+id/ll_MailMethod_vert"
            style="@style/LinearLayoutOptionsVertical">

            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_mail_method" />

            <LinearLayout
                android:id="@+id/ll_mail_method_default"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_mail_method_default"
                    style="@style/OptionCheckBox" />

                <TextView
                    android:id="@+id/txt_mail_method_default"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_mail_method_default" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout
            style="@style/LinearLayoutOptionsVertical">

            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_reset_settings_values"
                android:layout_marginBottom="15dp"
                />

            <Button
                style="@style/GetResourceButton"
                android:id="@+id/btn_reset_settings_values_to_default"
                android:text="@string/reset_to_default"
                />
            <Button
                style="@style/GetResourceButton"
                android:id="@+id/btn_reset_settings_values_for_power_user"
                android:text="@string/reset_for_power_user"
                />
            <TextView
                style="@style/OptionSubTitle"
                android:text="@string/option_reset_for_power_user_explain_text"
                android:textStyle="italic"
                />
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout
            style="@style/LinearLayoutOptionsVertical">

            <TextView
                style="@style/OptionTitle"
                android:text="@string/reset_app"
                android:layout_marginBottom="15dp"
                />

            <Button
                style="@style/GetResourceButton"
                android:id="@+id/btn_reset_app"
                android:text="@string/cancel_ongoing_operation"
                />
            <TextView
                style="@style/OptionSubTitle"
                android:text="@string/option_reset_app_explain_text"
                android:textStyle="italic"
                />
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout
            style="@style/LinearLayoutOptionsVertical">

            <TextView
                style="@style/OptionTitle"
                android:text="Backup / Restore"
                android:layout_marginBottom="15dp" />

            <Button
                style="@style/GetResourceButton"
                android:id="@+id/btn_import_export"
                android:text="Export &amp; Restore Library" />
                
            <TextView
                style="@style/OptionSubTitle"
                android:text="Save and restore your library and preferences to/from a file."
                android:textStyle="italic" />
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />
    </LinearLayout>
</ScrollView>
