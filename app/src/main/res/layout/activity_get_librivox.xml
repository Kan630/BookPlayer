<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <View
            android:id="@+id/focusGuard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            tools:context=".activities.MainActivity">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_librivox_24"
                        android:scaleType="centerInside"
                        android:background="@android:color/transparent"
                        app:tint="?attr/colorOnSurface"
                        android:layout_marginStart="10dp"
                        />
                    <TextView
                        android:id="@+id/txtLibrivoxSearch_title"
                        android:text="@string/AudioBooks"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="20dp"
                        style="@style/GetResourceTextSectionTitle"
                        android:layout_marginStart="0dp"
                        />

                    <!-- Spacer pushes the next item to the right -->
                    <View style="@style/spacer"/>

                    <ImageButton
                        android:id="@+id/ibSettings"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/settings"
                        android:src="@drawable/ic_settings_24"
                        android:background="@android:color/transparent"
                        />

                </LinearLayout>

                <View style="@style/GetResourceHorizontalBar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <Button
                        android:id="@+id/bFavorite"
                        android:text="@string/Favorites"
                        style="@style/GetResourceButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="0dp"

                        />

                    <ImageButton
                        android:id="@+id/ibFavorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/favorites"
                        android:src="@drawable/ic_favorite"
                        android:background="@android:color/transparent"
                        app:tint="@android:color/holo_red_dark" />
                </LinearLayout>


                <View style="@style/GetResourceHorizontalBar"/>


                <TextView
                    android:id="@+id/txtLibrivoxSearch_desc"
                    android:layout_marginTop="20dp"
                    android:text="@string/LibrivoxSearch_desc"
                    style="@style/GetResourceTextTopOfButton" />

                <Spinner
                    android:id="@+id/spinnerLibrivox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    style="@style/GetResourceSpinner" />

                <View style="@style/GetResourceHorizontalBar"/>

                <TextView
                    android:text="@string/quick_lists"
                    style="@style/GetResourceTextTopOfButton" />
                <Button
                    android:id="@+id/bLibrivoxTrending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginHorizontal="6dp"
                    android:text="@string/most_downloaded"
                     />
                <Button
                    android:id="@+id/bLibrivoxLastAdded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginHorizontal="6dp"
                    android:text="@string/last_added"
                     />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:layout_marginHorizontal="6dp"
                    android:baselineAligned="false"
                    android:gravity="top"
                    >

                    <Button
                        android:id="@+id/bLibrivoxByGenre"
                        android:layout_width="match_parent"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="@string/by_genre_all_languages"
                        />

                    <Button
                        android:id="@+id/bByAuthor"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="@string/by_author"
                        android:visibility="gone"
                        />
                </LinearLayout>


                <View style="@style/GetResourceHorizontalBar" />

                <TextView
                    android:layout_marginTop="20dp"
                    android:text="@string/librivox_search_edittext_title"
                    style="@style/GetResourceTextTopOfButton" />

                <com.driot.bookplayer.views.EditText1lineWithSearch
                    android:id="@+id/etLibrivox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:scrollOnFocus="true"
                    android:layout_marginTop="20dp" />



            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
