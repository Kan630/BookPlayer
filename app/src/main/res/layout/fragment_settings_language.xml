<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root_container"
        style="@style/LinearLayoutOptionsVertical"
        android:padding="8dp">

        <LinearLayout android:id="@+id/ll_title" style="@style/wideLinearLayout_Vertical">
            <View style="@style/myStyleViewSimpleHorizontalBar" />
            <TextView android:text="@string/Language" style="@style/OptionMasterTitle"/>
            <View style="@style/myStyleViewSimpleHorizontalBar" />
        </LinearLayout>

        <!-- App language -->
        <LinearLayout
            style="@style/LinearLayoutOptionsVertical"
            android:layout_marginTop="0dp">

            <TextView
                style="@style/OptionTitle"
                android:text="@string/app_language" />

            <TextView
                style="@style/OptionSubTitle"
                android:text="@string/option_app_language_subtitle"
                android:textStyle="italic" />

            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">

                <TextView
                    style="@style/OptionSubTitle"
                    android:text="@string/app_language"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="0dp" />

                <Spinner
                    android:id="@+id/spinner_app_language"
                    style="@style/Spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
