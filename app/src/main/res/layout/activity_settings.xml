<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer">

    <!-- Top-level list of settings categories -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/settings_layout_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingTop="8dp"
            >

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/Language"
                    app:sectionIcon="@drawable/ic_language_24px"
                    />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_play_behaviour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/option_playing_behaviour_title"
                    app:sectionIcon="@drawable/ic_media_play_24"
                    />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_design"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/Design"
                    app:sectionIcon="@drawable/ic_palette_24px"
                    />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_storage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/storage_settings_title"
                    app:sectionIcon="@drawable/ic_memory_24" />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/Import"
                    app:sectionIcon="@drawable/ic_add_book_24" />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_massive_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/Mass_Import"
                    app:sectionIcon="@drawable/ic_data_table_24px" />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_librivox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/Repositories"
                    app:sectionIcon="@drawable/ic_librivox_24" />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_tts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/Text_To_Speech"
                    app:sectionIcon="@drawable/ic_tts_24" />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_radio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/Radio"
                    app:sectionIcon="@drawable/ic_radio_24px" />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_podcast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/Podcasts"
                    app:sectionIcon="@drawable/ic_podcast_24" />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_automotive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/Automotive"
                    app:sectionIcon="@drawable/ic_car_24" />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_network"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/network_preferences_title"
                    app:sectionIcon="@drawable/ic_cloud_24" />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_utilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sectionTitle="@string/Utilities"
                    app:sectionIcon="@drawable/ic_service_toolbox_24" />

                <com.driot.bookplayer.views.SettingsSectionView
                    android:id="@+id/section_admin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:sectionTitle="@string/admin"
                    app:sectionIcon="@drawable/ic_service_toolbox_24" />

        </LinearLayout>

    </ScrollView>

    <!-- Detail pane: opened category, shown full-screen over the list -->
    <LinearLayout
        android:id="@+id/detailContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/detailHeader"
            style="@style/SettingsDetailHeader">

            <ImageButton
                android:id="@+id/btnDetailBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back_24"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="@string/back" />

            <TextView
                android:id="@+id/tvDetailTitle"
                style="@style/simpleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textStyle="bold"
                android:textSize="20sp"
                android:ellipsize="end"
                android:maxLines="1" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/detailFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>
