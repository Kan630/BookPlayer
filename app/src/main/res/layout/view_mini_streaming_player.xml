<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayer"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?colorSecondary"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:gravity="center_vertical"
    android:elevation="8dp"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    >

    <!-- Controls row -->
    <LinearLayout
        android:id="@+id/miniControlsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnMiniBack"
            android:src="@drawable/ic_media_fast_rewind_24"
            style="@style/miniPlayerButton" />

        <ProgressBar
            android:id="@+id/progressMini"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/colorOnSecondary"
            android:visibility="gone"/>

        <ImageButton
            android:id="@+id/btnMiniPlayPause"
            android:src="@drawable/ic_media_play_24"
            style="@style/miniPlayerButton"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <ImageButton
            android:id="@+id/btnMiniForward"
            android:src="@drawable/ic_media_fast_forward_24"
            style="@style/miniPlayerButton" />

        <SeekBar
            android:id="@+id/seekMini"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="?attr/colorPrimaryVariant"
            android:thumbTint="?colorSecondaryVariant"
            android:max="1000"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvMiniTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?colorOnSecondary"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>

    <!-- Tiny “Streaming” badge -->
    <TextView
        android:id="@+id/labelStreaming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/streaming"
        android:textStyle="italic"
        android:textSize="10sp"
        android:textColor="?attr/colorOnSecondary"
        android:alpha="0.8"
        android:paddingTop="0dp"
        android:paddingEnd="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
