<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer">

    <FrameLayout
        android:id="@+id/topOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/no_result"
        android:layout_marginTop="300dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- Drag-to-delete zone (initially hidden) -->
    <FrameLayout
        android:id="@+id/dragDeleteZone"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_dropzone"
        android:visibility="gone"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivTrash"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete_24"
                android:tint="?attr/colorOnPrimary" />

            <TextView
                android:id="@+id/tvTrash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/remove_from_favorites"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary" />
        </LinearLayout>
    </FrameLayout>


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/miniNowPlaying"
        android:name="com.driot.bookplayer.player.MiniPlayHostFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
