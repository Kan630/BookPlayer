<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer">

    <include
        android:id="@+id/includeNetworkStatus"
        layout="@layout/view_network_status_row" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/groupFavoriteVsHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingHorizontal="8dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            style="@style/MaterialButtonForToggleGroup"
            android:id="@+id/btnRadioFavorites"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:text="@string/Favorites" />

        <com.google.android.material.button.MaterialButton
            style="@style/MaterialButtonForToggleGroup"
            android:id="@+id/btnRadioHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:text="@string/History" />
    </com.google.android.material.button.MaterialButtonToggleGroup>


    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminate="true" />
    <TextView
        android:id="@+id/progressText"
        style="@style/simpleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/no_result"
        android:layout_marginTop="300dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- Drag-to-delete zone (initially hidden) -->
    <FrameLayout
        android:id="@+id/dragDeleteZone"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_dropzone"
        android:visibility="gone"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivTrash"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete_24"
                app:tint="?attr/colorOnPrimary" />

            <TextView
                android:id="@+id/tvTrash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/remove_from_favorites"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimary" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
