<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title row: title on left, settings gear on right (same line as Radio/Other activities) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="16dp">
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/massiveimport_title"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textStyle="bold" />
        <View style="@style/spacer" />
        <ImageButton
            android:id="@+id/ibSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings_24"
            android:background="@android:color/transparent"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- Scanning Progress Area -->
    <LinearLayout
        android:id="@+id/llScanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:id="@+id/massImportprogressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:max="100"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvMassImportProgressText"
            style="@style/simpleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading_step_1"
            android:textColor="@color/yellow"
            android:gravity="center"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>

    <!-- Storage Section (below scanning, above list; shown immediately from cache) -->
    <LinearLayout
        android:id="@+id/llStorageSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="18dp"
        android:visibility="visible"
        tools:visibility="visible"
        android:background="?attr/colorSurfaceVariant"
        >

        <!-- Internal (device) storage bar: label "Storage" when alone, "Device storage" when SD exists -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.driot.bookplayer.widgets.StorageBarView
                android:id="@+id/storageBarInternal"
                android:layout_width="match_parent"
                android:layout_height="24dp" />
            <TextView
                android:id="@+id/tvStorageLabelInternal"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:paddingEnd="8dp"
                android:paddingStart="8dp"
                android:text="@string/Storage"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1" />
        </FrameLayout>

        <!-- SD card storage bar (visible when SD card exists); label "SD card storage" -->
        <LinearLayout
            android:id="@+id/llSdCardStorage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.driot.bookplayer.widgets.StorageBarView
                    android:id="@+id/storageBarSdCard"
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
                <TextView
                    android:id="@+id/tvStorageLabelSdCard"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center_vertical"
                    android:paddingEnd="8dp"
                    android:paddingStart="8dp"
                    android:text="@string/storage_sd_card"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="1" />
            </FrameLayout>
        </LinearLayout>

        <!-- Legend -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:layout_marginTop="4dp"
            >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="16dp">
                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@color/gray_500"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:id="@+id/tvLegendUsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/others"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="16dp">
                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@color/pastel_blue_500"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:id="@+id/tvLegendBooks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/copied"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="16dp">
                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@color/green_500"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:id="@+id/tvLegendLinkedAudios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/linked"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@color/yellow_500"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:id="@+id/tvLegendNewBooks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/storage_legend_new_books"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    <!-- Selected-for-import summary (updated when user checks/unchecks) -->
    <TextView
        android:id="@+id/tvSelectedSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        tools:text="3 book candidates selected for import (125 MB)" />

    <!-- List Area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCandidates"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:listitem="@layout/item_candidate" />

    <!-- Buttons -->
    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Found 0 items"
            android:layout_gravity="center_vertical" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel"
            android:layout_marginEnd="16dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnConfirmImport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Import" />
    </LinearLayout>
</LinearLayout>
