<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/ll_Tts"
        style="@style/LinearLayoutOptionsVertical"
        android:padding="8dp"
        android:layout_marginTop="0dp">

        <LinearLayout android:id="@+id/ll_title" style="@style/wideLinearLayout_Vertical">
            <View style="@style/myStyleViewSimpleHorizontalBar" />
            <TextView android:text="@string/Text_To_Speech" style="@style/OptionMasterTitle"/>
            <View style="@style/myStyleViewSimpleHorizontalBar" />
        </LinearLayout>

        <!-- TTS Engine -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
        <LinearLayout style="@style/SettingsGroupCardContent">
            <TextView
                android:id="@+id/tv_spinner_tts_engine"
                style="@style/SettingsGroupTitle"
                android:text="@string/TTS_Engine" />
            <Spinner
                android:id="@+id/spinner_tts_engine"
                style="@style/Spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="10dp"
                />
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Playback -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
        <LinearLayout style="@style/SettingsGroupCardContent">
            <TextView
                style="@style/SettingsGroupTitle"
                android:text="@string/Playback" />

            <!-- Snap to sentence start on resume -->
            <LinearLayout
                android:id="@+id/ll_tts_snap_to_sentence"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_marginTop="0dp">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_tts_snap_to_sentence"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_tts_snap_to_sentence" />
            </LinearLayout>
            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_tts_snap_to_sentence_explain"
                />

            <LinearLayout
                android:id="@+id/ll_tts_use_theme_color_for_cursor"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_marginTop="16dp">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_tts_use_theme_color_for_cursor"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_tts_use_theme_color_for_cursor" />
            </LinearLayout>
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Full Screen -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
        <LinearLayout style="@style/SettingsGroupCardContent">
            <LinearLayout
                style="@style/wideLinearLayout_Horizontal">
                <TextView
                    style="@style/SettingsGroupTitle"
                    android:layout_marginBottom="0dp"
                    android:text="@string/Full_Screen"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/ic_fullscreen_24px"/>
            </LinearLayout>

            <!-- Display playback controls in full screen -->
            <LinearLayout
                android:id="@+id/ll_tts_fullscreen_controls"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_marginTop="10dp">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_tts_fullscreen_controls"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_tts_fullscreen_controls" />
            </LinearLayout>

            <TextView
                style="@style/OptionCheckBoxText"
                android:layout_marginTop="16dp"
                android:text="@string/option_tts_fullscreen_text_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="40dp"
                android:paddingEnd="16dp">
                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_tts_fullscreen_text_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="5.0"
                    android:valueTo="40.0"
                    android:stepSize="1.0" />
                <TextView
                    android:id="@+id/tv_tts_fullscreen_text_size_value"
                    style="@style/OptionMiniText"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="20" />
            </LinearLayout>
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Import -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
        <LinearLayout style="@style/SettingsGroupCardContent">
            <TextView
                style="@style/SettingsGroupTitle"
                android:text="@string/Import" />

            <TextView
                style="@style/SettingsGroupSubheading"
                android:layout_marginTop="0dp"
                android:text="@string/option_tts_language_text" />
            <Spinner
                android:id="@+id/spinner_voice_item"
                style="@style/Spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp" />

            <!-- Guess book language and preselect a matching voice on the import screen -->
            <LinearLayout
                android:id="@+id/ll_guess_book_language"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_marginTop="0dp">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_guess_book_language"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_guess_book_language" />
            </LinearLayout>
            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_guess_book_language_explain"
                />

            <TextView
                style="@style/SettingsGroupSubheading"
                android:text="@string/option_epub_split_mode_text"
                />

            <Spinner
                android:id="@+id/spinner_epub_split_mode"
                style="@style/Spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="0dp" />

            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_epub_split_mode_explain_text"
                />

            <!-- Split DOCX into chapters -->
            <LinearLayout
                android:id="@+id/ll_docx_split_into_chapters"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_marginTop="16dp">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_docx_split_into_chapters"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_docx_split_into_chapters" />
            </LinearLayout>

            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_docx_split_into_chapters_explain"
                />

            <!-- Remove reference markers (footnotes) in ebooks -->
            <LinearLayout
                android:id="@+id/ll_ebook_remove_references"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_marginTop="16dp"
                >
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_ebook_remove_references"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_ebook_remove_references" />
            </LinearLayout>

            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_ebook_remove_references_explain"
                />
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Technical -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
        <LinearLayout style="@style/SettingsGroupCardContent">
            <TextView
                style="@style/SettingsGroupTitle"
                android:text="@string/Technical" />

            <!-- Display loading overlay -->
            <LinearLayout
                android:id="@+id/ll_tts_show_loading_overlay"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_marginTop="0dp">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_tts_show_loading_overlay"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_tts_show_loading_overlay" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_tts_overlay_timeout"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_width="match_parent"
                android:layout_marginStart="60dp"
                android:layout_marginTop="0dp"
                android:gravity="center"
                >
                <TextView
                    style="@style/simpleTextWrap"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:text="@string/option_tts_overlay_timeout_text"
                    android:textSize="24sp"
                     />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.BookPlayer.TextInputLayout.Compact"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/Widget.BookPlayer.TextInputEditText.Compact"
                        android:id="@+id/et_tts_overlay_timeout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textAlignment="textEnd"
                        android:textSize="24sp"
                        />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/simpleTextWrap"
                    android:layout_width="0dp"
                    android:layout_weight="3"
                    android:text="@string/sec"
                    android:textSize="24sp"
                    />
            </LinearLayout>
            <TextView android:text="Min = 5" style="@style/OptionMiniText" android:layout_marginStart="60dp"/>
            <TextView android:text="Max = 20" style="@style/OptionMiniText" android:layout_marginStart="60dp"/>
            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_tts_overlay_timeout_explain"
                />

            <!-- Engine: chunk size -->
            <TextView
                style="@style/SettingsGroupSubheading"
                android:text="@string/Engine_buffer"
                />

            <LinearLayout
                android:id="@+id/ll_tts_chunk_size"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_width="match_parent"
                android:gravity="center">

                <TextView
                    style="@style/simpleTextWrap"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/option_tts_chunk_size_text"
                    android:textSize="24sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.BookPlayer.TextInputLayout.Compact"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/Widget.BookPlayer.TextInputEditText.Compact"
                        android:id="@+id/et_tts_chunk_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textAlignment="textEnd"
                        android:textSize="24sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView android:text="Min = 1200" style="@style/OptionMiniText" />
            <TextView android:id="@+id/tv_tts_chunk_size_max" android:text="Max = 7000" style="@style/OptionMiniText" />
            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_tts_chunk_size_explain_text"
                />

            <!-- Highlight delay -->
            <TextView
                style="@style/SettingsGroupSubheading"
                android:text="@string/option_tts_highlight_delay_title"
                />

            <LinearLayout
                android:id="@+id/ll_tts_highlight_delay"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_width="match_parent"
                android:gravity="center">

                <TextView
                    style="@style/simpleTextWrap"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:text="@string/option_tts_highlight_delay_text"
                    android:textSize="24sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.BookPlayer.TextInputLayout.Compact"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/Widget.BookPlayer.TextInputEditText.Compact"
                        android:id="@+id/et_tts_highlight_delay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textAlignment="textEnd"
                        android:textSize="24sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/simpleTextWrap"
                    android:layout_width="0dp"
                    android:layout_weight="3"
                    android:text="@string/ms."
                    android:textSize="24sp" />
            </LinearLayout>

            <TextView android:text="Min = 0" style="@style/OptionMiniText" />
            <TextView android:text="Max = 400" style="@style/OptionMiniText" />
            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_tts_highlight_delay_explain_text"
                />
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
