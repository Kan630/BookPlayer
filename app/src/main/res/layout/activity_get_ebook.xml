<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <View
            android:id="@+id/focusGuard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            tools:context=".activities.MainActivity">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_tts_24"
                        android:scaleType="centerInside"
                        android:background="@android:color/transparent"
                        app:tint="?attr/colorOnSurface"
                        android:layout_marginStart="10dp"
                        />
                    <TextView
                        android:id="@+id/txtLibrivoxSearch_title"
                        android:text="@string/Ebooks"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="20dp"
                        style="@style/GetResourceTextSectionTitle"
                        android:layout_marginStart="0dp"
                        />

                    <!-- Spacer pushes the next item to the right -->
                    <View style="@style/spacer"/>

                    <ImageButton
                        android:id="@+id/ibSettings"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/settings"
                        android:src="@drawable/ic_settings_24"
                        android:background="@android:color/transparent"
                        />

                </LinearLayout>

                <View style="@style/GetResourceHorizontalBar" />

                <TextView
                    style="@style/GetResourceTextTopOfButton"
                    android:textColor="@color/orange_700"
                    android:text="@string/beta_test" />

                <TextView
                    android:layout_marginTop="20dp"
                    android:text="@string/GutendexSearch_desc"
                    style="@style/GetResourceTextTopOfButton"
                    />

                <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <Spinner
                        android:id="@+id/spinnerEbookLang"
                        style="@style/GetResourceSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/GetResourceHorizontalBar"/>

                    <TextView
                        android:text="@string/quick_lists"
                        style="@style/GetResourceTextTopOfButton" />
                    <Button
                        android:id="@+id/bMostDownloaded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/most_downloaded"
                        style="@style/GetResourceButton" />
                    <Button
                        android:id="@+id/bBookshelves"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/Bookshelves"
                        style="@style/GetResourceButton" />

                    <View style="@style/GetResourceHorizontalBar"/>

                    <TextView
                        android:layout_marginTop="20dp"
                        android:text="@string/librivox_search_edittext_title"
                        style="@style/GetResourceTextTopOfButton" />

                    <com.driot.bookplayer.views.EditText1lineWithSearch
                        android:id="@+id/etEbook"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:scrollOnFocus="true"
                        android:layout_marginTop="12dp" />



                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
