<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <View
            android:id="@+id/focusGuard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            tools:context=".activities.MainActivity">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_tts_24"
                        android:scaleType="centerInside"
                        android:background="@android:color/transparent"
                        app:tint="?attr/colorOnSurface"
                        android:layout_marginStart="10dp"
                        />
                    <TextView
                        android:id="@+id/txtLibrivoxSearch_title"
                        android:text="@string/Ebooks"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="20dp"
                        style="@style/GetResourceTextSectionTitle"
                        android:layout_marginStart="0dp"
                        />

                    <!-- Spacer pushes the next item to the right -->
                    <View style="@style/spacer"/>

                    <ImageButton
                        android:id="@+id/ibSettings"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/settings"
                        android:src="@drawable/ic_settings_24"
                        android:background="@android:color/transparent"
                        />

                </LinearLayout>

                <!-- Language -->
                <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
                <LinearLayout style="@style/SettingsGroupCardContent">

                    <TextView
                        style="@style/SettingsGroupTitle"
                        android:text="@string/Language" />

                    <Spinner
                        android:id="@+id/spinnerEbookLang"
                        style="@style/GetResourceSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Quick lists -->
                <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
                <LinearLayout style="@style/SettingsGroupCardContent">

                    <TextView
                        style="@style/SettingsGroupTitle"
                        android:text="@string/quick_lists" />

                    <Button
                        android:id="@+id/bEbookMostDownloaded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/most_downloaded"
                        style="@style/Widget.BookPlayer.Button.Secondary" />
                    <Button
                        android:id="@+id/bEbookBookshelves"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/Bookshelves"
                        style="@style/Widget.BookPlayer.Button.Secondary" />
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Search -->
                <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
                <LinearLayout style="@style/SettingsGroupCardContent">

                    <TextView
                        style="@style/SettingsGroupTitle"
                        android:text="@string/librivox_search_edittext_title" />

                    <TextView
                        style="@style/OptionExplainText"
                        android:text="@string/search_tip_single_word" />

                    <com.driot.bookplayer.views.EditText1lineWithSearch
                        android:id="@+id/etEbook"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:scrollOnFocus="true"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_marginTop="10dp"
                    android:text="@string/GutendexSearch_desc"
                    style="@style/OptionExplainText" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
