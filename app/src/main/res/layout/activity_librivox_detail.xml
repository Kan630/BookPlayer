<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    style="@style/MainContainer"
    >

    <LinearLayout
        android:padding="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        >

        <TextView
            android:id="@+id/textDetailTitle"
            style="@style/myStyleTitle"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            />
        <ImageView
            android:id="@+id/imageDetailCover"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/book_cover"
            />

        <TextView
            android:id="@+id/tvDownloadLink"
            style="@style/myStyleInfo"
            android:layout_width="wrap_content"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Checking download Link..."
            android:textSize="14sp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            />
        <Button
            android:id="@+id/bGet"
            android:text="@string/Librivox_bGetAudioBook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            />



        <TextView
            android:id="@+id/textDetailInfo"
            style="@style/myStyleInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Loading details..."
            android:textSize="14sp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            />

        <TextView
            android:id="@+id/textDetailSynopsis"
            style="@style/myStyleInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:lineSpacingExtra="4dp"
            android:text="(Loading synopsis...)" />

        <TextView
            android:id="@+id/tvLinkArchive"
            style="@style/myStyleInfo"
            android:autoLink="web"
            android:linksClickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="web link archive.org..."
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            />

        <TextView
            android:id="@+id/tvLinkLibrivox"
            style="@style/myStyleInfo"
            android:autoLink="web"
            android:linksClickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="web link librivox.org..."
            android:textSize="14sp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            />

        <TextView
            android:id="@+id/tvOtherInfo"
            style="@style/myStyleInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Miscallenous..."
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            />
        <TextView
            android:id="@+id/textDetailIdentifier"
            style="@style/myStyleInfo"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"
            android:textColor="#888888"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            text="info..."
            />

    </LinearLayout>
</ScrollView>