<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        style="@style/wideLinearLayout_Vertical"
        android:padding="16dp"
        >

        <ProgressBar
            android:id="@+id/loadingProgressBarStep1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:max="100"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvProgressStatusStep1"
            style="@style/simpleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textColor="@color/yellow"
            android:gravity="center"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/waitTextView"
            style="@style/OptionAfterPickedInfo"
            android:textColor="@color/green_500"
            android:text="@string/init_please_wait"
            android:minLines="3"
            />
        <TextView
            android:id="@+id/errorTextView"
            style="@style/OptionAfterPickedInfo"
            android:textColor="@color/red_500"
            android:text="@string/error_generic"
            android:layout_marginVertical="20dp"
            />
        <TextView
            android:id="@+id/warningTextView"
            style="@style/OptionAfterPickedInfo"
            android:textColor="@color/orange"
            android:text="@string/Warning"
            android:layout_marginBottom="12dp"
            />

        <!-- Source group -->
        <LinearLayout
            android:id="@+id/llSourceContainer"
            style="@style/wideLinearLayout_Vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip"
            android:padding="8dp">

            <TextView
                android:text="@string/import_source_title"
                style="@style/OptionSubTitle"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSourceFileName"
                style="@style/simpleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="..."
                android:textStyle="bold"
                android:textSize="16sp"
                android:ellipsize="middle"
                android:maxLines="2"
                />

            <TextView
                android:id="@+id/tvInfoLine1"
                style="@style/OptionAfterPickedInfo"
                android:textStyle="normal"
                android:text="[sourceLocation]"
                android:layout_marginTop="4dp"
                />
            <TextView
                android:id="@+id/tvMimeExtension"
                style="@style/OptionAfterPickedInfo"
                android:textStyle="normal"
                android:text="[mime] - .toto"
                />
        </LinearLayout>

        <!-- Destination group -->
        <LinearLayout
            android:id="@+id/llAppendAndDest"
            style="@style/wideLinearLayout_Vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip"
            android:padding="8dp">

            <TextView
                android:text="@string/import_destination_title"
                style="@style/OptionSubTitle"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="4dp"/>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/groupNewVsExisting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/MaterialButtonForToggleGroup"
                    android:id="@+id/btnNewBook"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/import_new_book_label" />

                <com.google.android.material.button.MaterialButton
                    style="@style/MaterialButtonForToggleGroup"
                    android:id="@+id/btnAddToExisting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/import_existing_book_label" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- New-book identity: cover (tap to cycle candidates) + editable title.
                 Shown only while "New Book" is selected above. -->
            <LinearLayout
                android:id="@+id/llNewBookIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvCover"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    >

                    <ImageView
                        android:id="@+id/ivCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/cover_preview"
                        android:src="@drawable/no_image_icon"
                        />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etBookTitle"
                        style="@style/simpleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/import_book_title_hint"
                        android:inputType="text"
                        android:maxLines="2"
                        android:textStyle="bold"
                        />

                    <TextView
                        android:id="@+id/tvCoverHint"
                        style="@style/OptionAfterPickedInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="italic"
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="2dp"
                        />

                </LinearLayout>

            </LinearLayout>

            <!-- Existing-folder picker: which book to append to. Shown only while
                 "Add to Existing Book" is selected above. -->
            <LinearLayout
                android:id="@+id/llExistingFolderPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:visibility="gone"
                >
                <Spinner
                    android:id="@+id/spinner_destination_folder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    />
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            >

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Cancel" />

            <View android:layout_width="16dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Confirm" />
        </LinearLayout>

        <!-- Options group -->
        <LinearLayout
            android:id="@+id/llOptionsContainer"
            style="@style/wideLinearLayout_Vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip"
            android:padding="8dp">

            <TextView
                android:text="@string/import_options_title"
                style="@style/OptionSubTitle"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:id="@+id/llOptions"
                style="@style/LinearLayoutOptionsVertical"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp">

                <!-- Split M4B option -->
                <LinearLayout
                    style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                    android:layout_marginTop="6dp"
                    android:id="@+id/ll_split_m4b">
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbSplitM4B"
                        style="@style/OptionCheckBox" />
                    <TextView
                        android:id="@+id/tx_split_m4b"
                        style="@style/OptionCheckBoxText"
                        android:text="@string/option_on_load_split_m4b" />
                </LinearLayout>

                <!-- Copy internally -->
                <LinearLayout
                    style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                    android:layout_marginTop="6dp"
                    android:id="@+id/ll_copy_internal">
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbCopyInternal"
                        style="@style/OptionCheckBox" />
                    <TextView
                        android:id="@+id/tx_copy_internal"
                        style="@style/OptionCheckBoxText"
                        android:text="@string/option_on_load_copy_internal" />
                </LinearLayout>

                <!-- Save on SD card -->
                <LinearLayout
                    style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                    android:layout_marginTop="6dp"
                    android:id="@+id/ll_use_sdcard">
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbUseSdCard"
                        style="@style/OptionCheckBox" />
                    <TextView
                        android:id="@+id/tx_use_sdcard"
                        style="@style/OptionCheckBoxText"
                        android:text="@string/option_on_load_use_SD_card" />
                </LinearLayout>

                <!-- Delete source file -->
                <LinearLayout
                    style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                    android:layout_marginTop="6dp"
                    android:id="@+id/ll_delete_source">
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbDeleteSource"
                        style="@style/OptionCheckBox" />
                    <TextView
                        android:id="@+id/tx_delete_source"
                        style="@style/OptionCheckBoxText"
                        android:text="@string/option_on_load_delete_source" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>


        <ProgressBar
            android:id="@+id/loadingProgressBarStep2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:max="100"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvProgressStatusStep2"
            style="@style/simpleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textColor="@color/yellow"
            android:gravity="center"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <!-- Track List Container -->
        <LinearLayout
            android:id="@+id/llTrackListContainer"
            style="@style/wideLinearLayout_Vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chip"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvTrackListTitle"
                android:text="Tracks found:"
                style="@style/OptionSubTitle"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/llTrackList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
