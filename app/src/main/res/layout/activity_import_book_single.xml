<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        style="@style/wideLinearLayout_Vertical"
        android:padding="16dp"
        >

        <ProgressBar
            android:id="@+id/loadingProgressBarStep1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:max="100"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvProgressStatusStep1"
            style="@style/simpleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textColor="@color/yellow"
            android:gravity="center"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/waitTextView"
            style="@style/OptionAfterPickedInfo"
            android:textColor="@color/green_500"
            android:text="@string/init_please_wait"
            android:minLines="3"
            />
        <TextView
            android:id="@+id/errorTextView"
            style="@style/OptionAfterPickedInfo"
            android:textColor="@color/red_500"
            android:text="@string/error_generic"
            android:layout_marginVertical="20dp"
            />
        <TextView
            android:id="@+id/warningTextView"
            style="@style/OptionAfterPickedInfo"
            android:textColor="@color/orange"
            android:text="@string/Warning"
            android:layout_marginBottom="12dp"
            />

        <!-- Source group -->
        <LinearLayout
            android:id="@+id/llSourceContainer"
            style="@style/wideLinearLayout_Vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip"
            android:padding="8dp">

            <TextView
                android:text="@string/import_source_title"
                style="@style/OptionSubTitle"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSourceFileName"
                style="@style/simpleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="..."
                android:textStyle="bold"
                android:textSize="16sp"
                android:ellipsize="middle"
                android:maxLines="2"
                />

            <TextView
                android:id="@+id/tvInfoLine1"
                style="@style/OptionAfterPickedInfo"
                android:textStyle="normal"
                android:text="[sourceLocation]"
                android:layout_marginTop="4dp"
                />
            <TextView
                android:id="@+id/tvMimeExtension"
                style="@style/OptionAfterPickedInfo"
                android:textStyle="normal"
                android:text="[mime] - .toto"
                />
        </LinearLayout>

        <!-- Destination group -->
        <LinearLayout
            android:id="@+id/llAppendAndDest"
            style="@style/wideLinearLayout_Vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip"
            android:padding="8dp">

            <TextView
                android:text="@string/import_destination_title"
                style="@style/OptionSubTitle"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="4dp"/>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/groupNewVsExisting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/MaterialButtonForToggleGroup"
                    android:id="@+id/btnNewBook"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/import_new_book_label" />

                <com.google.android.material.button.MaterialButton
                    style="@style/MaterialButtonForToggleGroup"
                    android:id="@+id/btnAddToExisting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/import_existing_book_label" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- New-book identity: cover (tap to cycle candidates) + editable title.
                 Shown only while "New Book" is selected above. -->
            <LinearLayout
                android:id="@+id/llNewBookIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvCover"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    >

                    <ImageView
                        android:id="@+id/ivCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/cover_preview"
                        android:src="@drawable/no_image_icon"
                        />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.BookPlayer.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/import_book_title_hint">
                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/Widget.BookPlayer.TextInputEditText"
                            android:id="@+id/etBookTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="2"
                            android:textStyle="bold"
                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvCoverHint"
                        style="@style/OptionAfterPickedInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="italic"
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="2dp"
                        />

                </LinearLayout>

            </LinearLayout>

            <!-- Existing-folder picker: which book to append to. Shown only while
                 "Add to Existing Book" is selected above. -->
            <LinearLayout
                android:id="@+id/llExistingFolderPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:visibility="gone"
                >
                <Spinner
                    android:id="@+id/spinner_destination_folder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    />
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            >

            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.BookPlayer.Button.Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Cancel" />

            <View android:layout_width="16dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnConfirm"
                style="@style/Widget.BookPlayer.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Confirm" />
        </LinearLayout>

        <!-- Options group -->
        <LinearLayout
            android:id="@+id/llOptionsContainer"
            style="@style/wideLinearLayout_Vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip"
            android:padding="8dp">

            <TextView
                android:text="@string/import_options_title"
                style="@style/OptionSubTitle"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:id="@+id/llOptions"
                style="@style/LinearLayoutOptionsVertical"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp">

                <!-- TTS voice - ebooks only, first item in Options. -->
                <LinearLayout
                    style="@style/wideLinearLayout_Vertical"
                    android:layout_marginTop="0dp"
                    android:id="@+id/ll_import_tts_voice">
                    <TextView
                        android:text="@string/import_option_tts_voice_title"
                        style="@style/OptionSubTitle"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="4dp"/>
                    <Spinner
                        android:id="@+id/spinnerImportTtsVoice"
                        style="@style/Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- EPUB chapter-splitting method - EPUB ebooks only, right after the voice
                     picker so its live effect on the chapter list below is easy to spot. -->
                <LinearLayout
                    style="@style/wideLinearLayout_Vertical"
                    android:layout_marginTop="14dp"
                    android:id="@+id/ll_epub_split_mode">
                    <TextView
                        android:text="@string/import_option_epub_split_title"
                        style="@style/OptionSubTitle"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="4dp"/>
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupEpubSplitMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            style="@style/MaterialButtonForToggleGroup"
                            android:id="@+id/btnEpubSplitAuto"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:text="@string/import_option_epub_split_auto" />
                        <com.google.android.material.button.MaterialButton
                            style="@style/MaterialButtonForToggleGroup"
                            android:id="@+id/btnEpubSplitToc"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:text="@string/import_option_epub_split_toc" />
                        <com.google.android.material.button.MaterialButton
                            style="@style/MaterialButtonForToggleGroup"
                            android:id="@+id/btnEpubSplitSpine"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:text="@string/import_option_epub_split_spine" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <!-- Split M4B option -->
                <LinearLayout
                    style="@style/wideLinearLayout_Vertical"
                    android:layout_marginTop="6dp"
                    android:id="@+id/ll_split_m4b">
                    <TextView
                        android:text="@string/import_option_split_title"
                        style="@style/OptionSubTitle"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="4dp"/>
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupSplit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            style="@style/MaterialButtonForToggleGroup"
                            android:id="@+id/btnSplitYes"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:text="@string/import_option_split_yes" />
                        <com.google.android.material.button.MaterialButton
                            style="@style/MaterialButtonForToggleGroup"
                            android:id="@+id/btnSplitNo"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:text="@string/import_option_split_no" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <!-- Copy vs Link -->
                <LinearLayout
                    style="@style/wideLinearLayout_Vertical"
                    android:layout_marginTop="14dp"
                    android:id="@+id/ll_copy_internal">
                    <TextView
                        android:text="@string/import_option_storage_title"
                        style="@style/OptionSubTitle"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="4dp"/>
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupCopyLink"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            style="@style/MaterialButtonForToggleGroup"
                            android:id="@+id/btnCopy"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            app:icon="@drawable/ic_content_copy_24px"
                            app:iconSize="16dp"
                            app:iconGravity="textStart"
                            android:text="@string/import_option_copy" />
                        <com.google.android.material.button.MaterialButton
                            style="@style/MaterialButtonForToggleGroup"
                            android:id="@+id/btnLink"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            app:icon="@drawable/ic_link_2_24px"
                            app:iconSize="16dp"
                            app:iconGravity="textStart"
                            android:text="@string/import_option_link" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <!-- SD Card vs Device - only relevant/shown while Copy is selected above -->
                <LinearLayout
                    style="@style/wideLinearLayout_Vertical"
                    android:layout_marginTop="14dp"
                    android:id="@+id/ll_use_sdcard">
                    <TextView
                        android:text="@string/import_option_location_title"
                        style="@style/OptionSubTitle"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="4dp"/>
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupSdCardDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            style="@style/MaterialButtonForToggleGroup"
                            android:id="@+id/btnSdCard"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            app:icon="@drawable/ic_sd_card_24px"
                            app:iconSize="16dp"
                            app:iconGravity="textStart"
                            android:text="@string/import_option_sdcard" />
                        <com.google.android.material.button.MaterialButton
                            style="@style/MaterialButtonForToggleGroup"
                            android:id="@+id/btnDevice"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            app:icon="@drawable/ic_mobile_2_24px"
                            app:iconSize="16dp"
                            app:iconGravity="textStart"
                            android:text="@string/import_option_device" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <!-- Delete vs Keep source file - only relevant/shown while Copy is selected above -->
                <LinearLayout
                    style="@style/wideLinearLayout_Vertical"
                    android:layout_marginTop="14dp"
                    android:id="@+id/ll_delete_source">
                    <TextView
                        android:text="@string/import_option_after_import_title"
                        style="@style/OptionSubTitle"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="4dp"/>
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupDeleteKeep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            style="@style/MaterialButtonForToggleGroup"
                            android:id="@+id/btnDeleteSource"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            app:icon="@drawable/ic_delete_24"
                            app:iconSize="16dp"
                            app:iconGravity="textStart"
                            android:text="@string/import_option_delete_source" />
                        <com.google.android.material.button.MaterialButton
                            style="@style/MaterialButtonForToggleGroup"
                            android:id="@+id/btnKeepSource"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:text="@string/import_option_keep_source" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

            </LinearLayout>

            <!-- Points to where these defaults live, since this screen only ever changes them
                 for the book being imported right now. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvImportOptionsSettingsHint"
                    style="@style/OptionExplainText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:text="@string/import_options_settings_hint" />

                <ImageButton
                    android:id="@+id/btnImportOptionsSettings"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:padding="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings_24"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@string/import_options_settings_icon_description" />

            </LinearLayout>
        </LinearLayout>


        <ProgressBar
            android:id="@+id/loadingProgressBarStep2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:max="100"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvProgressStatusStep2"
            style="@style/simpleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textColor="@color/yellow"
            android:gravity="center"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <!-- Track List Container -->
        <LinearLayout
            android:id="@+id/llTrackListContainer"
            style="@style/wideLinearLayout_Vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chip"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvTrackListTitle"
                android:text="Tracks found:"
                style="@style/OptionSubTitle"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/llTrackList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
