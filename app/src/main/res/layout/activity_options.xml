<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10sp"
        android:layout_marginEnd="10sp"
        android:orientation="vertical">

        <LinearLayout
            style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:layout_marginTop="50sp"
                android:text="@string/option_timeBeforeSleep" />
            <LinearLayout
                android:id="@+id/ll_autosleep_horizon"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/myStyleTextExplainButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="50sp"
                    android:text="@string/option_timeBeforeSleep_text"
                    android:textSize="24sp" />
                <EditText style="@style/EditText"
                    android:id="@+id/etTimeBeforeSleep"
                    android:layout_width="70sp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:paddingStart="4sp"
                    android:paddingEnd="4sp"
                    android:textAlignment="textEnd"
                    android:textSize="24sp" />
                <TextView
                    style="@style/myStyleTextExplainButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/option_timeBeforeSleep_min"
                    android:textSize="24sp" />
            </LinearLayout>
            <TextView
                android:text="Min = 1"
                style="@style/OptionMiniText" />
            <TextView
                android:text="Max = 1440 (24h)"
                style="@style/OptionMiniText" />
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout style="@style/LinearLayoutOptionsVertical">
            <TextView
                android:id="@+id/txtCopyFileHead"
                style="@style/OptionTitle"
                android:text="@string/option_copy_file_title" />
            <TextView
                style="@style/OptionSubTitle"
                android:text="@string/option_copy_file_subtitle" />
            <LinearLayout style="@style/LayoutWrapContentMargin20horizontal"
                android:layout_height="wrap_content">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_copy_file"
                    style="@style/OptionCheckBox"/>
                <TextView style="@style/OptionCheckBoxText"
                    android:text="@string/option_copy_file_text"/>
            </LinearLayout>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_delete_source_file_title" />
            <TextView
                style="@style/OptionSubTitle"
                android:text="@string/option_delete_source_file_subtitle" />
            <LinearLayout style="@style/LayoutWrapContentMargin20horizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_delete_source_file_zip"
                    style="@style/OptionCheckBox"/>
                <TextView
                    android:id="@+id/txt_delete_source_file_zip"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_delete_source_file_text_01" />
            </LinearLayout>
            <LinearLayout style="@style/LayoutWrapContentMargin20horizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_delete_source_file_others"
                    style="@style/OptionCheckBox"/>
                <TextView
                    android:id="@+id/txt_delete_source_file_others"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_delete_source_file_text_02" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_orientation" />
            <LinearLayout style="@style/LayoutWrapContentMargin20horizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_lock_orientation"
                    style="@style/OptionCheckBox"/>
                <TextView
                    android:id="@+id/txt_orientation_lock"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_orientation_lock" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout
            android:id="@+id/ll_BackwardForward_vert"
            style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_backward_forward_title" />
            <LinearLayout
                android:id="@+id/ll_BackwardForward_horizon"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/myStyleTextExplainButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="50sp"
                    android:text="@string/option_backward_forward_text"
                    android:textSize="24sp" />
                <EditText style="@style/EditText"
                    android:id="@+id/etForwardSeconds"
                    android:layout_width="70sp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:paddingStart="4sp"
                    android:paddingEnd="4sp"
                    android:textAlignment="textEnd"
                    android:textSize="24sp" />
                <TextView
                    style="@style/myStyleTextExplainButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sec."
                    android:textSize="24sp" />
            </LinearLayout>
            <TextView
                android:text="Min = 1"
                style="@style/OptionMiniText" />
            <TextView
                android:text="Max = 300 (5min)"
                style="@style/OptionMiniText" />
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout
            android:id="@+id/ll_MailMethod_vert"
            style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_mail_method" />
            <LinearLayout
                android:id="@+id/ll_MailMethod_horizon"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_mail_method_default"
                    style="@style/OptionCheckBox"/>
                <TextView
                    android:id="@+id/txt_mail_method_default"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_mail_method_default" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout
            android:id="@+id/ll_beep"
            style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_beep_title" />
            <LinearLayout
                android:id="@+id/ll_beep_horizon"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_beep_chapter_default"
                    style="@style/OptionCheckBox"/>
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_beep_between_chapters" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_beep_horizon2"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_beep_autostop_defaut"
                    style="@style/OptionCheckBox"/>
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_beep_for_autostop" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_beep_horizon3"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_beep_bookend_defaut"
                    style="@style/OptionCheckBox"/>
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_beep_at_the_end" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_visualizer_title" />
            <LinearLayout style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_visualizer_on"
                    style="@style/OptionCheckBox"/>
                <TextView
                    android:id="@+id/tx_Visualizer_on"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_visualizer_text_01" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_rewind_after_pause_title" />
            <LinearLayout style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_rewind_after_pause"
                    style="@style/OptionCheckBox"/>
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_rewind_after_pause_text" />
            </LinearLayout>
        </LinearLayout>


        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout style="@style/LinearLayoutOptionsVertical"
            android:layout_marginHorizontal="10sp">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_pick_theme_color_title" />
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:layout_marginTop="20sp"
                android:gravity="center"
                >
                <ImageButton
                    android:id="@+id/btn_color_01"
                    style="@style/OptionsColorButtons"/>
                <ImageButton
                    android:id="@+id/btn_color_02"
                    style="@style/OptionsColorButtons"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    />
                <ImageButton
                    android:id="@+id/btn_color_03"
                    style="@style/OptionsColorButtons"/>
            </LinearLayout>
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:layout_marginTop="10sp"
                >
                <ImageButton
                    android:id="@+id/btn_color_04"
                    style="@style/OptionsColorButtons"/>
                <ImageButton
                    android:id="@+id/btn_color_05"
                    style="@style/OptionsColorButtons"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    />
                <ImageButton
                    android:id="@+id/btn_color_06"
                    style="@style/OptionsColorButtons"/>
            </LinearLayout>
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="fill_parent"
                android:layout_marginTop="10sp"
                >
                <Button
                    android:id="@+id/btn_color_picker"
                    android:text="color_picker"
                    style="@style/OptionsColorButtons"/>
            </LinearLayout>
        </LinearLayout>







        <!-- ZIP PART-->
        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout
            android:id="@+id/ll_ZipOptions_vert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_zip_header"
                style="@style/OptionTitle"
                android:text="@string/option_zip" />

            <LinearLayout
                android:id="@+id/ll_ZipOptions_horizon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20sp"
                android:layout_marginTop="20sp"
                android:orientation="horizontal">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_copyzip_local"
                    style="@style/OptionCheckBox"/>

                <TextView
                    android:id="@+id/txt_copyzip_local"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_copyzip_local" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_ZipOptions_horizon2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20sp"
                android:layout_marginTop="20sp"
                android:orientation="horizontal">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_unzip_local"
                    style="@style/OptionCheckBox"/>

                <TextView
                    android:id="@+id/txt_unzip_local"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_unzip_local" />
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>
</ScrollView>