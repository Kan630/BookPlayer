<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginEnd="10sp"
        android:layout_marginStart="10sp"
        >

        <TextView
            android:text="@string/option_timeBeforeSleep"
            style="@style/myStyleTextTitle2"
            android:layout_marginTop="50sp"
            />
        <LinearLayout
            android:id="@+id/ll_autosleep_horizon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="50sp"
            android:layout_marginTop="20sp"
            >
            <TextView
                android:text="@string/option_timeBeforeSleep_text"
                style="@style/myStyleTextExplainButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50sp"
                android:textSize="24sp"
                />
            <EditText
                android:inputType="number"
                style="@style/myStyleTextExplainButton"
                android:layout_width="70sp"
                android:layout_height="wrap_content"
                android:id="@+id/etTimeBeforeSleep"
                android:textAlignment="textEnd"
                android:paddingStart="4sp"
                android:paddingEnd="4sp"
                android:textSize="24sp"
                />
            <TextView
                android:text="@string/option_timeBeforeSleep_min"
                style="@style/myStyleTextExplainButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                />
        </LinearLayout>

        <TextView
            android:text="Min = 1"
            style="@style/myStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:textSize="12sp"
            />
        <TextView
            android:text="Max = 1440 (24h)"
            style="@style/myStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:textSize="12sp"
            />







        <LinearLayout
            android:id="@+id/ll_OrientationOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20sp"
            >

            <View style="@style/myStyleViewSimpleHorizontalBar"/>

            <TextView
                android:text="@string/option_delete_source_file_title"
                style="@style/myStyleTextTitle2"
                />

            <LinearLayout style="@style/LayoutWrapContentMargin20horizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_delete_source_file"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    />
                <TextView
                    style="@style/myStyle"
                    android:id="@+id/txt_delete_source_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:layout_marginStart="10sp"
                    android:text="@string/option_delete_source_file_text"
                    android:textSize="16sp"
                    />
            </LinearLayout>
        </LinearLayout>






        <LinearLayout
            android:id="@+id/ll_OrientationOption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20sp"
            >

            <View style="@style/myStyleViewSimpleHorizontalBar"/>

            <TextView
                android:text="@string/option_orientation"
                style="@style/myStyleTextTitle2"
                />

            <LinearLayout style="@style/LayoutWrapContentMargin20horizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_lock_orientation"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    />
                <TextView
                    style="@style/myStyle"
                    android:id="@+id/txt_orientation_lock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:layout_marginStart="10sp"
                    android:text="@string/option_orientation_lock"
                    android:textSize="16sp"
                    />
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
        android:id="@+id/ll_BackwardForward_vert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20sp"
        android:layout_marginBottom="20sp"
        >

            <View style="@style/myStyleViewSimpleHorizontalBar"/>

        <TextView
            android:text="BackWard/Forward Buttons"
        style="@style/myStyleTextTitle2"/>
    <LinearLayout
        android:id="@+id/ll_BackwardForward_horizon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="50sp"
        android:layout_marginTop="20sp"
        >
        <TextView
            style="@style/myStyleTextExplainButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="timelapse :"
            android:layout_marginStart="50sp"
            android:textSize="24sp"
            />
        <EditText
            style="@style/myStyleTextExplainButton"
            android:layout_width="70sp"
            android:layout_height="wrap_content"
            android:id="@+id/etForwardSeconds"
            android:inputType="number"
            android:textAlignment="textEnd"
            android:paddingStart="4sp"
            android:paddingEnd="4sp"
            android:textSize="24sp"
            />
        <TextView
            style="@style/myStyleTextExplainButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="sec."
            android:textSize="24sp"
            />
    </LinearLayout>
        <TextView
            android:text="Min = 1"
            style="@style/myStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:textSize="12sp"
            />
        <TextView
            android:text="Max = 300 (5min)"
            style="@style/myStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:textSize="12sp"
            />
    </LinearLayout>




        <View style="@style/myStyleViewSimpleHorizontalBar"/>
    <LinearLayout
        android:id="@+id/ll_MailMethod_vert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="20sp"
        android:layout_marginTop="20sp"
        android:layout_marginBottom="20sp"
        >

            <TextView
                android:text="@string/option_mail_method"
                style="@style/myStyleTextTitle2"
                />

            <LinearLayout
                android:id="@+id/ll_MailMethod_horizon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="20sp"
                android:layout_marginTop="20sp"
                >
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_mail_method_default"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    />
                <TextView
                    style="@style/myStyle"
                    android:id="@+id/txt_mail_method_default"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:layout_marginStart="10sp"
                    android:text="@string/option_mail_method_default"
                    android:textSize="16sp"
                    />
            </LinearLayout>
        </LinearLayout>


        <View style="@style/myStyleViewSimpleHorizontalBar"/>

        <LinearLayout
            android:id="@+id/ll_beep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="20sp"
            android:layout_marginTop="20sp"
            android:layout_marginBottom="20sp"
            >

            <TextView
                android:text="@string/option_beep_title"
                style="@style/myStyleTextTitle2"
                />

            <LinearLayout
                android:id="@+id/ll_beep_horizon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="20sp"
                android:layout_marginTop="20sp"
                >
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_beep_chapter_default"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    />
                <TextView
                    style="@style/myStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:layout_marginStart="10sp"
                    android:text="@string/option_beep_between_chapters"
                    android:textSize="16sp"
                    />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_beep_horizon2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="20sp"
                android:layout_marginTop="20sp"
                >
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_beep_autostop_defaut"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    />
                <TextView
                    style="@style/myStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="textEnd"
                    android:layout_marginStart="10sp"
                    android:text="@string/option_beep_for_autostop"
                    android:textSize="16sp"
                    />
            </LinearLayout>
            <LinearLayout
            android:id="@+id/ll_beep_horizon3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="20sp"
            android:layout_marginTop="20sp"
            >
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_beep_bookend_defaut"
                android:layout_width="30dp"
                android:layout_height="30dp"
                />
            <TextView
                style="@style/myStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:layout_marginStart="10sp"
                android:text="@string/option_beep_at_the_end"
                android:textSize="16sp"
                />
        </LinearLayout>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar"/>

    <LinearLayout
        android:id="@+id/ll_ZipOptions_vert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20sp"
        >

        <TextView
            android:text="@string/option_zip"
            style="@style/myStyleTextTitle2"
            android:id="@+id/txt_zip_header"
            />

        <LinearLayout
            android:id="@+id/ll_ZipOptions_horizon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="20sp"
            android:layout_marginTop="20sp"
            >
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_copyzip_local"
                android:layout_width="30dp"
                android:layout_height="30dp"
                />
            <TextView
                android:text="@string/option_copyzip_local"
                style="@style/myStyle"
                android:id="@+id/txt_copyzip_local"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:layout_marginStart="10sp"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_ZipOptions_horizon2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="20sp"
            android:layout_marginTop="20sp"
            >
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_unzip_local"
                android:layout_width="30dp"
                android:layout_height="30dp"
                />
            <TextView
                android:text="@string/option_unzip_local"
                style="@style/myStyle"
                android:id="@+id/txt_unzip_local"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:layout_marginStart="10sp"
                android:textSize="16sp"
                />
        </LinearLayout>
    </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>

</ScrollView>