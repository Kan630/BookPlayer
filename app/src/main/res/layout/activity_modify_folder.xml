<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Your scrollable content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <LinearLayout
            style="@style/LinearLayoutOptionsVertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:paddingBottom="20dp"
            android:gravity="center"
            >

            <TextView
                android:id="@+id/title"
                style="@style/myStyleBigTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:paddingHorizontal="20dp"
                android:text="Folder Title"
                android:background="@drawable/bg_chip"
                />

            <LinearLayout style="@style/wideLinearLayout_Vertical"
                android:id="@+id/ll_zikfile_resolve_error"
                android:background="@drawable/bg_chip"
                >
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_error_24"
                    android:layout_gravity="center"
                    />
                <TextView
                    android:id="@+id/tv_error_title"
                    style="@style/simpleTextWrap"
                    android:text="@string/error"
                    android:layout_gravity="center"
                    android:textColor="@color/red_500"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"
                />
                <LinearLayout
                    android:id="@+id/llAutoRepairProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        style="@style/simpleTextWrap"
                        android:layout_gravity="center"
                        android:text="@string/auto_repair_searching" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mbPickNewLocation"
                    style="@style/Widget.BookPlayer.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/pick_a_new_location"
                    />
                <TextView
                    android:id="@+id/tv_zikfile_resolve_error"
                    style="@style/simpleTextWrap"
                    android:layout_gravity="center"
                    android:text="@string/error_generic"
                    android:textColor="@color/red_500"
                    android:focusable="true"
                    android:textIsSelectable="true"
                    />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/llStorageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textViewStorageIcon"
                        style="@style/myStyleInfo"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="Audio Location :\nxxxxxx" />

                    <ImageView
                        android:id="@+id/imageViewStorageIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/no_image_icon" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bMoveStorage"
                        style="@style/Widget.BookPlayer.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp"
                        android:textSize="11sp"
                        android:text="@string/move_book_button" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvModifyFolderInfo"
                    style="@style/myStyleInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/llStorageInfo"
                    android:paddingHorizontal="20dp"
                    android:text="info ..." />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/ll_ebook_metadata"
                style="@style/wideLinearLayout_Vertical"
                android:background="@drawable/bg_chip"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="20dp"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_ebook_metadata"
                    style="@style/myStyleInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
            <LinearLayout style="@style/SettingsGroupCardContent">
                <TextView
                    android:id="@+id/tvRenameBook"
                    style="@style/SettingsGroupTitle"
                    android:text="@string/Rename_book" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.BookPlayer.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/Widget.BookPlayer.TextInputEditText"
                        android:id="@+id/etRename"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:textSize="20sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
            <LinearLayout style="@style/SettingsGroupCardContent">
                <TextView
                    style="@style/SettingsGroupTitle"
                    android:text="@string/Change_cover_image" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivCoverPreview"
                        android:layout_width="150dp"
                        android:layout_height="180dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/placeholder_cover" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <Button
                            android:id="@+id/bChangeCover"
                            style="@style/Widget.BookPlayer.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_change" />
                        <Button
                            android:id="@+id/bDeleteCover"
                            style="@style/Widget.BookPlayer.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_delete" />
                        <Button
                            android:id="@+id/bGenerateCover"
                            style="@style/Widget.BookPlayer.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_generate" />
                        <Button
                            android:id="@+id/bWebSearch"
                            style="@style/Widget.BookPlayer.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_web_search" />
                        <Button
                            android:id="@+id/bResetToOriginal"
                            style="@style/Widget.BookPlayer.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_reset_to_original" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
            <LinearLayout style="@style/SettingsGroupCardContent">
                <TextView
                    android:id="@+id/IntroCutText"
                    style="@style/SettingsGroupTitle"
                    android:text="@string/IntroCut" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.BookPlayer.TextInputLayout.Compact"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/Widget.BookPlayer.TextInputEditText.Compact"
                            android:id="@+id/etIntroCut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textSize="20sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        style="@style/simpleTextWrap"
                        android:layout_marginStart="10dp"
                        android:text="sec."
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    style="@style/OptionExplainText"
                    android:text="@string/IntroCutText" />
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
            <LinearLayout style="@style/SettingsGroupCardContent">
                <TextView
                    android:id="@+id/EndCutText"
                    style="@style/SettingsGroupTitle"
                    android:text="@string/EndCut" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.BookPlayer.TextInputLayout.Compact"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/Widget.BookPlayer.TextInputEditText.Compact"
                            android:id="@+id/etEndCut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textSize="20sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        style="@style/simpleTextWrap"
                        android:layout_marginStart="10dp"
                        android:text="sec."
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    style="@style/OptionExplainText"
                    android:text="@string/EndCutText" />
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
            <LinearLayout style="@style/SettingsGroupCardContent">
                <TextView
                    style="@style/SettingsGroupTitle"
                    android:text="@string/BookType" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivBookType"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvBookType"
                        style="@style/simpleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.driot.bookplayer.views.SettingSwitchRow
                    android:id="@+id/rowMusicType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/rounded_corner_surface_variant"
                    app:title="@string/MakeMusicType"
                    app:subtitle="@string/MakeMusicTypeSubtitle" />
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
            <LinearLayout style="@style/SettingsGroupCardContent">
                <TextView
                    style="@style/SettingsGroupTitle"
                    android:text="@string/modify_group_tracks" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_reorder_24px" />
                    <Button
                        android:id="@+id/bChangeTracksOrder"
                        style="@style/Widget.BookPlayer.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="@string/change_tracks_order" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sort_24px" />
                    <Button
                        android:id="@+id/bResetTracksOrder"
                        style="@style/Widget.BookPlayer.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="@string/reset_track_order" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_add_24px" />
                    <Button
                        android:id="@+id/bAddNewTracks"
                        style="@style/Widget.BookPlayer.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="@string/add_new_tracks" />
                </LinearLayout>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
            <LinearLayout style="@style/SettingsGroupCardContent">
                <TextView
                    style="@style/SettingsGroupTitle"
                    android:text="@string/modify_group_actions" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_replay_24px" />
                    <Button
                        android:id="@+id/bReset"
                        style="@style/Widget.BookPlayer.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="@string/bReset" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_file_export_24px" />
                    <Button
                        android:id="@+id/bExport"
                        style="@style/Widget.BookPlayer.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="@string/Export_3pt" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_connect_without_contact_24px" />
                    <Button
                        android:id="@+id/bShare"
                        style="@style/Widget.BookPlayer.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="@string/Quick_Share_3dots" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_delete_24" />
                    <Button
                        android:id="@+id/bDelete"
                        style="@style/Widget.BookPlayer.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="@string/Delete" />
                </LinearLayout>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Blocking overlay ON TOP (last child) -->
    <FrameLayout
        android:id="@+id/blockingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_overlay_card_theme">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tvBlockingText"
                style="@style/simpleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/Deleting"
                />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
