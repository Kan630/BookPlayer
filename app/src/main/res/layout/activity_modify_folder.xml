<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Your scrollable content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            style="@style/LinearLayoutOptionsVertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center">

            <TextView
                android:id="@+id/title"
                style="@style/myStyleBigTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:paddingHorizontal="20dp"
                android:text="Folder Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                android:baselineAligned="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewStorageIcon"
                    style="@style/myStyleInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="0dp"
                    android:paddingEnd="0dp"
                    android:text="Audio Location : xxxxxx" />

                <ImageView
                    android:id="@+id/imageViewStorageIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="0dp"
                    android:backgroundTint="@color/brown_300"
                    android:backgroundTintMode="screen" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvInfo"
                style="@style/myStyleInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="info ..." />

            <View style="@style/myStyleViewSimpleHorizontalBar" />

            <TextView
                android:id="@+id/tvRenameBook"
                style="@style/OptionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="20dp"
                android:text="@string/Rename_book"
                android:textSize="20sp"
                android:textStyle="normal" />

            <EditText
                android:id="@+id/etRename"
                style="@style/EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:padding="10dp"
                android:paddingVertical="10dp"
                android:inputType="textMultiLine"
                android:textSize="20sp" />

            <View style="@style/myStyleViewSimpleHorizontalBar" />

            <TextView
                style="@style/OptionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="15dp"
                android:paddingHorizontal="20dp"
                android:text="@string/Change_cover_image"
                android:textSize="20sp"
                android:textStyle="normal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivCoverPreview"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/placeholder_cover" />

                <Button
                    android:id="@+id/bChangeCover"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/Change" />
            </LinearLayout>

            <View style="@style/myStyleViewSimpleHorizontalBar" />

            <TextView
                android:id="@+id/IntroCutText"
                style="@style/OptionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:paddingHorizontal="20dp"
                android:text="@string/IntroCut"
                android:textSize="20sp"
                android:textStyle="normal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:orientation="horizontal"
                android:gravity="center">

                <EditText
                    android:id="@+id/etIntroCut"
                    style="@style/EditText"
                    android:layout_width="50dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:inputType="number"
                    android:textSize="20sp" />

                <TextView
                    style="@style/OptionSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:text="sec."
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                style="@style/OptionSubTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:paddingHorizontal="20dp"
                android:text="@string/IntroCutText"
                android:textSize="12sp" />

            <View style="@style/myStyleViewSimpleHorizontalBar" />

            <Button
                android:id="@+id/bReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="@string/bReset" />

            <View style="@style/myStyleViewSimpleHorizontalBar" />

            <Button
                android:id="@+id/bExport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="@string/Export" />

            <View style="@style/myStyleViewSimpleHorizontalBar" />

            <Button
                android:id="@+id/bDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="@string/bDelete" />

            <View
                style="@style/myStyleViewSimpleHorizontalBar"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Blocking overlay ON TOP (last child) -->
    <FrameLayout
        android:id="@+id/blockingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_overlay_card">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tvBlockingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Deleting…"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
