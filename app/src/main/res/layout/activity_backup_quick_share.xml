<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout style="@style/wideLinearLayout_Horizontal"
            android:background="@drawable/bg_chip">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/icon"
                android:src="@drawable/ic_connect_without_contact_24px"
                app:tint="?attr/colorPrimary" />
            <TextView
                android:id="@+id/title"
                style="@style/myStyleBigTitle"
                android:textSize="24sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_quick_share_explain"
            style="@style/OptionExplainText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_chip" />

        <TextView
            android:id="@+id/tv_file_info"
            style="@style/myStyleInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="10dp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:background="@drawable/bg_chip"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_connected_endpoint"
            style="@style/myStyleInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="10dp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="16sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_sharing"
            style="@style/Widget.BookPlayer.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            android:max="100" />

        <TextView
            android:id="@+id/tv_status"
            style="@style/myStyleInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:textAlignment="center" />

    </LinearLayout>
</ScrollView>
