<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    >

    <LinearLayout
        style="@style/LinearLayoutOptionsVertical"
        android:layout_marginStart="10sp"
        android:layout_marginEnd="10sp"
        android:gravity="center">

        <TextView
            android:id="@+id/title"
            android:text="Folder Title"
            style="@style/myStyleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="20dp" />

        <TextView
            android:id="@+id/lastAccess"
            android:text="last access : xxxxx"
            style="@style/myStyleinfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="20dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
            android:gravity="center_vertical"
            android:baselineAligned="true"
            >
            <TextView
                android:id="@+id/textViewStorageIcon"
                android:text="Audio Location : xxxxxx"
                style="@style/myStyleinfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:paddingEnd="0dp"
                android:includeFontPadding="false"
                />
            <ImageView
                android:id="@+id/imageViewStorageIcon"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="0dp"
                android:backgroundTint="@color/brown_300"
                android:backgroundTintMode="screen"
                />
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <TextView
            android:id="@+id/IntroCutText"
            android:text="@string/IntroCut"
            style="@style/OptionTitle"
            android:textStyle="normal"
            android:textSize="20sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            >
            <EditText
                android:id="@+id/etIntroCut"
                style="@style/EditText"
                android:inputType="number"
                android:layout_width="50dp"
                android:layout_height="30dp"
                android:textSize="20sp"
                android:padding="5dp"
                />
            <TextView
                android:text="sec."
                android:textSize="12sp"
                style="@style/OptionSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                />
        </LinearLayout>

        <TextView
            android:text="@string/IntroCutText"
            android:textSize="12sp"
            style="@style/OptionSubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="20dp" />


        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <Button
            android:id="@+id/bReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/bReset" />


        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <EditText
            android:id="@+id/etRename"
            style="@style/EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="30sp"
            android:paddingVertical="10sp"
            android:inputType="textMultiLine"
            android:padding="10dp"
            android:textSize="20sp" />

        <Button
            android:id="@+id/bRename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:text="@string/bRenameFolder" />

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <Button
            android:id="@+id/bDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/bDelete" />

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <Button
            android:id="@+id/bExport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/Export" />

        <View style="@style/myStyleViewSimpleHorizontalBar" />


    </LinearLayout>
</ScrollView>