<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/title"
        style="@style/myStyleBigTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/share_book"
        android:background="@drawable/bg_chip"
        />

    <TextView
        android:id="@+id/title"
        style="@style/OptionExplainText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/share_book"
        android:background="@drawable/bg_chip"
        />

    <TextView
        android:id="@+id/tvBookInfo"
        style="@style/myStyleInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="10dp"
        android:text="Loading book information..."
        />

    <LinearLayout
        android:id="@+id/layoutBookPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical"
        >

        <ImageView
            android:id="@+id/ivCoverPreview"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="@android:color/darker_gray"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null"
            />

        <TextView
            android:id="@+id/tvBookTitlePreview"
            style="@style/myStyleInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book Title"
            android:textSize="18sp"
            android:textStyle="bold"
            />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/rgMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbSendMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Send (Advertise)"
            android:checked="true"
            />

        <RadioButton
            android:id="@+id/rbReceiveMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Receive (Discover)"
            />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartSharing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/nearby_share_start_advertising"
        android:backgroundTint="?attr/colorPrimary"
        />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        android:max="100"
        />

    <TextView
        android:id="@+id/tvStatus"
        style="@style/myStyleInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:textAlignment="center"
        />

</LinearLayout>
