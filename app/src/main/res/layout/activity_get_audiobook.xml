<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <View
            android:id="@+id/focusGuard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Ongoing task banner container -->
        <FrameLayout
            android:id="@+id/topOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            tools:context=".activities.MainActivity">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/txtLibrivoxSearch_title"
                        android:text="@string/LibrivoxSearch_title"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="20dp"
                        style="@style/GetResourceTextSectionTitle" />
                    <ImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_librivox_24"
                        android:scaleType="centerInside"
                        android:background="@android:color/transparent"
                        app:tint="?attr/colorOnSurface"
                        android:layout_marginEnd="20dp" />
                </LinearLayout>

                <View style="@style/GetResourceHorizontalBar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <Button
                        android:id="@+id/bFavorite"
                        android:text="@string/Favorites"
                        style="@style/GetResourceButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="0dp"

                        />

                    <ImageButton
                        android:id="@+id/ibFavorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/favorites"
                        android:src="@drawable/ic_favorite"
                        android:background="@android:color/transparent"
                        app:tint="@android:color/holo_red_dark" />

                    <!-- Spacer pushes the next item to the right -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/ibSettings"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/settings"
                        android:src="@drawable/ic_settings_24"
                        android:background="@android:color/transparent"
                        />
                </LinearLayout>


                <View style="@style/GetResourceHorizontalBar"/>


                <TextView
                    android:id="@+id/txtLibrivoxSearch_desc"
                    android:layout_marginTop="20dp"
                    android:text="@string/LibrivoxSearch_desc"
                    style="@style/GetResourceTextTopOfButton" />

                <Spinner
                    android:id="@+id/spinnerLibrivox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    style="@style/GetResourceSpinner" />

                <View style="@style/GetResourceHorizontalBar"/>

                <Button
                    android:id="@+id/bLibrivoxTrending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/most_downloaded"
                    style="@style/GetResourceButton" />

                <View style="@style/GetResourceHorizontalBar" />

                <TextView
                    android:layout_marginTop="20dp"
                    android:text="@string/librivox_search_edittext_title"
                    style="@style/GetResourceTextTopOfButton" />

                <com.driot.bookplayer.views.EditText1lineWithPasteDelete
                    android:id="@+id/etLibrivox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:scrollOnFocus="true"
                    android:layout_marginTop="20dp" />

                <Button
                    android:id="@+id/bLibrivoxSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/Search"
                    style="@style/GetResourceButton" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
