<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardElevation="2dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardBackgroundColor="@color/cardBackground"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Root is now WRAP_CONTENT; ratio is handled by the ImageView below -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/radio_favicon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/radio_cover_desc"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:shapeAppearanceOverlay="@style/RoundedCorners12"
            />

        <!-- Border overlay (on top of favicon) -->
        <View
            android:id="@+id/radio_border"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_radio"
            android:duplicateParentState="true"
            app:layout_constraintTop_toTopOf="@id/radio_favicon"
            app:layout_constraintBottom_toBottomOf="@id/radio_favicon"
            app:layout_constraintStart_toStartOf="@id/radio_favicon"
            app:layout_constraintEnd_toEndOf="@id/radio_favicon"
            />

        <!-- Default Radio icon (shown only when no favicon is available) -->
        <ImageView
            android:id="@+id/ivDefaultIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="8dp"
            android:src="@drawable/ic_radio_24px"
            android:visibility="gone"
            app:tint="@android:color/white"
            app:layout_constraintTop_toTopOf="@id/radio_favicon"
            app:layout_constraintStart_toStartOf="@id/radio_favicon" />

        <!-- Favorite button -->
        <ImageButton
            android:id="@+id/ibFavorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite"
            android:contentDescription="@string/favorite"
            app:layout_constraintTop_toTopOf="@id/radio_favicon"
            app:layout_constraintEnd_toEndOf="@id/radio_favicon" />

        <!-- Bottom scrim + title/info pinned to the image bounds -->
        <LinearLayout
            android:id="@+id/bottomInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_bottom_gradient_scrim"
            app:layout_constraintStart_toStartOf="@id/radio_favicon"
            app:layout_constraintEnd_toEndOf="@id/radio_favicon"
            app:layout_constraintBottom_toBottomOf="@id/radio_favicon">

            <TextView
                android:id="@+id/radio_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@android:color/white"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Station name" />

            <TextView
                android:id="@+id/radio_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:alpha="0.85"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="FR • fr • jazz" />
        </LinearLayout>

        <!-- Badges pinned inside the image bounds (bottom-left) -->
        <LinearLayout
            android:id="@+id/badges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            app:layout_constraintStart_toStartOf="@id/radio_favicon"
            app:layout_constraintBottom_toBottomOf="@id/radio_favicon">

            <TextView
                android:id="@+id/radio_codec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_badge_translucent"
                android:maxLines="1" />

            <TextView
                android:id="@+id/radio_bitrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_badge_translucent"
                android:maxLines="1" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
