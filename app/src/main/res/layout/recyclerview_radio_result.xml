<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardElevation="2dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardBackgroundColor="@color/cardBackground"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Root is now WRAP_CONTENT; ratio is handled by the ImageView below -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <ImageView
            android:id="@+id/radio_favicon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/radio_cover_desc"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            />

        <!-- Favorite button -->
        <ImageButton
            android:id="@+id/ibFavorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite"
            android:contentDescription="@string/favorite"
            app:layout_constraintTop_toTopOf="@id/radio_favicon"
            app:layout_constraintEnd_toEndOf="@id/radio_favicon" />

        <!-- Bottom scrim + title/info pinned to the image bounds -->
        <LinearLayout
            android:id="@+id/bottomInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_bottom_gradient_scrim"
            app:layout_constraintStart_toStartOf="@id/radio_favicon"
            app:layout_constraintEnd_toEndOf="@id/radio_favicon"
            app:layout_constraintBottom_toBottomOf="@id/radio_favicon">

            <TextView
                android:id="@+id/radio_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@android:color/white"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Station name" />

            <LinearLayout
                style="@style/simpleLinearLayout_Horizontal">
                <ImageView
                    android:id="@+id/iv_radio_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/no_flag"
                    />
            <TextView
                android:id="@+id/radio_info_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:alpha="0.85"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="HLS" />
            </LinearLayout>
        </LinearLayout>


        <!-- Border overlay (on top of EVERYTHING including scrim and badges) -->
        <View
            android:id="@+id/radio_border"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_radio"
            android:duplicateParentState="true"
            app:layout_constraintTop_toTopOf="@id/radio_favicon"
            app:layout_constraintBottom_toBottomOf="@id/radio_favicon"
            app:layout_constraintStart_toStartOf="@id/radio_favicon"
            app:layout_constraintEnd_toEndOf="@id/radio_favicon"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
