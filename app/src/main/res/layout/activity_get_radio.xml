<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        >

        <View
            android:id="@+id/focusGuard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <!-- Ongoing task banner container -->
        <FrameLayout
            android:id="@+id/topOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="16dp"
            android:descendantFocusability="beforeDescendants"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fillViewport="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/miniNowPlaying"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/txtRadio_title"
                        android:text="@string/RadioSearch_title"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="20dp"
                        style="@style/GetResourceTextSectionTitle" />
                    <ImageButton
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_radio_24px"
                        android:scaleType="centerInside"
                        android:background="@android:color/transparent"
                        app:tint="?attr/colorOnSurface"
                        android:layout_marginEnd="20dp" />

                    <!-- Spacer pushes the next item to the right -->
                    <View style="@style/spacer"/>
                    <ImageButton
                        android:id="@+id/ibSettings"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/settings"
                        android:src="@drawable/ic_settings_24"
                        android:background="@android:color/transparent"
                        />

                </LinearLayout>

                <View style="@style/GetResourceHorizontalBar" />

                <!-- Row: Favorites + Settings -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/bFavorite"
                        android:text="@string/Favorites"
                        style="@style/GetResourceButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageButton
                        android:id="@+id/ibFavorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/favorites"
                        android:src="@drawable/ic_favorite"
                        android:background="@android:color/transparent"
                        app:tint="@android:color/holo_red_dark" />

                </LinearLayout>

                <View style="@style/GetResourceHorizontalBar" />

                <!-- Description -->
                <TextView
                    android:layout_marginTop="30dp"
                    android:text="@string/quick_lists"
                    style="@style/GetResourceTextTopOfButton" />

                <!-- Trending -->
                <Button
                    android:id="@+id/bRadioTrending"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/trending_radios"
                    android:layout_gravity="center_horizontal"
                    style="@style/GetResourceButton" />

                <!-- Filters: Language / Country / Tag -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:gravity="top"
                    >

                    <Button
                        android:id="@+id/bByTag"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="64dp"
                        android:layout_marginHorizontal="6dp"
                        android:text="@string/by_tag"
                        />

                    <Button
                        android:id="@+id/bByCountry"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="64dp"
                        android:layout_marginHorizontal="6dp"
                        android:text="@string/by_country"
                        />

                    <Button
                        android:id="@+id/bByLanguage"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="64dp"
                        android:layout_marginHorizontal="6dp"
                        android:text="@string/by_language"
                        />
                </LinearLayout>

                <View style="@style/GetResourceHorizontalBar" />

                <TextView
                    android:layout_marginTop="30dp"
                    android:text="@string/search_by_station_name"
                    style="@style/GetResourceTextTopOfButton" />

                <!-- Search box -->
                <!-- scrollOnFocus = custom defined in attrs.xml -->
                <com.driot.bookplayer.views.EditText1lineWithPasteDelete
                    android:id="@+id/etRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:scrollOnFocus="true"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/bRadioSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/Search"
                    style="@style/GetResourceButton" />

            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>