<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Mass_Import"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="16dp"
        />

    <!-- Scanning Progress Area -->
    <LinearLayout
        android:id="@+id/llScanning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scanning..."
            android:layout_marginBottom="8dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true" />


    </LinearLayout>

    <!-- Report/List Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clReport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCandidates"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/storageBar"
            tools:listitem="@layout/item_candidate"/>

        <!-- Storage Section -->
        <LinearLayout
            android:id="@+id/llStorageSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/rvCandidates"
            app:layout_constraintBottom_toTopOf="@id/llButtons">
            
            <!-- Storage Header -->
            <TextView
                android:id="@+id/tvStorageHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/storage_header"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />
            
            <!-- Storage Bar -->
            <com.driot.bookplayer.widgets.StorageBarView
                android:id="@+id/storageBar"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp" />
            
            <!-- Legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start">
                
                <!-- Used (Gray) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="16dp">
                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@color/gray_500"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/tvLegendUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/storage_legend_others"
                        android:textSize="12sp"
                        />
                </LinearLayout>
                
                <!-- Books (Pastel Blue) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="16dp">
                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@color/pastel_blue_500"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/tvLegendBooks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/storage_legend_copied"
                        android:textSize="12sp"
                        />
                </LinearLayout>
                
                <!-- Linked Audios (Green) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="16dp">
                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@color/green_500"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/tvLegendLinkedAudios"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/storage_legend_linked_audios"
                        android:textSize="12sp"
                        />
                </LinearLayout>
                
                <!-- New Books (Yellow) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@color/yellow_500"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/tvLegendNewBooks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/storage_legend_new_books"
                        android:textSize="12sp"
                        />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            app:layout_constraintBottom_toBottomOf="parent"
            android:paddingTop="16dp">

             <TextView
                android:id="@+id/tvCount"
                 android:layout_width="0dp"
                 android:layout_height="wrap_content"
                 android:layout_weight="1"
                 android:text="Found 0 items"
                 android:layout_gravity="center_vertical"/>

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Cancel"
                android:layout_marginEnd="16dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>

            <Button
                android:id="@+id/btnConfirmImport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Import" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</LinearLayout>
