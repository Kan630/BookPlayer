<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10sp"
    android:layout_marginEnd="10sp"
    android:orientation="vertical">

    <!-- Advanced Options -->



    <View style="@style/myStyleViewSimpleHorizontalBar" />

    <LinearLayout style="@style/LinearLayoutOptionsVertical">
        <TextView
            style="@style/OptionTextDefaultFor"
            android:text="@string/default_for" />
        <TextView
            style="@style/OptionTitle"
            android:text="@string/option_split_m4b"
            android:layout_marginTop="0dp"/>
        <LinearLayout style="@style/LinearLayoutOptionsCheckBoxHorizontal"
            android:id="@+id/ll_split_m4b">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_split_m4b"
                style="@style/OptionCheckBox"/>
            <TextView
                android:id="@+id/tx_split_m4b"
                style="@style/OptionCheckBoxText"
                android:text="@string/option_split_m4b_text" />
        </LinearLayout>
    </LinearLayout>


    <View style="@style/myStyleViewSimpleHorizontalBar" />

    <LinearLayout style="@style/LinearLayoutOptionsVertical">
        <TextView
            style="@style/OptionTextDefaultFor"
            android:text="@string/default_for" />
        <TextView
            android:id="@+id/txtCopyFileHead"
            style="@style/OptionTitle"
            android:text="@string/option_copy_file_title"
            android:layout_marginTop="0dp"/>
        <TextView
            style="@style/OptionSubTitle"
            android:text="@string/option_copy_file_subtitle" />
        <LinearLayout style="@style/LayoutWrapContentMargin20horizontal"
            android:layout_height="wrap_content"
            android:id="@+id/ll_copy_file">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_copy_file"
                style="@style/OptionCheckBox"/>
            <TextView style="@style/OptionCheckBoxText"
                android:text="@string/option_copy_file_text"/>
        </LinearLayout>
        <TextView
            style="@style/OptionSubTitle"
            android:text="@string/option_copy_file_special_zip" />

    </LinearLayout>

    <View style="@style/myStyleViewSimpleHorizontalBar" />

    <LinearLayout style="@style/LinearLayoutOptionsVertical">
        <TextView
            style="@style/OptionTextDefaultFor"
            android:text="@string/default_for" />
        <TextView
            style="@style/OptionTitle"
            android:text="@string/option_delete_source_file_title"
            android:layout_marginTop="0dp"/>
        <TextView
            style="@style/OptionSubTitle"
            android:text="@string/option_delete_source_file_subtitle" />
        <LinearLayout style="@style/LayoutWrapContentMargin20horizontal"
            android:id="@+id/ll_delete_source_file">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_delete_source_file"
                style="@style/OptionCheckBox"/>
            <TextView
                android:id="@+id/txt_delete_source_file"
                style="@style/OptionCheckBoxText"
                android:text="@string/option_delete_source_file_text" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/myStyleViewSimpleHorizontalBar" />

    <LinearLayout style="@style/LinearLayoutOptionsVertical">
        <TextView
            style="@style/OptionTitle"
            android:text="@string/option_open_with_title" />
        <TextView
            style="@style/OptionSubTitle"
            android:text="@string/option_open_with_subtitle" />
        <LinearLayout style="@style/LayoutWrapContentMargin20horizontal"
            android:id="@+id/ll_open_with">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_open_with"
                style="@style/OptionCheckBox"/>
            <TextView
                android:id="@+id/txt_open_with"
                style="@style/OptionCheckBoxText"
                android:text="@string/option_open_with_text" />
        </LinearLayout>
        <LinearLayout style="@style/LayoutWrapContentMargin20horizontal"
            android:id="@+id/ll_open_with_all">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_open_with_all"
                style="@style/OptionCheckBox"/>
            <TextView
                android:id="@+id/txt_open_with_all"
                style="@style/OptionCheckBoxText"
                android:text="@string/option_open_with_text_all" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/myStyleViewSimpleHorizontalBar" />

    <LinearLayout
        android:id="@+id/ll_beep"
        style="@style/LinearLayoutOptionsVertical">
        <TextView
            style="@style/OptionTitle"
            android:text="@string/option_beep_title" />
        <LinearLayout
            style="@style/LinearLayoutOptionsCheckBoxHorizontal"
            android:id="@+id/ll_beep_chapter">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_beep_chapter"
                style="@style/OptionCheckBox"/>
            <TextView
                style="@style/OptionCheckBoxText"
                android:text="@string/option_beep_between_chapters" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_beep_autostop"
            style="@style/LinearLayoutOptionsCheckBoxHorizontal">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_beep_autostop"
                style="@style/OptionCheckBox"/>
            <TextView
                style="@style/OptionCheckBoxText"
                android:text="@string/option_beep_for_autostop" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_beep_bookend"
            style="@style/LinearLayoutOptionsCheckBoxHorizontal">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_beep_bookend"
                style="@style/OptionCheckBox"/>
            <TextView
                style="@style/OptionCheckBoxText"
                android:text="@string/option_beep_at_the_end" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/myStyleViewSimpleHorizontalBar" />

    <LinearLayout style="@style/LinearLayoutOptionsVertical">
        <TextView
            style="@style/OptionTitle"
            android:text="@string/option_rewind_after_pause_title" />
        <LinearLayout style="@style/LinearLayoutOptionsCheckBoxHorizontal"
            android:id="@+id/ll_rewind_after_pause">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_rewind_after_pause"
                style="@style/OptionCheckBox"/>
            <TextView
                style="@style/OptionCheckBoxText"
                android:text="@string/option_rewind_after_pause_text" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/myStyleViewSimpleHorizontalBar" />

    <LinearLayout style="@style/LinearLayoutOptionsVertical">
        <TextView
            android:id="@+id/txtLog"
            style="@style/OptionTitle"
            android:text="@string/option_log" />
        <TextView
            style="@style/OptionSubTitle"
            android:text="@string/option_tech_log_subtitle" />
        <LinearLayout style="@style/LayoutWrapContentMargin20horizontal"
            android:layout_height="wrap_content"
            android:id="@+id/ll_tech_log_file">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_tech_log_file"
                style="@style/OptionCheckBox"/>
            <TextView style="@style/OptionCheckBoxText"
                android:text="@string/option_tech_log_text"/>
        </LinearLayout>
    </LinearLayout>

    <View style="@style/myStyleViewSimpleHorizontalBar" />

    <LinearLayout
        android:id="@+id/ll_MailMethod_vert"
        style="@style/LinearLayoutOptionsVertical">
        <TextView
            style="@style/OptionTitle"
            android:text="@string/option_mail_method" />
        <LinearLayout
            android:id="@+id/ll_mail_method_default"
            style="@style/LinearLayoutOptionsCheckBoxHorizontal">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_mail_method_default"
                style="@style/OptionCheckBox"/>
            <TextView
                android:id="@+id/txt_mail_method_default"
                style="@style/OptionCheckBoxText"
                android:text="@string/option_mail_method_default" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/myStyleViewSimpleHorizontalBar" />




    <LinearLayout
        android:id="@+id/ll_Podcast"
        style="@style/LinearLayoutOptionsVertical">
        <TextView
            style="@style/OptionTextDefaultFor"
            android:text="@string/default_for" />
        <TextView
            style="@style/OptionTitle"
            android:text="@string/Podcasts" />
        <LinearLayout
            android:id="@+id/ll_AutoDownload"
            style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/Auto_Download"
                />
            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:text="@string/last"
                    />
                <EditText
                    style="@style/OptionPodcastEditText"
                    android:id="@+id/et_auto_download_last_n_episode"
                    />
                <TextView
                    style="@style/OptionPodcastTextAfterEditText"
                    android:text="@string/episodes"
                    />
            </LinearLayout>
            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:text="@string/for_max"
                    />
                <EditText
                    style="@style/OptionPodcastEditText"
                    android:id="@+id/et_auto_download_max_n_podcast"
                    />
                <TextView
                    style="@style/OptionPodcastTextAfterEditText"
                    android:text="@string/podcasts"
                    />
            </LinearLayout>
            <TextView
                android:text="Min = 1"
                style="@style/OptionMiniText" />
            <TextView
                android:text="Max = 100"
                style="@style/OptionMiniText" />
            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:text="@string/check_every"
                    />
                <EditText
                    style="@style/OptionPodcastEditText"
                    android:id="@+id/et_auto_download_delay_between_checks_in_min"
                    android:width="80dp"
                    />
                <TextView
                    style="@style/OptionPodcastTextAfterEditText"
                    android:text="@string/min."
                    />
            </LinearLayout>
            <TextView
                android:text="Min = 15"
                style="@style/OptionMiniText" />
            <TextView
                android:text="Max = 60x24  (1day = 1440min)"
                style="@style/OptionMiniText" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_AutoDelete"
            style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/Auto_Delete" />
            <LinearLayout
                android:id="@+id/ll_podcast_auto_delete"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_podcast_auto_delete"
                    style="@style/OptionCheckBox"/>
                <TextView
                    android:id="@+id/txt_podcast_auto_delete"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/auto_delete_episodes_once_listened_to" />
            </LinearLayout>

            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:text="@string/after"
                    />
                <EditText
                    style="@style/OptionPodcastEditText"
                    android:id="@+id/et_delay_deletion"
                    />
                <TextView
                    style="@style/OptionPodcastTextAfterEditText"
                    android:text="@string/days"
                    />
            </LinearLayout>
            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:text="@string/if_completion"
                    />
                <EditText
                    style="@style/OptionPodcastEditText"
                    android:id="@+id/et_percentage_deletion"
                    />
                <TextView
                    style="@style/OptionPodcastTextAfterEditText"
                    android:text="%"
                    />
            </LinearLayout>
            <TextView
                android:text="Min = 10"
                style="@style/OptionMiniText" />
            <TextView
                android:text="Max = 100"
                style="@style/OptionMiniText" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/myStyleViewSimpleHorizontalBar" />



</LinearLayout>
