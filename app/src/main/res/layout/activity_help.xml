<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    >
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="50dp"
        android:layout_marginStart="50dp"
        >

        <TextView style="@style/HelpTitle"
            android:text="@string/help_folder"
            />
        <TextView style="@style/HelpText"
            android:text="@string/help_folder_text"
            />
        <View style="@style/myStyleViewSimpleHorizontalBar"/>

        <TextView style="@style/HelpTitle"
            android:text="@string/help_file"
            />
        <TextView style="@style/HelpText"
            android:text="@string/help_file_text"
            />
        <View style="@style/myStyleViewSimpleHorizontalBar"/>

        <TextView style="@style/HelpTitle"
            android:text="@string/help_file_types_title"
            />
        <TextView style="@style/HelpText"
            android:text="@string/help_file_types_text"
            />
        <View style="@style/myStyleViewSimpleHorizontalBar"/>

        <TextView style="@style/HelpTitle"
            android:text="@string/help_import"
            />
        <TextView style="@style/HelpText"
            android:text="@string/help_import_text"
            />
        <View style="@style/myStyleViewSimpleHorizontalBar"/>

        <TextView style="@style/HelpTitle"
            android:text="@string/help_tellme"
            />
        <TextView style="@style/HelpText"
            android:text="@string/help_tellme_text"
            />
        <View style="@style/myStyleViewSimpleHorizontalBar"/>

        <TextView style="@style/HelpTitle"
            android:text="@string/help_trouble"
            />
        <TextView style="@style/HelpText"
            android:text="@string/help_trouble_text"
            />
        <View style="@style/myStyleViewSimpleHorizontalBar"/>


        <TextView style="@style/HelpTitle"
            android:text="@string/help_cachefiles"
            />
        <TextView style="@style/HelpText"
            android:text="@string/help_cachefiles_text"
            />

        <View style="@style/myStyleViewSimpleHorizontalBar"/>

        <TextView style="@style/HelpTitle"
            android:text="@string/help_permission"
            />
        <TextView style="@style/HelpText"
            android:text="@string/help_permission_text"
            />

        <View style="@style/myStyleViewSimpleHorizontalBar"/>

        <TextView style="@style/HelpTitle"
            android:text="@string/help_forum"
            />
        <TextView style="@style/HelpText"
            android:text="@string/help_forum_text"
            />
        <View style="@style/myStyleViewSimpleHorizontalBar"
            android:layout_marginBottom="30dp"
            />


    </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>