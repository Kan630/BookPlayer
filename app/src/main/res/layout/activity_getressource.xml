<?xml version="1.0" encoding="utf-8"?>
<!-- Mini // Fait pour logicom LeHello - ideal 480x800 WVGA   -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true"
    tools:context=".activities.MainActivity"
    >
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <!-- Progress bar overlay; shown while login is in progress -->
    <include layout="@layout/include_progressbar_overlay"/>

    <TextView
        android:id="@+id/TextHeaderOpen"
        style="@style/GetResourceTextSectionTitle"
        android:text="@string/TextHeaderOpen"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/message_import_currently_running"
        style="@style/GetResourceTextTopOfButton"
        android:text="@string/Import_Progress_onGoing"
        android:textSize="40sp"
        android:textColor="@color/red"
        android:background="@color/yellow"
        android:visibility="invisible"
        android:elevation="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/GetRessource320_vertical_margin_title2text"
        android:paddingHorizontal="50dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bOpenFolder"
        />
    <TextView
        android:id="@+id/bOpenFile_desc"
        style="@style/GetResourceTextTopOfButton"
        android:text="@string/bOpenFile_desc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/TextHeaderOpen"
        />

    <Button
        android:id="@+id/bOpenFile"
        android:text="@string/bOpenFile"
        style="@style/GetResourceButton"
        android:layout_marginTop="@dimen/GetRessource320_vertical_margin_text2button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bOpenFile_desc"
        />
    <TextView
        android:id="@+id/bOpenFolder_desc"
        style="@style/GetResourceTextTopOfButton"
        android:text="@string/bOpenFolder_desc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bOpenFile"
        />

    <Button
        android:id="@+id/bOpenFolder"
        android:text="@string/bOpenFolder"
        style="@style/GetResourceButton"
        android:layout_marginTop="@dimen/GetRessource320_vertical_margin_text2button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bOpenFolder_desc"
        />

    <TextView
        android:id="@+id/bOpenZiFile_desc"
        style="@style/GetResourceTextTopOfButton"
        android:text="@string/bOpenZipFile_desc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bOpenFolder"
        />

    <Button
        android:id="@+id/bOpenZipFile"
        android:text="@string/bOpenZipFile"
        style="@style/GetResourceButton"
        android:layout_marginTop="@dimen/GetRessource320_vertical_margin_text2button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bOpenZiFile_desc"
        />

    <View style="@style/myStyleViewSimpleHorizontalBar"
        android:layout_marginBottom="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toTopOf="@id/TextHeaderSearch"/>

    <TextView
        android:id="@+id/TextHeaderSearch"
        android:text="@string/TextHeaderSearch"
        style="@style/GetResourceTextSectionTitle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bOpenZipFile"
        />

    <TextView
        android:id="@+id/bSearchLibrivox_desc"
        android:text="@string/bSearchLibrivox_desc"
        style="@style/GetResourceTextTopOfButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/TextHeaderSearch"
        />

    <Button
        android:id="@+id/bSearchLibrivox"
        android:text="@string/bSearchLibrivox"
        style="@style/GetResourceButton"
        android:layout_marginTop="@dimen/GetRessource320_vertical_margin_text2button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bSearchLibrivox_desc"
        />

    <TextView
        android:id="@+id/bSearchlitteratureaudio_desc"
        style="@style/GetResourceTextTopOfButton"
        android:text="@string/bSearchlitteratureaudio_desc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bSearchLibrivox"
        />

    <Button
        android:id="@+id/bSearchLitteratureaudio"
        android:text="@string/bSearchLitteratureaudio"
        style="@style/GetResourceButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bSearchlitteratureaudio_desc"
        />

    <TextView
        android:id="@+id/bSearchGutenberg_desc"
        style="@style/GetResourceTextTopOfButton"
        android:text="@string/bSearchGutenberg_desc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bSearchLitteratureaudio"
        />

    <Button
        android:id="@+id/bSearchGutenberg"
        android:text="@string/gutenberg_project"
        style="@style/GetResourceButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bSearchGutenberg_desc"
        />

    <TextView
        android:id="@+id/bSearchExempleText"
        style="@style/GetResourceTextTopOfButton"
        android:text="@string/bSearchExampleText"
        android:textStyle="italic"
        android:textSize="12sp"
        android:layout_marginStart="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bSearchGutenberg"
        />

    <View style="@style/myStyleViewSimpleHorizontalBar"
        android:layout_marginBottom="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtAutoTest_title"
        />

    <TextView
        android:id="@+id/txtAutoTest_title"
        android:text="@string/AutoTest_title"
        style="@style/GetResourceTextSectionTitle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bSearchExempleText"
        />

    <TextView
        android:id="@+id/txtAutoTest_desc"
        android:text="@string/AutoTest_desc"
        style="@style/GetResourceTextTopOfButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtAutoTest_title"
        />

    <Button
        android:id="@+id/bAutoTest_b1"
        android:text="@string/AutoTest_b1_text"
        style="@style/GetResourceButton"
        android:layout_marginTop="@dimen/GetRessource320_vertical_margin_text2button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtAutoTest_desc"
        />

    <Button
        android:id="@+id/bAutoTest_b2"
        android:text="@string/AutoTest_b2_text"
        style="@style/GetResourceButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bAutoTest_b1"
        />
    <Button
        android:id="@+id/bAutoTest_b3"
        android:text="@string/AutoTest_b3_text"
        style="@style/GetResourceButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bAutoTest_b2"
        />


</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>