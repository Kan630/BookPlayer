<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivWelcomeLogo"
            android:src="@mipmap/ic_launcher"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp" />

        <!-- App name -->
        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:text="@string/welcome_title"
            style="@style/simpleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:text="@string/welcome_subtitle"
            style="@style/simpleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:gravity="center"
            android:alpha="0.8"
            android:layout_marginBottom="24dp" />

        <!-- Divider -->
        <View
            android:layout_width="56dp"
            android:layout_height="1dp"
            android:alpha="0.2"
            android:layout_marginBottom="24dp" />

        <!-- Features / guidance block -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <!-- Row 1: Add a book -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:src="@drawable/ic_add_book_24"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:text="@string/welcome_item_add_book"
                    style="@style/simpleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Row 2: Browse free audiobooks -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:src="@drawable/ic_librivox_24"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:text="@string/welcome_item_librivox"
                    style="@style/simpleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Row 3: Podcasts & radio -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:src="@drawable/ic_radio_24px"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:text="@string/welcome_item_podcasts_radio"
                    style="@style/simpleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Primary call-to-action -->
        <Button
            android:id="@+id/btnWelcomeAddBook"
            android:text="@string/welcome_button_add"
            style="@style/simpleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp" />

        <!-- Small hint at the bottom -->
        <TextView
            android:id="@+id/tvWelcomeHint"
            android:text="@string/welcome_hint"
            style="@style/simpleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:gravity="center"
            android:alpha="0.7" />

    </LinearLayout>

</ScrollView>
