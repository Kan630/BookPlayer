<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/scrollView">

    <LinearLayout
        android:id="@+id/ll_Podcast"
        style="@style/LinearLayoutOptionsVertical"
        android:layout_marginTop="0dp"
        android:padding="8dp">

        <LinearLayout android:id="@+id/ll_title" style="@style/wideLinearLayout_Vertical">
            <View style="@style/myStyleViewSimpleHorizontalBar" />
            <TextView android:text="@string/Podcast_Settings" style="@style/OptionMasterTitle"/>
            <View style="@style/myStyleViewSimpleHorizontalBar" />
        </LinearLayout>

        <!-- Navigation -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
        <LinearLayout style="@style/SettingsGroupCardContent">
            <TextView
                style="@style/SettingsGroupTitle"
                android:text="@string/Navigation"
                 />
            <TextView
                style="@style/OptionSubTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/option_podcast_landing_screen" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/groupPodcastLandingScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/MaterialButtonForToggleGroup"
                    android:id="@+id/btnPodcastLandingSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/Search" />

                <com.google.android.material.button.MaterialButton
                    style="@style/MaterialButtonForToggleGroup"
                    android:id="@+id/btnPodcastLandingFavorites"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/Favorites" />

                <com.google.android.material.button.MaterialButton
                    style="@style/MaterialButtonForToggleGroup"
                    android:id="@+id/btnPodcastLandingHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/History" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <TextView
                android:id="@+id/tvPodcastLandingScreenSubtitle"
                style="@style/OptionExplainText"
                android:text="@string/option_podcast_landing_screen_subtitle"
                android:layout_marginBottom="5dp" />
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Search -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
        <LinearLayout
            android:id="@+id/ll_Search"
            style="@style/SettingsGroupCardContent">

            <TextView
                style="@style/SettingsGroupTitle"
                android:text="@string/Search" />
            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:text="@string/return_max"
                    />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.BookPlayer.TextInputLayout.Compact"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="24sp"
                        android:id="@+id/et_librivox_api_nb_results"
                        />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/OptionPodcastTextAfterEditText"
                    android:text="@string/podcasts"
                    />
            </LinearLayout>
            <TextView
                android:text="Min = 20"
                style="@style/OptionMiniText" />
            <TextView
                android:text="Max = 1000"
                style="@style/OptionMiniText" />
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Specific view -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
        <LinearLayout style="@style/SettingsGroupCardContent">
            <TextView
                style="@style/SettingsGroupTitle"
                android:text="@string/Specific_view" />

            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:id="@+id/ll_podcast_open_specific_view"
                android:layout_marginTop="0dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_podcast_open_specific_view"
                    style="@style/OptionCheckBox" />

                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_podcast_open_specific_view" />
            </LinearLayout>
            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_podcast_open_specific_view_subtitle"
                android:layout_marginBottom="5dp" />
            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_podcast_open_specific_view_subtitle2"
                android:layout_marginBottom="5dp" />

            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:id="@+id/ll_podcast_episodes_expand"
                android:layout_marginTop="0dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_podcast_episodes_expand"
                    style="@style/OptionCheckBox" />

                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_podcast_episodes_expand" />

                <ImageButton
                    android:id="@+id/ib_podcast_episodes_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_content_expand_24"
                    android:background="@android:color/transparent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <TextView
                style="@style/OptionTextDefaultFor"
                android:layout_marginTop="10dp"
                android:text="@string/default_for" />

            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:id="@+id/ll_podcast_episodes_sort_order"
                android:layout_marginTop="0dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_podcast_episodes_sort_order"
                    style="@style/OptionCheckBox" />

                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_podcast_episodes_sort_order" />

                <ImageButton
                    android:id="@+id/ib_podcast_episodes_sort_order"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_sort_swap_vert_24"
                    android:background="@android:color/transparent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp" />
            </LinearLayout>
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Download -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
        <LinearLayout
            android:id="@+id/ll_Download"
            style="@style/SettingsGroupCardContent">

            <TextView
                style="@style/SettingsGroupTitle"
                android:text="@string/download_noun" />

            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:id="@+id/ll_podcast_add_date_to_episode_name"
                android:layout_marginTop="0dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_podcast_add_date_to_episode_name"
                    style="@style/OptionCheckBox" />

                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_podcast_chk_podcast_add_date_to_episode_name" />

            </LinearLayout>

        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Auto Download -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
        <LinearLayout
            android:id="@+id/ll_AutoDownload"
            style="@style/SettingsGroupCardContent">

            <LinearLayout
                style="@style/simpleLinearLayout_Horizontal"
                android:layout_marginBottom="5dp">

                <TextView
                    style="@style/SettingsGroupTitle"
                    android:text="@string/Auto_Download"
                    android:layout_marginBottom="0dp" />

                <ImageButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_download_action_24"
                    android:background="@android:color/transparent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>
            <TextView
                style="@style/OptionSubTitle"
                android:text="@string/option_podcast_autodownload_subtitle"
                android:layout_marginBottom="5dp"
                />

            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:text="@string/last"
                    />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.BookPlayer.TextInputLayout.Compact"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="24sp"
                        android:id="@+id/et_auto_download_last_n_episode"
                        />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/OptionPodcastTextAfterEditText"
                    android:text="@string/episodes"
                    />
            </LinearLayout>
            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:text="@string/for_max"
                    />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.BookPlayer.TextInputLayout.Compact"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="24sp"
                        android:id="@+id/et_auto_download_max_n_podcast"
                        />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/OptionPodcastTextAfterEditText"
                    android:text="@string/podcasts"
                    />
            </LinearLayout>
            <TextView
                android:text="Min = 1"
                style="@style/OptionMiniText" />
            <TextView
                android:text="Max = 100"
                style="@style/OptionMiniText" />
            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:text="@string/check_every"
                    />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.BookPlayer.TextInputLayout.Compact"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="24sp"
                        android:id="@+id/et_auto_download_delay_between_checks_in_min"
                        />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/OptionPodcastTextAfterEditText"
                    android:text="@string/min."
                    />
            </LinearLayout>
            <TextView
                android:text="Min = 15"
                style="@style/OptionMiniText" />
            <TextView
                android:text="Max = 1440  (= 1day = 60x24 min)"
                style="@style/OptionMiniText" />
        </LinearLayout>
        <LinearLayout style="@style/LinearLayoutOptionsCheckBoxHorizontal"
            android:id="@+id/ll_podcast_autodownloaded_at_the_top">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_podcast_autodownloaded_at_the_top"
                style="@style/OptionCheckBox"/>
            <TextView
                style="@style/OptionCheckBoxText"
                android:text="@string/option_podcast_autodownloaded_at_the_top" />
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Auto Delete -->
        <com.google.android.material.card.MaterialCardView style="@style/SettingsGroupCard">
        <LinearLayout
            android:id="@+id/ll_AutoDelete"
            style="@style/SettingsGroupCardContent">
            <TextView
                style="@style/SettingsGroupTitle"
                android:text="@string/Auto_Delete" />
            <LinearLayout
                android:id="@+id/ll_podcast_auto_delete"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_podcast_auto_delete"
                    style="@style/OptionCheckBox"/>
                <TextView
                    android:id="@+id/txt_podcast_auto_delete"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/auto_delete_episodes_once_listened_to" />
            </LinearLayout>

            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:text="@string/after"
                    />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.BookPlayer.TextInputLayout.Compact"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="24sp"
                        android:id="@+id/et_delay_deletion"
                        />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/OptionPodcastTextAfterEditText"
                    android:text="@string/days"
                    />
            </LinearLayout>
            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:text="@string/if_completion"
                    />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.BookPlayer.TextInputLayout.Compact"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="24sp"
                        android:id="@+id/et_percentage_deletion"
                        />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/OptionPodcastTextAfterEditText"
                    android:text="%"
                    />
            </LinearLayout>
            <TextView
                android:text="Min = 10"
                style="@style/OptionMiniText" />
            <TextView
                android:text="Max = 100"
                style="@style/OptionMiniText" />
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
