<?xml version="1.0" encoding="utf-8"?>
<!-- Single-pane settings: category list only, tapping a category navigates to it full screen.
     Two-pane variant: fragment_settings_category_list_two_pane (aliased for width >= 720dp). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/settings_category_list_content" />

    <!-- Never shown here; only exists so a detail fragment restored from the two-pane layout
         (window shrank below 720dp) has a container to land in before it gets removed. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/settings_detail_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
