<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Network status row (same include as other activities) -->
        <include
            android:id="@+id/includeNetworkStatus"
            layout="@layout/view_network_status_row" />

        <LinearLayout
            style="@style/simpleLinearLayout_Horizontal"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="10dp"
            android:layout_width="match_parent"
            >
            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginStart="50dp"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cover_preview"
                android:src="@drawable/ic_radio_24px" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                style="@style/simpleLinearLayout_Vertical"
                android:layout_gravity="center"
                >
                <ImageButton
                    android:id="@+id/ibFavorite"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_gravity="end"
                    android:src="@drawable/ic_favorite"
                    android:contentDescription="@string/favorite"
                    />
                <ImageButton
                    android:id="@+id/ibVote"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_gravity="end"
                    android:src="@drawable/ic_thumb_up_24px"
                    android:contentDescription="@string/favorite"
                    />
                <ImageButton
                    android:id="@+id/ibShare"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_gravity="end"
                    android:src="@drawable/ic_share_24px"
                    android:contentDescription="@string/favorite"
                    />
            </LinearLayout>
        </LinearLayout>

        <!-- Name -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Small subtitle with country / language -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Info block -->
        <LinearLayout
            android:id="@+id/infoBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTagLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="@string/tags" />

            <TextView
                android:id="@+id/tvTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvUrlLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="@string/stream_url" />

            <TextView
                android:id="@+id/tvUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvHomepageLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="@string/homepage" />

            <TextView
                android:id="@+id/tvHomepage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:text="@string/miscellaneous" />
                />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
