<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/ll_backup_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:id="@+id/tv_full_backup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/backup_screen_title"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_full_backup_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/full_backup_desc" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/group_backup_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                style="@style/MaterialButtonForToggleGroup"
                android:id="@+id/btn_scope_full"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="@string/backup_scope_full_title" />

            <com.google.android.material.button.MaterialButton
                style="@style/MaterialButtonForToggleGroup"
                android:id="@+id/btn_scope_partial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="@string/backup_scope_partial_title" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tv_backup_scope_explain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />

        <LinearLayout
            android:id="@+id/ll_partial_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/cb_partial_preferences"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_export_include_prefs" />

            <CheckBox
                android:id="@+id/cb_partial_radios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_export_include_radios" />

            <CheckBox
                android:id="@+id/cb_partial_podcasts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_export_include_podcasts" />

            <CheckBox
                android:id="@+id/cb_partial_librivox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_export_include_librivox" />

            <CheckBox
                android:id="@+id/cb_partial_book_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_export_include_book_progress" />

            <CheckBox
                android:id="@+id/cb_partial_podcast_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/import_export_include_podcast_history" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="?android:attr/listDivider" />

            <CheckBox
                android:id="@+id/cb_partial_include_book_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_include_book_files_title" />

            <TextView
                android:id="@+id/tv_include_book_files_explain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/backup_include_book_files_explain"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />

            <ProgressBar
                android:id="@+id/progress_loading_books"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="start"
                android:indeterminate="true"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_backup_books"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:listitem="@layout/item_backup_book" />

            <TextView
                android:id="@+id/tv_no_books_available"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_no_books_available"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_full_backup_size_needed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

        <TextView
            android:id="@+id/tv_full_backup_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/group_backup_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                style="@style/MaterialButtonForToggleGroup"
                android:id="@+id/btn_dest_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:icon="@drawable/ic_file_save"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                android:text="@string/backup_destination_file" />

            <com.google.android.material.button.MaterialButton
                style="@style/MaterialButtonForToggleGroup"
                android:id="@+id/btn_dest_quick_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:icon="@drawable/ic_connect_without_contact_24px"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                android:text="@string/backup_destination_quick_share" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tv_backup_destination_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:text="@string/backup_destination_size_warning"
            android:textColor="@color/orange_700"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_warning_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_full_backup"
            style="@style/Widget.BookPlayer.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/full_backup_start"
            app:icon="@drawable/ic_file_save" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_restore_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:id="@+id/tv_full_restore_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/restore_screen_title"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_full_restore_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/full_restore_desc" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/group_restore_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                style="@style/MaterialButtonForToggleGroup"
                android:id="@+id/btn_restore_src_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:icon="@drawable/ic_check_24px"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                android:text="@string/restore_source_pick_file" />

            <com.google.android.material.button.MaterialButton
                style="@style/MaterialButtonForToggleGroup"
                android:id="@+id/btn_restore_src_quick_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:icon="@drawable/ic_connect_without_contact_24px"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                android:text="@string/backup_destination_quick_share" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_full_restore"
            style="@style/Widget.BookPlayer.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/full_restore_pick_file"
            app:icon="@drawable/ic_check_24px" />

        <LinearLayout
            android:id="@+id/ll_restore_reading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="start"
                android:indeterminate="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/full_restore_reading"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
        </LinearLayout>

        <!-- Populated from the picked zip's own contents before the caution popup, so the user
             knows what they're about to overwrite their library with - not the live estimate
             above, which reflects THIS device's current library, not the backup file's. -->
        <LinearLayout
            android:id="@+id/ll_restore_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_restore_preview_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/full_restore_preview_title"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_restore_preview_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

            <TextView
                android:id="@+id/tv_restore_preview_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

            <TextView
                android:id="@+id/tv_restore_preview_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

            <TextView
                android:id="@+id/tv_restore_preview_contents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_restore_preview"
                style="@style/Widget.BookPlayer.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/import_export_btn_restore" />

            <Button
                android:id="@+id/btn_cancel_restore_preview"
                style="@style/Widget.BookPlayer.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:text="@android:string/cancel" />

        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_full_backup_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress_full_backup"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:id="@+id/tv_full_backup_progress_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />

            <TextView
                android:id="@+id/tv_full_backup_eta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />

            <Button
                android:id="@+id/btn_cancel_full_backup_operation"
                style="@style/Widget.BookPlayer.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:text="@android:string/cancel" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_full_backup_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
