<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    style="@style/MainContainer">


<LinearLayout
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/MainContainer"
    >

    <TextView
        style="@style/ExportProgressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/StillExperimental"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/orange"
        android:layout_marginTop="20dp"
        android:layout_marginStart="40dp"
        />

    <TextView
        android:id="@+id/tvExportTitle"
        style="@style/ExportTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Export audiobook:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="30dp"
        />

    <TextView
        android:id="@+id/tvExportAudioBookName"
        style="@style/ExportTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="audiobook name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/pastel_blue_300"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="20dp"
        />

    <View style="@style/GetResourceHorizontalBar"/>
    <TextView
        style="@style/simpleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="destination folder :"
        android:textSize="20sp"
        android:layout_marginBottom="15dp"
        android:layout_marginTop="10dp"
        />
    <Button
        android:id="@+id/b_destinationFolder"
        style="@style/GetResourceButton"
        android:text="Download folder"
        android:layout_marginBottom="5dp"
        />
    <TextView
        style="@style/simpleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="destination file name :"
        android:textSize="20sp"
        android:layout_marginBottom="15dp"
        android:layout_marginTop="10dp"
        />
    <EditText
        android:id="@+id/etDestinationFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/EditText"
        />


    <View style="@style/GetResourceHorizontalBar"/>



    <TextView
        android:id="@+id/tvCurrentTrack"
        style="@style/ExportProgressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zipping: "
        android:textSize="16sp"
        android:layout_marginBottom="28dp" />

    <ProgressBar
        android:id="@+id/progressBarExport"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_bar_theme"
        android:layout_marginBottom="8dp" />


    <TextView
        android:id="@+id/tvProgressText"
        style="@style/ExportProgressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Progress info..."
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="40dp"
        />

    <LinearLayout
        style="@style/LinearLayoutOptionsCheckBoxHorizontal"
        android:gravity="center"
        android:layout_width="match_parent">

        <Button
            android:id="@+id/btnCancelExport"
            style="@style/GetResourceButton"
            android:text="Cancel" />

        <Button
            android:id="@+id/btnStartExport"
            style="@style/GetResourceButton"
            android:text="Start Export" />

    </LinearLayout>

</LinearLayout>
</ScrollView>