<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer"
    >

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp"
        >

        <!-- Storage selection: only shown with an SD card (CleanMemoryFragment.setupRadioButtons) -->
        <RadioGroup
            android:id="@+id/storage_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            >

            <RadioButton
                android:id="@+id/radio_internal"
                style="@style/simpleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device" />

            <RadioButton
                android:id="@+id/radio_sdcard"
                style="@style/simpleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/SD_card" />
        </RadioGroup>

        <!-- Storage Stats: fixed height so autosize shrinks text until all 3 lines fit on one line each -->
        <!-- Refresh sits in the banner's corner: no row of its own (it used to cost a whole line) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/cachefiles_stats_text"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:minHeight="72dp"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textColor="?attr/colorOnPrimary"
                android:gravity="start"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingEnd="44dp"
                android:lineSpacingMultiplier="0.5"
                android:background="?attr/colorPrimary"
                android:text="mem stats..."
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                />

            <ImageButton
                android:id="@+id/btn_clean_memory_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="2dp"
                android:contentDescription="@string/refresh"
                android:src="@drawable/ic_refresh_24"
                app:tint="?attr/colorOnPrimary"
                android:background="?attr/selectableItemBackgroundBorderless"
                />
        </FrameLayout>

        <!-- Cache Files List + Empty state -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            >
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView_cacheFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="?android:attr/listDivider"
                android:dividerHeight="1dp" />
            <TextView
                android:id="@+id/empty_list_message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:textSize="16sp"
                android:visibility="gone"
                />
        </FrameLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/progress_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone"
        >
        <ProgressBar
            android:id="@+id/progress_cache_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            />
        <TextView
            android:id="@+id/progress_scan_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:textSize="14sp"
            android:visibility="gone"
            />
    </LinearLayout>
</FrameLayout>