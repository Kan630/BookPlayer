<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    style="@style/MainContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Ongoing task banner container -->
        <FrameLayout
            android:id="@+id/topOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp" />

        <!-- Your original scrollable content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginVertical="16dp"
                    android:padding="24dp">

                    <ImageButton
                        android:id="@+id/bOpenOtherIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_memory_general_smartphone"
                        android:scaleType="centerInside"
                        android:background="@android:color/transparent"
                        app:tint="?attr/colorOnSurface"
                        android:layout_marginEnd="20dp" />

                    <Button
                        android:id="@+id/bOpenOther"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_other"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        style="@style/Widget.MaterialComponents.Button" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginVertical="16dp"
                    android:padding="24dp">

                    <ImageButton
                        android:id="@+id/bOpenAudiobooksIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_librivox_24"
                        android:background="@android:color/transparent"
                        app:tint="?attr/colorOnSurface"
                        android:layout_marginEnd="20dp" />

                    <Button
                        android:id="@+id/bOpenAudiobooks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_audiobooks"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        style="@style/Widget.MaterialComponents.Button" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginVertical="16dp"
                    android:padding="24dp">

                    <ImageButton
                        android:id="@+id/bOpenPodcastsIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_podcast_24"
                        android:background="@android:color/transparent"
                        android:layout_marginEnd="20dp" />

                    <Button
                        android:id="@+id/bOpenPodcasts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_podcasts"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        style="@style/Widget.MaterialComponents.Button" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
