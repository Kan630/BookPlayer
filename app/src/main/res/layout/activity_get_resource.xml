<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    tools:context=".activities.MainActivity"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="?android:attr/windowBackground">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="24dp"
            android:background="?android:attr/windowBackground">

            <ImageButton
                android:id="@+id/bOpenPodcastsIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_podcast_24"
                android:background="@android:color/transparent"
                app:tint="@android:color/white"
                android:layout_marginEnd="20dp"
                />


            <Button
                android:id="@+id/bOpenPodcasts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_podcasts"
                android:layout_marginBottom="32dp"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="24dp"
            android:background="?android:attr/windowBackground">

            <ImageButton
                android:id="@+id/bOpenAudiobooksIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_librivox_24"
                android:background="@android:color/transparent"
                app:tint="@android:color/white"
                android:layout_marginEnd="20dp"
                />


            <Button
                android:id="@+id/bOpenAudiobooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_audiobooks"
                android:layout_marginBottom="32dp"
                android:backgroundTint="?attr/colorSecondary"
                android:textColor="?attr/colorOnSecondary"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="24dp"
            android:background="?android:attr/windowBackground">

            <ImageButton
                android:id="@+id/bOpenOtherIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_memory_general_smartphone"
                android:scaleType="centerInside"
                android:background="@android:color/transparent"
                app:tint="@android:color/white"
                android:layout_marginEnd="20dp"
                />


            <Button
                android:id="@+id/bOpenOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_other"
                android:backgroundTint="?attr/colorPrimaryVariant"
                android:textColor="?attr/colorOnPrimary"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>