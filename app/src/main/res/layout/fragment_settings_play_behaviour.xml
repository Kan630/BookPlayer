<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root_container"
        style="@style/LinearLayoutOptionsVertical"
        android:padding="8dp">

        <LinearLayout android:id="@+id/ll_title" style="@style/wideLinearLayout_Vertical">
            <View style="@style/myStyleViewSimpleHorizontalBar" />
            <TextView android:text="@string/option_playing_behaviour_title" style="@style/OptionMasterTitle"/>
            <View style="@style/myStyleViewSimpleHorizontalBar" />
        </LinearLayout>

        <!-- Time before sleep -->
        <LinearLayout style="@style/LinearLayoutOptionsVertical"
            android:layout_marginTop="0dp"
            >
            <TextView
                style="@style/OptionTitle"
                android:layout_marginTop="0dp"
                android:text="@string/option_timeBeforeSleep" />

            <LinearLayout
                android:id="@+id/ll_autosleep_horizon"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">

                <TextView
                    style="@style/simpleTextWrap"
                    android:layout_marginStart="50sp"
                    android:text="@string/option_timeBeforeSleep_text"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/etTimeBeforeSleep"
                    style="@style/EditText"
                    android:layout_height="wrap_content"
                    android:layout_width="70sp"
                    android:inputType="number"
                    android:paddingStart="4sp"
                    android:paddingEnd="4sp"
                    android:textAlignment="textEnd"
                    android:textSize="24sp" />

                <TextView
                    style="@style/simpleTextWrap"
                    android:text="@string/min."
                    android:textSize="24sp" />
            </LinearLayout>

            <TextView android:text="Min = 1" style="@style/OptionMiniText" />
            <TextView android:text="Max = 1440 (24h)" style="@style/OptionMiniText" />
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <!-- Backward/Forward seconds -->
        <LinearLayout
            android:id="@+id/ll_BackwardForward_vert"
            style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_backward_forward_title" />

            <LinearLayout
                android:id="@+id/ll_BackwardForward_horizon"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">

                <TextView
                    style="@style/simpleTextWrap"
                    android:layout_marginStart="50sp"
                    android:text="@string/option_backward_forward_text"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/etForwardSeconds"
                    style="@style/EditText"
                    android:layout_height="wrap_content"
                    android:layout_width="70sp"
                    android:inputType="number"
                    android:paddingStart="4sp"
                    android:paddingEnd="4sp"
                    android:textAlignment="textEnd"
                    android:textSize="24sp" />

                <TextView
                    style="@style/simpleTextWrap"
                    android:text="sec."
                    android:textSize="24sp" />
            </LinearLayout>

            <TextView android:text="Min = 1" style="@style/OptionMiniText" />
            <TextView android:text="Max = 300 (5min)" style="@style/OptionMiniText" />
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <TextView
            style="@style/OptionTitle"
            android:text="@string/Track_View" />

        <TextView style="@style/betatest"/>
        <LinearLayout
            style="@style/LinearLayoutOptionsCheckBoxHorizontal"
            android:id="@+id/ll_use_heatmap_for_tracks_activity"
            android:layout_marginTop="0dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_use_heatmap_for_tracks_activity"
                style="@style/OptionCheckBox" />

            <TextView
                style="@style/OptionCheckBoxText"
                android:text="@string/option_use_heatmap_for_tracks_activity" />
        </LinearLayout>
        <TextView
            style="@style/OptionExplainText"
            android:text="@string/option_use_heatmap_for_tracks_activity_subtitle"
            android:layout_marginBottom="5dp"
            />

        <LinearLayout
            android:id="@+id/ll_open_play_activity"
            style="@style/LinearLayoutOptionsCheckBoxHorizontal">
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chk_open_play_activity"
                style="@style/OptionCheckBox" />
            <TextView
                style="@style/OptionCheckBoxText"
                android:text="@string/option_open_play_activity" />
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <LinearLayout style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_play_view"
                />
            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_play_view_explain"
                />

            <LinearLayout
                android:id="@+id/ll_lock_orientation_play_activity"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_lock_orientation_play_activity"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_lock_orientation_play_activity" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_use_heatmap_seekbar_in_play_activity"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_use_heatmap_seekbar_in_play_activity"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_use_heatmap_seekbar_in_play_activity" />
            </LinearLayout>
            <TextView
                style="@style/OptionExplainText"
                android:text="@string/option_use_heatmap_seekbar_in_play_activity_explain"
                android:layout_marginBottom="5dp" />

            <LinearLayout
                android:id="@+id/ll_visualizer_playpause"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_click_visualizer_playpause"
                    style="@style/OptionCheckBox" />
                <TextView
                    android:id="@+id/tx_click_visualizer_playpause"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_click_container_playpause_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_visualizer_on"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_visualizer_on"
                    style="@style/OptionCheckBox" />
                <TextView
                    android:id="@+id/tx_Visualizer_on"
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_visualizer_text_01" />
            </LinearLayout>

            <TextView style="@style/betatest"
                android:text="@string/All_modes_except_Legacy_are_in_beta"
                />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/groupVisualizerMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:padding="8dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVisualizerLegacy"
                    style="@style/MaterialButtonForToggleGroup"
                    android:text="@string/legacy"
                    app:cornerRadius="16dp"
                    app:checkedIcon="@drawable/ic_check_24px"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVisualizerWave"
                    style="@style/MaterialButtonForToggleGroup"
                    android:text="@string/wave"
                    app:cornerRadius="16dp"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVisualizerBars"
                    style="@style/MaterialButtonForToggleGroup"
                    android:text="@string/bars"
                    app:cornerRadius="16dp"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVisualizerRadial"
                    style="@style/MaterialButtonForToggleGroup"
                    android:text="@string/radial"
                    app:cornerRadius="16dp"
                    />

            </com.google.android.material.button.MaterialButtonToggleGroup>


        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <!-- Screensaver -->
        <LinearLayout style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_screensaver_title" />

            <TextView style="@style/betatest"/>

            <LinearLayout
                android:id="@+id/ll_screensaver_enabled"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_screensaver_enabled"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_screensaver_enabled" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_screensaver_delay"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:gravity="center"
                android:layout_width="match_parent">

                <TextView
                    style="@style/simpleTextWrap"
                    android:layout_marginStart="50sp"
                    android:text="@string/option_screensaver_delay_text"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/etScreensaverDelay"
                    style="@style/EditText"
                    android:layout_height="wrap_content"
                    android:layout_width="70sp"
                    android:inputType="number"
                    android:paddingStart="4sp"
                    android:paddingEnd="4sp"
                    android:textAlignment="textEnd"
                    android:textSize="24sp" />
                
                <TextView
                    style="@style/simpleTextWrap"
                    android:text="sec."
                    android:textSize="24sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvScreensaverDelayMin"
                android:text="Min = 10" 
                style="@style/OptionMiniText" />
            <TextView 
                android:id="@+id/tvScreensaverDelayMax"
                android:text="Max = 300 (5min)" 
                style="@style/OptionMiniText" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/groupVisualizerScreenSaverMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:padding="8dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisualizerScreenSaverLegacy"
                style="@style/MaterialButtonForToggleGroup"
                android:text="@string/legacy"
                app:cornerRadius="16dp"
                app:checkedIcon="@drawable/ic_check_24px"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisualizerScreenSaverWave"
                style="@style/MaterialButtonForToggleGroup"
                android:text="@string/wave"
                app:cornerRadius="16dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisualizerScreenSaverBars"
                style="@style/MaterialButtonForToggleGroup"
                android:text="@string/bars"
                app:cornerRadius="16dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisualizerScreenSaverRadial"
                style="@style/MaterialButtonForToggleGroup"
                android:text="@string/radial"
                app:cornerRadius="16dp"
                />

        </com.google.android.material.button.MaterialButtonToggleGroup>


        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <!-- Beeps -->

        <LinearLayout
            android:id="@+id/ll_beep"
            style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_beep_title" />

            <LinearLayout
                android:id="@+id/ll_beep_chapter"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_beep_chapter"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_beep_between_chapters" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_beep_autostop"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_beep_autostop"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_beep_for_autostop" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_beep_bookend"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_beep_bookend"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_beep_at_the_end" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <!-- Positioning -->
        <LinearLayout style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_positioning_title" />

            <LinearLayout
                android:id="@+id/ll_rewind_after_pause"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_rewind_after_pause"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_rewind_after_pause_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_start_next_track_at_zero"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_start_next_track_at_zero"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_start_next_track_at_zero_title_text" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

        <!-- If app closed -->
        <LinearLayout style="@style/LinearLayoutOptionsVertical">
            <TextView
                style="@style/OptionTitle"
                android:text="@string/option_if_app_close_title" />
            <LinearLayout
                android:id="@+id/ll_stop_audio_if_user_closes_app"
                style="@style/LinearLayoutOptionsCheckBoxHorizontal">
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/chk_stop_audio_if_user_closes_app"
                    style="@style/OptionCheckBox" />
                <TextView
                    style="@style/OptionCheckBoxText"
                    android:text="@string/option_stop_audio_if_user_closes_app_text" />
            </LinearLayout>

    </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />
    </LinearLayout>
</ScrollView>
