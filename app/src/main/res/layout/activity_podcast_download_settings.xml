<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainContainer"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivDownloadSettingsPodcastCover"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDownloadSettingsTitle"
                        style="@style/simpleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:alpha="0.7"
                        android:text="@string/podcast_download_settings_title" />

                    <TextView
                        android:id="@+id/tvDownloadSettingsPodcastName"
                        style="@style/simpleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:text="Podcast name" />
                </LinearLayout>
            </LinearLayout>

            <com.driot.bookplayer.views.SettingSwitchRow
                android:id="@+id/rowAutoDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_corner_surface_variant"
                app:title="@string/Auto_Download_episodes"
                app:subtitle="@string/option_podcast_autodownload_subtitle" />

            <View style="@style/GetResourceHorizontalBar" />

            <TextView
                android:id="@+id/tvTotalStorageLabel"
                style="@style/simpleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text="@string/podcast_total_storage_used" />

            <TextView
                android:id="@+id/tvTotalStorageValue"
                style="@style/simpleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="2dp"
                android:text="…" />

            <View style="@style/GetResourceHorizontalBar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/rounded_corner_surface_variant">

                <TextView
                    android:id="@+id/tvDownloadLastN"
                    style="@style/simpleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"
                    android:text="Download last 10 episodes" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/seekbarDownloadLastN"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="10"
                        android:progress="10" />

                    <EditText
                        android:id="@+id/etDownloadLastN"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:inputType="number"
                        android:maxLength="5"
                        android:gravity="center"
                        android:text="10" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnDownloadLastN"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="end"
                    android:text="@string/download" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
