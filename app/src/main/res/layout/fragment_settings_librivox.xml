<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/scrollView">

    <LinearLayout
        android:id="@+id/ll_Podcast"
        style="@style/LinearLayoutOptionsVertical"
        android:layout_marginTop="0dp"
        android:padding="8dp">

        <!-- Optional local title (hidden when embedded inline) -->
        <LinearLayout android:id="@+id/ll_title" style="@style/wideLinearLayout_Vertical">
            <View style="@style/myStyleViewSimpleHorizontalBar" />
            <TextView android:text="@string/librivox_settings" style="@style/OptionMasterTitle"/>
            <View style="@style/myStyleViewSimpleHorizontalBar" />
        </LinearLayout>

        <TextView
            style="@style/OptionTitle"
            android:text="@string/Technical"/>

        <LinearLayout
            android:id="@+id/ll_Search"
            style="@style/LinearLayoutOptionsVertical">

            <LinearLayout
                style="@style/LinearLayoutOptionsCheckBoxHorizontal"
                android:layout_width="match_parent"
                android:layout_marginTop="0dp">
                <TextView
                    style="@style/OptionPodcastTextBeforeEditText"
                    android:textSize="16sp"
                    android:text="@string/api_paging_size"
                    android:layout_marginStart="10dp"/>
                <EditText
                    style="@style/OptionPodcastEditText"
                    android:layout_width="70dp"
                    android:textSize="16sp"
                    android:id="@+id/et_librivox_api_nb_results"/>
            </LinearLayout>
            <TextView
                android:text="Min = 20"
                style="@style/OptionMiniText"
                android:layout_marginStart="10dp"/>
            <TextView
                android:text="Max = 1000"
                style="@style/OptionMiniText"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <View style="@style/myStyleViewSimpleHorizontalBar" />

    </LinearLayout>
</ScrollView>