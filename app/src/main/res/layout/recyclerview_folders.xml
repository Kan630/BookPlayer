<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    android:layout_marginBottom="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="2dp">

        <!-- LEFT: book cover -->
        <ImageView
            android:id="@+id/ivBookCover"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:paddingHorizontal="2dp"
            android:scaleType="centerCrop"
            app:layout_constraintWidth_min="64dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- RIGHT: all content -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/stuff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurfaceVariant"
            app:layout_constraintStart_toEndOf="@id/ivBookCover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.67" />

            <ImageView
                android:id="@+id/ivSource"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/recyclerview_elements_sides"
                android:layout_marginBottom="4dp"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvBookName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/audio_book_name"
                android:paddingVertical="0dp"
                android:paddingHorizontal="2dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:background="?attr/colorSurfaceVariant"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:fontFamily="casual"
                app:layout_constraintStart_toEndOf="@id/ivSource"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/recyclerview_elements_bottom"
                android:layout_marginLeft="@dimen/recyclerview_elements_sides"
                android:layout_marginRight="@dimen/recyclerview_elements_sides"
                android:progress="20"
                android:progressDrawable="@drawable/progress_bar_theme"
                app:layout_constraintTop_toBottomOf="@id/tvBookName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/textViewFileLastAccess" />

            <TextView
                android:id="@+id/textViewDuration"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/recyclerview_elements_bottom"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="@dimen/recyclerview_elements_sides"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/tvBookName"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewFilePercent"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/recyclerview_elements_bottom"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="...xx%..."
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/tvBookName"
                app:layout_constraintEnd_toEndOf="@id/progressBar" />

            <TextView
                android:id="@+id/textViewFileLastAccess"
                style="@style/lastAccess"
                android:layout_width="80dp"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/recyclerview_elements_bottom"
                android:layout_marginLeft="@dimen/recyclerview_elements_sides"
                android:layout_marginRight="@dimen/recyclerview_elements_sides"
                android:paddingTop="@dimen/recyclerview_padding_text_vertical"
                android:paddingBottom="@dimen/recyclerview_padding_text_vertical"
                android:paddingStart="@dimen/recyclerview_padding_text_horizontal"
                android:paddingEnd="@dimen/recyclerview_padding_text_horizontal"
                android:gravity="center_vertical"
                android:background="@color/cardBackgroundTextView"
                android:textColor="@color/cardBackgroundLightTextInTextView"
                app:layout_constraintTop_toBottomOf="@id/tvBookName"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
