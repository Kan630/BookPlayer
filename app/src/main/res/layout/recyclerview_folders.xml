<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/recyclerview_between_cardView"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="3dp"
        app:cardBackgroundColor="@color/cardBackground"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivBookCover"
                android:layout_width="64dp"
                android:layout_height="52dp"
                android:scaleType="centerCrop"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="2dp"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/recyclerview_between_cardView"
                android:layout_marginTop="@dimen/recyclerview_between_cardView"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_toEndOf="@id/ivBookCover"
                android:layout_alignTop="@id/ivBookCover"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@color/lightgray"
                >

                <TextView
                    android:id="@+id/tvBookName"
                    android:text="AudioBook..."
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/audioName"
                    android:textColor="@color/black"
                    android:background="@color/verylightgray"
                    android:paddingTop="@dimen/recyclerview_padding_text_vertical"
                    android:paddingBottom="@dimen/recyclerview_padding_text_vertical"
                    android:paddingStart="@dimen/recyclerview_padding_text_horizontal"
                    android:paddingEnd= "@dimen/recyclerview_padding_text_horizontal"
                    android:layout_marginTop="@dimen/recyclerview_elements_top"
                    android:layout_marginLeft="@dimen/recyclerview_elements_sides"
                    android:layout_marginRight="@dimen/recyclerview_elements_sides"
                    app:layout_constraintBottom_toTopOf="@id/textViewFilePercent"
                    />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.7" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:progress="20"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="@dimen/recyclerview_elements_bottom"
                    android:layout_marginLeft="@dimen/recyclerview_elements_sides"
                    android:layout_marginRight="@dimen/recyclerview_elements_sides"
                    android:progressDrawable="@drawable/progress_bar_theme"
                    app:layout_constraintTop_toBottomOf="@id/tvBookName"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/guideline"/>

                <TextView
                    android:id="@+id/textViewFilePercent"
                    android:text="...xx%..."
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="@dimen/recyclerview_elements_bottom"
                    android:layout_marginLeft="20dp"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toBottomOf="@id/tvBookName"
                    app:layout_constraintRight_toRightOf="@id/guideline"
                    android:layout_marginRight="20dp"
                    />

                <TextView
                    android:id="@+id/textViewDuration"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="@dimen/recyclerview_elements_bottom"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="@dimen/recyclerview_elements_sides"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toBottomOf="@id/tvBookName"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:text="" />

                <TextView
                    android:id="@+id/textViewFileLastAccess"
                    android:text="..."
                    style="@style/lastAccess"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="@dimen/recyclerview_elements_bottom"
                    android:layout_marginLeft="@dimen/recyclerview_elements_sides"
                    android:layout_marginRight="@dimen/recyclerview_elements_sides"
                    android:paddingTop="@dimen/recyclerview_padding_text_vertical"
                    android:paddingBottom="@dimen/recyclerview_padding_text_vertical"
                    android:paddingStart="@dimen/recyclerview_padding_text_horizontal"
                    android:paddingEnd="@dimen/recyclerview_padding_text_horizontal"
                    android:gravity="center_vertical"
                    android:textColor="@color/black"
                    android:background="@color/verylightgray"
                    app:layout_constraintTop_toBottomOf="@id/tvBookName"
                    app:layout_constraintLeft_toLeftOf="@+id/guideline"
                    app:layout_constraintStart_toEndOf="@id/guideline"
                    app:layout_constraintEnd_toStartOf="@id/guideline_icon"
                    />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.95" />

                <ImageView
                    android:id="@+id/imageViewStorageIcon"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="@dimen/recyclerview_elements_bottom"
                    android:layout_marginEnd="@dimen/recyclerview_elements_sides"
                    android:scaleType="fitCenter"
                    app:layout_constraintTop_toBottomOf="@id/tvBookName"
                    app:layout_constraintStart_toEndOf="@id/guideline_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    />


            </androidx.constraintlayout.widget.ConstraintLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
