<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/recyclerview_between_cardView"
    >
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="3dp"
        app:cardBackgroundColor="@color/cardBackground"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/recyclerview_between_cardView"
            android:layout_marginTop="@dimen/recyclerview_between_cardView"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:background="@color/lightgray"
            >

            <TextView
                android:id="@+id/tvTitle"
                style="@style/audioName"
                android:textSize="26sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="Dracula (version 2)"
                />

            <TextView
                android:id="@+id/tvDate"
                style="@style/OptionMiniText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="audio available since 2020"
                />

            <TextView
                android:id="@+id/tvRating"
                style="@style/OptionMiniText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Nb of review: 42  - avg rating : 3.85"
                />

            <androidx.appcompat.widget.AppCompatRatingBar
                android:id="@+id/ratingBar"
                style="@style/Widget.AppCompat.RatingBar.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="0.5"
                android:isIndicator="true"
                android:layout_marginTop="4dp"
                />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
